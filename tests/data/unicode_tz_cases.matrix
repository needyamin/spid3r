    let p_1674 = tz_parts("Antarctica/Troll", -1000000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1674["year"], p_1674["month"], p_1674["day"], p_1674["hour"], p_1674["minute"], p_1674["second"]).unwrap(), -1000000000);
    assert_eq(tz_format("Antarctica/Troll", -500000000, "%Y-%m-%d %H:%M:%S"), "1954-02-26 23:06:40");
    assert_eq(tz_offset("Antarctica/Troll", -500000000), 0);
    assert_eq(tz_abbr("Antarctica/Troll", -500000000), "-00");
    let p_1679 = tz_parts("Antarctica/Troll", -500000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1679["year"], p_1679["month"], p_1679["day"], p_1679["hour"], p_1679["minute"], p_1679["second"]).unwrap(), -500000000);
    assert_eq(tz_format("Antarctica/Troll", 0, "%Y-%m-%d %H:%M:%S"), "1970-01-01 00:00:00");
    assert_eq(tz_offset("Antarctica/Troll", 0), 0);
    assert_eq(tz_abbr("Antarctica/Troll", 0), "-00");
    let p_1684 = tz_parts("Antarctica/Troll", 0).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1684["year"], p_1684["month"], p_1684["day"], p_1684["hour"], p_1684["minute"], p_1684["second"]).unwrap(), 0);
    assert_eq(tz_format("Antarctica/Troll", 500000000, "%Y-%m-%d %H:%M:%S"), "1985-11-05 00:53:20");
    assert_eq(tz_offset("Antarctica/Troll", 500000000), 0);
    assert_eq(tz_abbr("Antarctica/Troll", 500000000), "-00");
    let p_1689 = tz_parts("Antarctica/Troll", 500000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1689["year"], p_1689["month"], p_1689["day"], p_1689["hour"], p_1689["minute"], p_1689["second"]).unwrap(), 500000000);
    assert_eq(tz_format("Antarctica/Troll", 946684800, "%Y-%m-%d %H:%M:%S"), "2000-01-01 00:00:00");
    assert_eq(tz_offset("Antarctica/Troll", 946684800), 0);
    assert_eq(tz_abbr("Antarctica/Troll", 946684800), "-00");
    let p_1694 = tz_parts("Antarctica/Troll", 946684800).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1694["year"], p_1694["month"], p_1694["day"], p_1694["hour"], p_1694["minute"], p_1694["second"]).unwrap(), 946684800);
    assert_eq(tz_format("Antarctica/Troll", 1262304000, "%Y-%m-%d %H:%M:%S"), "2010-01-01 00:00:00");
    assert_eq(tz_offset("Antarctica/Troll", 1262304000), 0);
    assert_eq(tz_abbr("Antarctica/Troll", 1262304000), "+00");
    let p_1699 = tz_parts("Antarctica/Troll", 1262304000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1699["year"], p_1699["month"], p_1699["day"], p_1699["hour"], p_1699["minute"], p_1699["second"]).unwrap(), 1262304000);
    assert_eq(tz_format("Antarctica/Troll", 1500000000, "%Y-%m-%d %H:%M:%S"), "2017-07-14 04:40:00");
    assert_eq(tz_offset("Antarctica/Troll", 1500000000), 7200);
    assert_eq(tz_abbr("Antarctica/Troll", 1500000000), "+02");
    let p_1704 = tz_parts("Antarctica/Troll", 1500000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1704["year"], p_1704["month"], p_1704["day"], p_1704["hour"], p_1704["minute"], p_1704["second"]).unwrap(), 1500000000);
    assert_eq(tz_format("Antarctica/Troll", 1761000000, "%Y-%m-%d %H:%M:%S"), "2025-10-21 00:40:00");
    assert_eq(tz_offset("Antarctica/Troll", 1761000000), 7200);
    assert_eq(tz_abbr("Antarctica/Troll", 1761000000), "+02");
    let p_1709 = tz_parts("Antarctica/Troll", 1761000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1709["year"], p_1709["month"], p_1709["day"], p_1709["hour"], p_1709["minute"], p_1709["second"]).unwrap(), 1761000000);
    assert_eq(tz_format("Antarctica/Troll", 1900000000, "%Y-%m-%d %H:%M:%S"), "2030-03-17 17:46:40");
    assert_eq(tz_offset("Antarctica/Troll", 1900000000), 0);
    assert_eq(tz_abbr("Antarctica/Troll", 1900000000), "+00");
    let p_1714 = tz_parts("Antarctica/Troll", 1900000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1714["year"], p_1714["month"], p_1714["day"], p_1714["hour"], p_1714["minute"], p_1714["second"]).unwrap(), 1900000000);
    assert_eq(tz_format("Antarctica/Troll", 2200000000, "%Y-%m-%d %H:%M:%S"), "2039-09-19 01:06:40");
    assert_eq(tz_offset("Antarctica/Troll", 2200000000), 7200);
    assert_eq(tz_abbr("Antarctica/Troll", 2200000000), "+02");
    let p_1719 = tz_parts("Antarctica/Troll", 2200000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1719["year"], p_1719["month"], p_1719["day"], p_1719["hour"], p_1719["minute"], p_1719["second"]).unwrap(), 2200000000);
    assert_eq(tz_format("Antarctica/Troll", 2500000000, "%Y-%m-%d %H:%M:%S"), "2049-03-22 04:26:40");
    assert_eq(tz_offset("Antarctica/Troll", 2500000000), 0);
    assert_eq(tz_abbr("Antarctica/Troll", 2500000000), "+00");
    let p_1724 = tz_parts("Antarctica/Troll", 2500000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1724["year"], p_1724["month"], p_1724["day"], p_1724["hour"], p_1724["minute"], p_1724["second"]).unwrap(), 2500000000);
    assert_eq(tz_format("Antarctica/Troll", 3500000000, "%Y-%m-%d %H:%M:%S"), "2080-11-28 06:13:20");
    assert_eq(tz_offset("Antarctica/Troll", 3500000000), 0);
    assert_eq(tz_abbr("Antarctica/Troll", 3500000000), "+00");
    let p_1729 = tz_parts("Antarctica/Troll", 3500000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1729["year"], p_1729["month"], p_1729["day"], p_1729["hour"], p_1729["minute"], p_1729["second"]).unwrap(), 3500000000);
    assert_eq(tz_format("Antarctica/Troll", 4100000000, "%Y-%m-%d %H:%M:%S"), "2099-12-03 16:53:20");
    assert_eq(tz_offset("Antarctica/Troll", 4100000000), 0);
    assert_eq(tz_abbr("Antarctica/Troll", 4100000000), "+00");
    let p_1734 = tz_parts("Antarctica/Troll", 4100000000).unwrap();
    assert_eq(tz_from_parts("Antarctica/Troll", p_1734["year"], p_1734["month"], p_1734["day"], p_1734["hour"], p_1734["minute"], p_1734["second"]).unwrap(), 4100000000);
    // ---- DST gap: a nonexistent wall time moves forward past the gap
    let gap = tz_from_parts("America/New_York", 2026, 3, 8, 2, 30, 0).unwrap();
    assert_eq(tz_format("America/New_York", gap, "%H:%M"), "03:30");
    // ---- DST overlap: the earlier instant wins
    let amb = tz_from_parts("America/New_York", 2026, 11, 1, 1, 30, 0).unwrap();
    assert_eq(tz_format("America/New_York", amb, "%H:%M %Z"), "01:30 EDT");
    return 0;
}
