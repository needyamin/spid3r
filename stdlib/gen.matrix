// stdlib/gen.matrix - generators over the scheduler, written in Spid3r.
//
//   import "gen" as g;
//
//   let it = g.range_gen(5);
//   while true {
//       let v = g.next(it);
//       if v == null { break; }
//       println(v);
//   }
//
//   // composable: squares of the even numbers below 10
//   let pipe = g.map(g.filter(g.range_gen(10), fn(x) { return x % 2 == 0; }),
//                    fn(x) { return x * x; });
//   println(g.collect(pipe));   // [0, 4, 16, 36, 64]
//
// Each generator runs its body in its own spawned task and parks on channels
// at every emission, so an INFINITE producer costs nothing until consumed.
// Cost model: one scheduler task per live generator (fine for thousands of
// concurrent generators; for hundreds of thousands, wait for the
// compiler-level `yield` - see docs/IMPROVEMENT_PLAN.md DESIGN).
//
// Protocol notes:
// - `next` returns null at the end of the stream.
// - `close` releases an abandoned generator early and is idempotent; `take`
//   and `collect` close the generator automatically, and `map`/`filter`
//   propagate `close` to their upstream generator. Leaving a partially
//   consumed generator unclosed keeps its producer task parked until exit,
//   which triggers the runtime's task-drain warning (`SPID3R_TASK_DRAIN_MS`).
// - An exception inside the body ends the generator (the task unwinds);
//   handle errors inside the body.

fn new_gen(out, ack, cancel) {
    let m = map("out", out);
    m["ack"] = ack;
    m["cancel"] = cancel;
    m["closed"] = false;
    return m;
}

/// Wrap a body `fn(emit)` as a generator. `emit(v)` yields one value.
public fn gen(body) {
    let out = channel();
    let ack = channel();
    let cancel = channel();
    spawn fn() {
        try {
            body(fn(v) {
                // try_recv answers `none` when the channel is empty and
                // `some(v)` otherwise - compare against none, not null.
                // A cancel THROWS (it must unwind the body, not skip one
                // emission: the body would keep looping otherwise).
                if cancel.try_recv() != none {
                    throw "gen:closed";
                }
                out.send(v);
                ack.recv();
            });
        } catch (e) {
            // The body failed: end the stream rather than leaving the
            // consumer parked forever. Errors are the body's business.
        }
        out.send(null);
    };
    return new_gen(out, ack, cancel);
}

/// The next value, or null at the end of the stream.
public fn next(it) {
    if type_of(it) != "map" or not it.has("closed") {
        throw "gen.next() expects a generator, found " + type_of(it);
    }
    if it["closed"] == true {
        return null;
    }
    let v = it["out"].recv();
    if v == null {
        it["closed"] = true;
        return null;
    }
    it["ack"].send(true);
    return v;
}

/// Every remaining value as a list. Also accepts a list directly (so
/// `collect(take(g, n))` composes cleanly).
public fn collect(it) {
    if type_of(it) == "list" {
        return it;
    }
    if type_of(it) != "map" or not it.has("closed") {
        throw "gen.collect() expects a generator or list, found " + type_of(it);
    }
    let out = [];
    while true {
        let v = next(it);
        if v == null {
            return out;
        }
        out.push(v);
    }
}

/// The first `n` values as a list (fewer if the stream ends).
public fn take(it, n) {
    let out = [];
    let i = 0;
    while i < n {
        let v = next(it);
        if v == null {
            return out;
        }
        out.push(v);
        i = i + 1;
    }
    close(it);
    return out;
}

/// A generator of `f(v)` for every value of `it`. (The private alias exists
/// because `map` names a builtin constructor inside this module.)
fn map_gen(it, f) {
    return gen(fn(emit) {
        try {
            while true {
                let v = next(it);
                if v == null {
                    return;
                }
                emit(f(v));
            }
        } finally {
            close(it);
        }
    });
}

/// A generator of the values of `it` for which `pred(v)` holds.
fn filter_gen(it, pred) {
    return gen(fn(emit) {
        try {
            while true {
                let v = next(it);
                if v == null {
                    return;
                }
                if pred(v) {
                    emit(v);
                }
            }
        } finally {
            close(it);
        }
    });
}

/// Public wrappers for the (builtin-clashing) names.
public fn map(it, f) {
    return map_gen(it, f);
}

public fn filter(it, pred) {
    return filter_gen(it, pred);
}

/// A generator of integers `a .. b-1` (two-argument form) or `0 .. n-1`.
public fn range_gen(a, b = null) {
    if b == null {
        b = a;
        a = 0;
    }
    return gen(fn(emit) {
        let i = a;
        while i < b {
            emit(i);
            i = i + 1;
        }
    });
}

/// Release an abandoned generator: wakes its body, which unwinds without
/// emitting again. Safe to call twice; a no-op after the stream ended.
public fn close(it) {
    if it["closed"] == true {
        return;
    }
    it["closed"] = true;
    it["cancel"].send(true);
    // Wake a body parked waiting for the ack, then drain any buffered item plus
    // the final null sentinel so the producer exits cleanly without leaving a
    // second close() blocking forever.
    it["ack"].send(true);
    while true {
        let v = it["out"].recv();
        if v == null {
            return;
        }
        it["ack"].send(true);
    }
}
