// stdlib/xml.matrix - an XML parser, written in Spid3r.
//
//   import "xml";
//
//   let doc = xml_parse("<catalog><book id=\"1\">Dune</book></catalog>");
//   println(doc["name"]);                    // catalog
//   let books = xml_find(doc, "book");
//   println(xml_attr(books[0], "id"));       // 1
//   println(xml_text(books[0]));             // Dune
//
// A node is `{name, attrs, children, text}`: `attrs` is a map of strings,
// `children` is a list of nodes, `text` is the concatenated direct character
// data with entities decoded and surrounding whitespace trimmed.
//
// Supported: the XML declaration and processing instructions (skipped),
// comments, CDATA sections, self-closing tags, single- and double-quoted
// attributes, and the entities `&lt; &gt; &amp; &quot; &apos;` plus numeric
// `&#NN;` / `&#xHH;`. Not supported: DTDs and internal entities (they are
// rejected, not silently ignored), namespaces as a resolution layer (a
// prefixed name like `ns:tag` is kept as the literal string), and schema
// validation. This is a parser, not a validating processor.

let SRC = "";
let POS = 0;

const DIGITS = "0123456789";
const HEXDIGITS = "0123456789abcdef";
const NAME_PUNCT = "-_:.";

fn fail(msg) {
    throw "xml_parse: " + msg + " at offset " + string(POS);
}

fn at_end() {
    return POS >= len(SRC);
}

fn peek() {
    if at_end() {
        return "";
    }
    return SRC.slice(POS, POS + 1);
}

fn looking_at(s) {
    let end = POS + len(s);
    if end > len(SRC) {
        return false;
    }
    return SRC.slice(POS, end) == s;
}

fn advance(n) {
    POS = POS + n;
}

fn expect(s) {
    if not looking_at(s) {
        fail("expected '" + s + "'");
    }
    advance(len(s));
}

fn skip_ws() {
    while not at_end() {
        let c = peek();
        if c == " " or c == "\n" or c == "\r" or c == "\t" {
            advance(1);
        } else {
            return;
        }
    }
}

fn is_name_char(c) {
    if c == "" {
        return false;
    }
    if NAME_PUNCT.index_of(c) >= 0 {
        return true;
    }
    if DIGITS.index_of(c) >= 0 {
        return true;
    }
    // A character is a letter when case folding changes it.
    return c.lower() != c.upper();
}

fn parse_name() {
    let start = POS;
    while is_name_char(peek()) {
        advance(1);
    }
    if POS == start {
        fail("expected a name");
    }
    return SRC.slice(start, POS);
}

fn digit_value(c, base) {
    let lower = c.lower();
    let d = HEXDIGITS.index_of(lower);
    if d < 0 or d >= base {
        return -1;
    }
    return d;
}

fn decode_entities(s) {
    if not s.contains("&") {
        return s;
    }
    let out = "";
    let i = 0;
    while i < len(s) {
        let c = s.slice(i, i + 1);
        if c != "&" {
            out = out + c;
            i = i + 1;
            continue;
        }
        // Find the closing ';' by scanning forward (string.index_of takes no
        // start offset, and entities are short).
        let semi = -1;
        let j = i + 1;
        while j < len(s) {
            if s.slice(j, j + 1) == ";" {
                semi = j;
                j = len(s);
            } else {
                j = j + 1;
            }
        }
        if semi < 0 {
            out = out + c;
            i = i + 1;
            continue;
        }
        let body = s.slice(i + 1, semi);
        if body == "lt" {
            out = out + "<";
        } elif body == "gt" {
            out = out + ">";
        } elif body == "amp" {
            out = out + "&";
        } elif body == "quot" {
            out = out + "\"";
        } elif body == "apos" {
            out = out + "'";
        } elif body.starts_with("#x") or body.starts_with("#X") {
            out = out + chr(parse_radix(body.slice(2, len(body)), 16));
        } elif body.starts_with("#") {
            out = out + chr(parse_radix(body.slice(1, len(body)), 10));
        } else {
            out = out + "&" + body + ";";
        }
        i = semi + 1;
    }
    return out;
}

fn parse_radix(digits, base) {
    if digits == "" {
        fail("empty numeric character reference");
    }
    let value = 0;
    let i = 0;
    while i < len(digits) {
        let c = digits.slice(i, i + 1);
        let d = digit_value(c, base);
        if d < 0 {
            fail("bad digit '" + c + "' in character reference");
        }
        value = value * base + d;
        i = i + 1;
    }
    if value <= 0 or value > 1114111 {
        fail("character reference out of range: " + string(value));
    }
    return value;
}

fn skip_comment() {
    advance(4);
    while not at_end() {
        if looking_at("-->") {
            advance(3);
            return;
        }
        advance(1);
    }
    fail("unterminated comment");
}

fn skip_processing_instruction() {
    advance(2);
    while not at_end() {
        if looking_at("?>") {
            advance(2);
            return;
        }
        advance(1);
    }
    fail("unterminated processing instruction");
}

fn skip_doctype() {
    // Reject rather than mis-parse: an internal DTD would define entities we
    // do not expand, so silently skipping it would change the document.
    fail("DTDs are not supported (this parser does not expand entities)");
}

fn parse_element() {
    if peek() != "<" {
        fail("expected '<'");
    }
    advance(1);
    let name = parse_name();
    let attrs = map();
    while true {
        skip_ws();
        if at_end() {
            fail("unterminated start tag <" + name + ">");
        }
        if looking_at("/>") {
            advance(2);
            return map("name", name, "attrs", attrs, "children", list(), "text", "");
        }
        if peek() == ">" {
            advance(1);
            break;
        }
        let attr_name = parse_name();
        skip_ws();
        expect("=");
        skip_ws();
        let quote = peek();
        if quote != "\"" and quote != "'" {
            fail("attribute '" + attr_name + "' needs a quoted value");
        }
        advance(1);
        let start = POS;
        while not at_end() and peek() != quote {
            advance(1);
        }
        if at_end() {
            fail("unterminated attribute value for '" + attr_name + "'");
        }
        let raw = SRC.slice(start, POS);
        advance(1);
        attrs[attr_name] = decode_entities(raw);
    }

    let children = list();
    let text = "";
    while true {
        if at_end() {
            fail("unexpected end of input inside <" + name + ">");
        }
        if looking_at("</") {
            advance(2);
            let closing = parse_name();
            skip_ws();
            expect(">");
            if closing != name {
                fail("mismatched close tag: <" + name + "> closed by </" + closing + ">");
            }
            return map(
                "name",
                name,
                "attrs",
                attrs,
                "children",
                children,
                "text",
                text.trim()
            );
        }
        if looking_at("<!--") {
            skip_comment();
            continue;
        }
        if looking_at("<![CDATA[") {
            advance(9);
            let start = POS;
            while not at_end() and not looking_at("]]>") {
                advance(1);
            }
            if at_end() {
                fail("unterminated CDATA section");
            }
            text = text + SRC.slice(start, POS);
            advance(3);
            continue;
        }
        if looking_at("<?") {
            skip_processing_instruction();
            continue;
        }
        if looking_at("<!") {
            skip_doctype();
        }
        if peek() == "<" {
            children.push(parse_element());
            continue;
        }
        let start = POS;
        while not at_end() and peek() != "<" {
            advance(1);
        }
        text = text + decode_entities(SRC.slice(start, POS));
    }
    return null;
}

/// Parse a document and return its root node.
public fn xml_parse(text) {
    SRC = text;
    POS = 0;
    while true {
        skip_ws();
        if at_end() {
            throw "xml_parse: document has no root element";
        }
        if looking_at("<?") {
            skip_processing_instruction();
            continue;
        }
        if looking_at("<!--") {
            skip_comment();
            continue;
        }
        if looking_at("<!") {
            skip_doctype();
        }
        break;
    }
    let root = parse_element();
    skip_ws();
    if not at_end() {
        if looking_at("<!--") {
            skip_comment();
            skip_ws();
        }
    }
    if not at_end() {
        fail("trailing content after the root element");
    }
    return root;
}

/// Attribute value, or `null` when the attribute is absent.
public fn xml_attr(node, name) {
    let attrs = node["attrs"];
    if not attrs.has(name) {
        return null;
    }
    return attrs[name];
}

/// The node's direct character data (entities decoded, whitespace trimmed).
public fn xml_text(node) {
    return node["text"];
}

fn collect_by_name(node, name, out) {
    for child in node["children"] {
        if child["name"] == name {
            out.push(child);
        }
        collect_by_name(child, name, out);
    }
}

/// Every descendant element with this tag name, in document order.
public fn xml_find(node, name) {
    let out = list();
    collect_by_name(node, name, out);
    return out;
}

/// Serialize a node back to XML (used for round-trip checks).
public fn xml_write(node) {
    let out = "<" + node["name"];
    for k in node["attrs"].keys() {
        out = out + " " + string(k) + "=\"" + xml_escape(node["attrs"][k]) + "\"";
    }
    let kids = node["children"];
    let body = node["text"];
    if len(kids) == 0 and body == "" {
        return out + "/>";
    }
    out = out + ">";
    if body != "" {
        out = out + xml_escape(body);
    }
    for c in kids {
        out = out + xml_write(c);
    }
    return out + "</" + node["name"] + ">";
}

fn xml_escape(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let c = s.slice(i, i + 1);
        if c == "<" {
            out = out + "&lt;";
        } elif c == ">" {
            out = out + "&gt;";
        } elif c == "&" {
            out = out + "&amp;";
        } elif c == "\"" {
            out = out + "&quot;";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}
