// stdlib/yaml.matrix - a YAML subset parser and writer, written in Spid3r.
//
//   import "yaml";
//
//   let cfg = yaml_parse("server:\n  host: a.io\n  ports:\n    - 80\n    - 443\n");
//   println(cfg["server"]["host"]);     // a.io
//   println(cfg["server"]["ports"][1]); // 443
//
// Supported: block mappings and sequences by indentation, nested blocks,
// `- key: value` items, flow sequences `[1, 2]` and flow mappings `{a: 1}`,
// single/double quoted scalars, literal (`|`) and folded (`>`) block scalars,
// comments, and the usual scalar resolution (null/~/true/false/ints/floats).
// Anchors, aliases, tags, merge keys and multi-document streams are NOT
// supported and are rejected rather than silently mis-read.
//
// Reentrancy: the line cursor lives in a `YamlParser` instance created per
// call, never in module-level state, so concurrent `yaml_parse` calls on
// different threads cannot observe each other's position. Do not reintroduce
// module-level `let` variables here.

const DIGITS = "0123456789";

fn indent_of(s) {
    let i = 0;
    while i < len(s) and s.slice(i, i + 1) == " " {
        i = i + 1;
    }
    return i;
}

/// Remove a trailing `#` comment, but only outside quotes and only when the
/// `#` starts a word (so `a#b` stays intact).
fn strip_comment(s) {
    let in_single = false;
    let in_double = false;
    let i = 0;
    while i < len(s) {
        let c = s.slice(i, i + 1);
        if c == "'" and not in_double {
            in_single = not in_single;
        } elif c == "\"" and not in_single {
            in_double = not in_double;
        } elif c == "#" and not in_single and not in_double {
            if i == 0 or s.slice(i - 1, i) == " " {
                return s.slice(0, i);
            }
        }
        i = i + 1;
    }
    return s;
}

fn is_int_text(s) {
    if s == "" {
        return false;
    }
    let i = 0;
    if s.slice(0, 1) == "-" or s.slice(0, 1) == "+" {
        i = 1;
    }
    if i >= len(s) {
        return false;
    }
    while i < len(s) {
        if DIGITS.index_of(s.slice(i, i + 1)) < 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn is_float_text(s) {
    if s == "" {
        return false;
    }
    let i = 0;
    if s.slice(0, 1) == "-" or s.slice(0, 1) == "+" {
        i = 1;
    }
    let seen_dot = false;
    let seen_digit = false;
    while i < len(s) {
        let c = s.slice(i, i + 1);
        if c == "." {
            if seen_dot {
                return false;
            }
            seen_dot = true;
        } elif DIGITS.index_of(c) >= 0 {
            seen_digit = true;
        } else {
            return false;
        }
        i = i + 1;
    }
    return seen_dot and seen_digit;
}

fn unescape_double(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let c = s.slice(i, i + 1);
        if c == "\\" and i + 1 < len(s) {
            let n = s.slice(i + 1, i + 2);
            if n == "n" {
                out = out + "\n";
            } elif n == "t" {
                out = out + "\t";
            } elif n == "r" {
                out = out + "\r";
            } elif n == "\"" {
                out = out + "\"";
            } elif n == "\\" {
                out = out + "\\";
            } else {
                out = out + n;
            }
            i = i + 2;
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}

/// Split on commas that are not inside quotes or nested flow collections.
fn split_flow(s) {
    let parts = list();
    let depth = 0;
    let in_single = false;
    let in_double = false;
    let cur = "";
    let i = 0;
    while i < len(s) {
        let c = s.slice(i, i + 1);
        if c == "'" and not in_double {
            in_single = not in_single;
        } elif c == "\"" and not in_single {
            in_double = not in_double;
        } elif not in_single and not in_double {
            if c == "[" or c == "{" {
                depth = depth + 1;
            } elif c == "]" or c == "}" {
                depth = depth - 1;
            } elif c == "," and depth == 0 {
                parts.push(cur);
                cur = "";
                i = i + 1;
                continue;
            }
        }
        cur = cur + c;
        i = i + 1;
    }
    if cur.trim() != "" {
        parts.push(cur);
    }
    return parts;
}

fn find_key_colon(s) {
    let in_single = false;
    let in_double = false;
    let i = 0;
    while i < len(s) {
        let c = s.slice(i, i + 1);
        if c == "'" and not in_double {
            in_single = not in_single;
        } elif c == "\"" and not in_single {
            in_double = not in_double;
        } elif c == ":" and not in_single and not in_double {
            if i + 1 >= len(s) or s.slice(i + 1, i + 2) == " " {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

/// Index of the bracket that closes the collection opened at `s[0]`,
/// honoring quotes and nested `[]`/`{}`; -1 when it is unterminated.
/// Used to reject malformed flow collections (`[1, 2`, `[1, 2]]`) instead
/// of silently returning them as plain strings.
fn flow_close_index(s) {
    let want = "}";
    if s.starts_with("[") {
        want = "]";
    }
    let depth = 0;
    let in_single = false;
    let in_double = false;
    let i = 0;
    while i < len(s) {
        let c = s.slice(i, i + 1);
        if c == "'" and not in_double {
            in_single = not in_single;
        } elif c == "\"" and not in_single {
            in_double = not in_double;
        } elif not in_single and not in_double {
            if c == "[" or c == "{" {
                depth = depth + 1;
            } elif c == "]" or c == "}" {
                depth = depth - 1;
                if depth == 0 {
                    if c != want {
                        return -2;
                    }
                    return i;
                }
            }
        }
        i = i + 1;
    }
    return -1;
}

/// One parse in progress. All cursor state is per-instance.
class YamlParser {
    private let lines;
    private let pos;

    fn new (text) {
        self.lines = text.replace("\r\n", "\n").split("\n");
        self.pos = 0;
    }

    fn fail(self, msg) {
        throw "yaml_parse: " + msg + " (line " + string(self.pos + 1) + ")";
    }

    fn at_end(self) {
        return self.pos >= len(self.lines);
    }

    fn parse_scalar(self, t) {
        let s = t.trim();
        if s == "" or s == "~" or s == "null" or s == "Null" or s == "NULL" {
            return null;
        }
        if s == "true" or s == "True" or s == "TRUE" {
            return true;
        }
        if s == "false" or s == "False" or s == "FALSE" {
            return false;
        }
        if s.starts_with("&") or s.starts_with("*") or s.starts_with("!") {
            self.fail("anchors, aliases and tags are not supported: " + s);
        }
        if len(s) >= 2 and s.starts_with("\"") and s.ends_with("\"") {
            return unescape_double(s.slice(1, len(s) - 1));
        }
        if len(s) >= 2 and s.starts_with("'") and s.ends_with("'") {
            return s.slice(1, len(s) - 1).replace("''", "'");
        }
        if s.starts_with("[") or s.starts_with("{") {
            // A flow collection must close exactly at the end of the scalar.
            // Anything else is malformed YAML (a plain scalar cannot start
            // with `[`/`{`), so fail loudly — SECURITY.md promises that
            // malformed input is a catchable error, not a silent misparse.
            let close_at = flow_close_index(s);
            if close_at == -1 {
                self.fail("unterminated flow collection: " + s);
            }
            if close_at == -2 {
                self.fail("mismatched flow collection brackets: " + s);
            }
            if close_at != len(s) - 1 {
                self.fail("trailing text after flow collection: " + s);
            }
        }
        if s.starts_with("[") and s.ends_with("]") {
            let out = list();
            for part in split_flow(s.slice(1, len(s) - 1)) {
                out.push(self.parse_scalar(part));
            }
            return out;
        }
        if s.starts_with("{") and s.ends_with("}") {
            let out = map();
            for part in split_flow(s.slice(1, len(s) - 1)) {
                if part.trim() == "" {
                    continue;
                }
                let c = find_key_colon(part);
                if c < 0 {
                    self.fail("bad flow mapping entry: " + part);
                }
                let k = self.parse_scalar(part.slice(0, c));
                out[string(k)] = self.parse_scalar(part.slice(c + 1, len(part)));
            }
            return out;
        }
        if is_int_text(s) {
            return int(s);
        }
        if is_float_text(s) {
            return float(s);
        }
        return s;
    }

    fn skip_blank(self) {
        while self.pos < len(self.lines) and strip_comment(self.lines[self.pos]).trim() == "" {
            self.pos = self.pos + 1;
        }
    }

    fn parse_block_scalar(self, parent_indent, folded) {
        let chunks = list();
        while self.pos < len(self.lines) {
            let raw = self.lines[self.pos];
            if raw.trim() == "" {
                chunks.push("");
                self.pos = self.pos + 1;
                continue;
            }
            if indent_of(raw) <= parent_indent {
                break;
            }
            chunks.push(raw.slice(parent_indent + 2, len(raw)));
            self.pos = self.pos + 1;
        }
        // Drop trailing blank lines the block does not own.
        while len(chunks) > 0 and chunks[len(chunks) - 1] == "" {
            chunks.pop();
        }
        if folded {
            return chunks.join(" ");
        }
        return chunks.join("\n");
    }

    fn parse_block(self, min_indent) {
        self.skip_blank();
        if self.at_end() {
            return null;
        }
        let ind = indent_of(self.lines[self.pos]);
        if ind < min_indent {
            return null;
        }
        let t = strip_comment(self.lines[self.pos]).trim();
        if t == "-" or t.starts_with("- ") {
            return self.parse_list(ind);
        }
        return self.parse_map(ind);
    }

    fn parse_list(self, ind) {
        let out = list();
        while true {
            self.skip_blank();
            if self.at_end() {
                break;
            }
            let raw = self.lines[self.pos];
            let line = strip_comment(raw);
            if line.trim() == "" {
                self.pos = self.pos + 1;
                continue;
            }
            if indent_of(raw) != ind {
                break;
            }
            let t = line.trim();
            // Kept as a named local for readability. It was originally a
            // workaround for a VM miscompile of `not (A or B)`; that is fixed
            // (regression: tests/engine_matrix.rs, case `not_over_or`), so
            // `if not (t == "-" or t.starts_with("- "))` is now equivalent.
            let is_item = t == "-" or t.starts_with("- ");
            if not is_item {
                break;
            }
            let rest = t.slice(1, len(t)).trim();
            if rest == "" {
                self.pos = self.pos + 1;
                out.push(self.parse_block(ind + 1));
                continue;
            }
            let colon = find_key_colon(rest);
            if colon >= 0 {
                // `- key: value` starts a mapping that continues on deeper lines.
                let m = map();
                self.parse_map_entry(m, rest, ind + 2);
                while true {
                    self.skip_blank();
                    if self.at_end() {
                        break;
                    }
                    let r2 = self.lines[self.pos];
                    let l2 = strip_comment(r2);
                    if l2.trim() == "" {
                        self.pos = self.pos + 1;
                        continue;
                    }
                    if indent_of(r2) <= ind {
                        break;
                    }
                    self.parse_map_entry(m, l2.trim(), indent_of(r2));
                }
                out.push(m);
            } else {
                self.pos = self.pos + 1;
                out.push(self.parse_scalar(rest));
            }
        }
        return out;
    }

    fn parse_map(self, ind) {
        let m = map();
        while true {
            self.skip_blank();
            if self.at_end() {
                break;
            }
            let raw = self.lines[self.pos];
            let line = strip_comment(raw);
            if line.trim() == "" {
                self.pos = self.pos + 1;
                continue;
            }
            if indent_of(raw) < ind {
                break;
            }
            if indent_of(raw) > ind {
                break;
            }
            self.parse_map_entry(m, line.trim(), ind);
        }
        return m;
    }

    fn parse_map_entry(self, m, text, ind) {
        let colon = find_key_colon(text);
        if colon < 0 {
            self.fail("expected 'key: value', got '" + text + "'");
        }
        let key = self.parse_scalar(text.slice(0, colon));
        let rest = text.slice(colon + 1, len(text)).trim();
        self.pos = self.pos + 1;
        if rest == "|" or rest == "|-" or rest == ">" or rest == ">-" {
            m[string(key)] = self.parse_block_scalar(ind, rest.starts_with(">"));
        } elif rest == "" {
            m[string(key)] = self.parse_block(ind + 1);
        } else {
            m[string(key)] = self.parse_scalar(rest);
        }
    }

    public fn parse_document(self) {
        // Skip a leading document marker.
        self.skip_blank();
        if not self.at_end() and self.lines[self.pos].trim() == "---" {
            self.pos = self.pos + 1;
        }
        if not self.at_end() and self.lines[self.pos].trim() == "..." {
            return null;
        }
        let value = self.parse_block(0);
        self.skip_blank();
        if not self.at_end() {
            self.fail("unexpected content: '" + self.lines[self.pos].trim() + "'");
        }
        return value;
    }
}

/// Parse a YAML document into maps/lists/scalars.
public fn yaml_parse(text) {
    let parser = new YamlParser(text);
    return parser.parse_document();
}

// ---------------------------------------------------------------- writer

fn yaml_needs_quotes(s) {
    if s == "" {
        return true;
    }
    if s == "true" or s == "false" or s == "null" or s == "~" {
        return true;
    }
    if is_int_text(s) or is_float_text(s) {
        return true;
    }
    let bad = "-?:,[]{}#&*!|>'\"%@`";
    if bad.index_of(s.slice(0, 1)) >= 0 {
        return true;
    }
    if s.contains(": ") or s.contains(" #") or s.contains("\n") {
        return true;
    }
    return false;
}

fn yaml_scalar(v) {
    let t = type_of(v);
    if v == null {
        return "null";
    }
    if t == "bool" {
        if v {
            return "true";
        }
        return "false";
    }
    if t == "int" or t == "float" {
        return string(v);
    }
    if t == "string" {
        if yaml_needs_quotes(v) {
            return "\"" + v.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\"";
        }
        return v;
    }
    throw "yaml_write: cannot serialize a " + t + " value";
}

fn yaml_write_value(v, indent, out) {
    let pad = " ".repeat(indent);
    if type_of(v) == "map" {
        if len(v.keys()) == 0 {
            out.push(pad + "{}");
            return;
        }
        for k in v.keys() {
            let item = v[k];
            let t = type_of(item);
            if t == "map" and len(item.keys()) > 0 {
                out.push(pad + yaml_scalar(string(k)) + ":");
                yaml_write_value(item, indent + 2, out);
            } elif t == "list" and len(item) > 0 {
                out.push(pad + yaml_scalar(string(k)) + ":");
                yaml_write_value(item, indent + 2, out);
            } else {
                out.push(pad + yaml_scalar(string(k)) + ": " + yaml_scalar(item));
            }
        }
        return;
    }
    if type_of(v) == "list" {
        if len(v) == 0 {
            out.push(pad + "[]");
            return;
        }
        for item in v {
            let t = type_of(item);
            if t == "map" and len(item.keys()) > 0 {
                let first = true;
                for k in item.keys() {
                    let sub = item[k];
                    let st = type_of(sub);
                    if first {
                        if st == "map" or (st == "list" and len(sub) > 0) {
                            out.push(pad + "- " + yaml_scalar(string(k)) + ":");
                            yaml_write_value(sub, indent + 4, out);
                        } else {
                            out.push(
                                pad + "- " + yaml_scalar(string(k)) + ": " + yaml_scalar(sub)
                            );
                        }
                        first = false;
                    } else {
                        if st == "map" or (st == "list" and len(sub) > 0) {
                            out.push(pad + "  " + yaml_scalar(string(k)) + ":");
                            yaml_write_value(sub, indent + 4, out);
                        } else {
                            out.push(
                                pad + "  " + yaml_scalar(string(k)) + ": " + yaml_scalar(sub)
                            );
                        }
                    }
                }
            } elif t == "list" and len(item) > 0 {
                out.push(pad + "-");
                yaml_write_value(item, indent + 2, out);
            } else {
                out.push(pad + "- " + yaml_scalar(item));
            }
        }
        return;
    }
    out.push(pad + yaml_scalar(v));
}

/// Serialize a value to YAML (the subset this module parses).
public fn yaml_write(v) {
    let out = list();
    yaml_write_value(v, 0, out);
    return out.join("\n") + "\n";
}
