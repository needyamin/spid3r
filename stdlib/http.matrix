// stdlib/http.matrix - a small HTTP/1.1 web framework, written in Spid3r.
//
//   import "http";
//
//   fn main() {
//       let app = new HttpServer();
//       app.get("/", fn(req) { return http_html(200, "<h1>Hello</h1>"); });
//       app.get("/users/:id", fn(req) {
//           return http_json(200, map("id", req["params"]["id"]));
//       });
//       app.listen("127.0.0.1:8080");
//       return 0;
//   }
//
// Socket I/O and HTTP framing are runtime natives (src/stdlib/net.rs); this
// module adds routing, path parameters, middleware, and response helpers.
// Every connection is handled in its own `spawn`ed task on the scheduler's
// OS-thread pool, so a slow client never blocks the others.
//
// A handler receives the request map and returns one of:
//   - a response built by http_response / http_text / http_html / http_json /
//     http_redirect
//   - a string             -> 200 text/html
//   - any other value      -> 200 application/json (json_write of the value)
//   - null                 -> 204 No Content
//
// Request map keys: method, path, query (map), raw_query, version,
// headers (map, lower-case names), body, remote, params (map of :name
// captures).

// ------------------------------------------------------------ responses

/// A response with an explicit status, header map, and body.
public fn http_response(status, headers, body) {
    return map("__http_response", true, "status", status, "headers", headers, "body", body);
}

public fn http_text(status, body) {
    return http_response(status, map("content-type", "text/plain; charset=utf-8"), body);
}

public fn http_html(status, body) {
    return http_response(status, map("content-type", "text/html; charset=utf-8"), body);
}

/// Serialize `value` with json_write.
public fn http_json(status, value) {
    return http_response(
        status,
        map("content-type", "application/json; charset=utf-8"),
        json_write(value)
    );
}

public fn http_redirect(location) {
    return http_response(302, map("location", location), "");
}

/// A chunked-streaming response. `source` may be:
///   - a `list` of string/bytes chunks
///   - a zero-arg callback `fn() -> chunk_or_null` (called until null/empty)
///   - an open readable socket handle (`int`, read via `tcp_read` until EOF)
///   - a `bytes` or `string` buffer
public fn http_stream(status, headers, source) {
    let h = headers;
    if h == null {
        h = map();
    }
    return map(
        "__http_response",
        true,
        "status",
        status,
        "headers",
        h,
        "body",
        null,
        "stream",
        source
    );
}

/// Make an HTTP client request: ok(response) or err(msg).
public fn http_fetch(method, url, headers = null, body = null, opts = null) {
    if opts != null {
        return __http_fetch(method, url, headers, body, opts);
    } elif headers == null and body == null {
        return __http_fetch(method, url);
    } elif body == null {
        return __http_fetch(method, url, headers);
    } else {
        return __http_fetch(method, url, headers, body);
    }
}

/// Parse a request's JSON body: ok(value) / err(message).
public fn http_body_json(req) {
    try {
        return ok(json_parse(req["body"]));
    } catch (e) {
        return err("invalid JSON body: " + string(e));
    }
}

/// Turn whatever a handler returned into a response map.
fn to_response(value) {
    if value == null {
        return http_response(204, map(), "");
    }
    let t = type_of(value);
    if t == "string" {
        return http_html(200, value);
    }
    if t == "map" {
        if value.has("__http_response") {
            return value;
        }
    }
    return http_json(200, value);
}

// ------------------------------------------------------------ routing

fn split_path(path) {
    let out = list();
    for part in path.split("/") {
        if part != "" {
            out.push(part);
        }
    }
    return out;
}

fn match_parts(pattern_parts, parts) {
    let params = map();
    let n = len(pattern_parts);
    let i = 0;
    while i < n {
        let p = pattern_parts[i];
        if p == "*" {
            let rest = list();
            let j = i;
            while j < len(parts) {
                rest.push(parts[j]);
                j += 1;
            }
            params["*"] = rest.join("/");
            return some(params);
        }
        if i >= len(parts) {
            return none;
        }
        if p.starts_with(":") {
            params[p.slice(1)] = parts[i];
        } elif p != parts[i] {
            return none;
        }
        i += 1;
    }
    if len(parts) != n {
        return none;
    }
    return some(params);
}

/// Match a route pattern against a path. Returns some(params) or none.
/// `:name` captures one segment; a trailing `*` captures the rest as
/// params["*"].
fn match_path(pattern_parts, path) {
    return match_parts(pattern_parts, split_path(path));
}

// ------------------------------------------------------------ server

public class HttpServer {
    private let routes;
    private let static_routes;
    private let static_paths;
    private let has_dynamic;
    private let middleware;
    private let listener;
    public let logging;
    /// Serve tuning: keep_alive, idle_timeout_ms, timeout_ms,
    /// max_requests_per_conn, max_body_bytes, max_headers, drain_ms,
    /// access_log, on_error, workers.
    public let opts;

    fn new () {
        self.routes = list();
        self.static_routes = map();
        self.static_paths = map();
        self.has_dynamic = false;
        self.middleware = list();
        self.listener = -1;
        self.logging = true;
        self.opts = map();
    }

    /// Register `handler` for `method` ("GET", "POST", ..., or "*" for any).
    public fn route(self, method, pattern, handler) {
        let up = method.upper();
        self.routes.push(
            map(
                "method",
                up,
                "pattern",
                pattern,
                "parts",
                split_path(pattern),
                "handler",
                handler
            )
        );
        if up == "*" or pattern.contains(":") or pattern.contains("*") {
            self.has_dynamic = true;
        } else {
            let key = up + " " + pattern;
            if not self.static_routes.has(key) {
                self.static_routes[key] = handler;
            }
            self.static_paths[pattern] = true;
        }
        return self;
    }

    public fn get(self, pattern, handler) {
        return self.route("GET", pattern, handler);
    }

    public fn post(self, pattern, handler) {
        return self.route("POST", pattern, handler);
    }

    public fn put(self, pattern, handler) {
        return self.route("PUT", pattern, handler);
    }

    public fn patch(self, pattern, handler) {
        return self.route("PATCH", pattern, handler);
    }

    public fn delete(self, pattern, handler) {
        return self.route("DELETE", pattern, handler);
    }

    /// Middleware runs before routing, in registration order. It receives
    /// the request and returns null to continue, or a response to stop.
    public fn before(self, handler) {
        self.middleware.push(handler);
        return self;
    }

    /// Route one request to a response map (no sockets involved), so apps
    /// can be unit-tested without a network.
    public fn dispatch(self, req) {
        if not req.has("params") {
            req["params"] = map();
        }
        if len(self.middleware) > 0 {
            for mw in self.middleware {
                let early = mw(req);
                if early != null {
                    return to_response(early);
                }
            }
        }
        let method = req["method"];
        let path = req["path"];
        if not self.has_dynamic {
            let key = method + " " + path;
            if self.static_routes.has(key) {
                let h = self.static_routes[key];
                return to_response(h(req));
            }
            if method == "HEAD" {
                let gkey = "GET " + path;
                if self.static_routes.has(gkey) {
                    let h = self.static_routes[gkey];
                    return to_response(h(req));
                }
            }
            if self.static_paths.has(path) {
                return http_text(405, "405 Method Not Allowed");
            }
            return http_text(404, "404 Not Found: " + path);
        }
        let path_matched = false;
        let parts = split_path(path);
        for r in self.routes {
            let m = match_parts(r["parts"], parts);
            if m.is_some() {
                path_matched = true;
                let rm = r["method"];
                if rm == "*" or rm == method or (rm == "GET" and method == "HEAD") {
                    req["params"] = m.unwrap();
                    let h = r["handler"];
                    return to_response(h(req));
                }
            }
        }
        if path_matched {
            return http_text(405, "405 Method Not Allowed");
        }
        return http_text(404, "404 Not Found: " + path);
    }

    /// Bind without serving yet. Returns the real address, which matters
    /// when `addr` uses port 0 ("127.0.0.1:0" picks a free port).
    public fn bind(self, addr) {
        let r = tcp_listen(addr);
        if r.is_err() {
            throw r.unwrap_err();
        }
        self.listener = r.unwrap();
        return tcp_local_addr(self.listener).unwrap();
    }

    /// Bind a TLS (PKCS#12) listener without serving yet.
    public fn bind_tls(self, cert_path, key_path, addr) {
        let r = tls_listen(cert_path, key_path, addr);
        if r.is_err() {
            throw r.unwrap_err();
        }
        self.listener = r.unwrap();
        self.opts["tls"] = true;
        return tcp_local_addr(self.listener).unwrap();
    }

    /// Accept connections on a bound server. `max_connections < 0` serves
    /// forever; otherwise returns after that many connections are accepted.
    ///
    /// Tuning lives in `server.opts` (a map, read per connection):
    ///   keep_alive (true), idle_timeout_ms (net.keepalive_ms, 5000),
    ///   timeout_ms (net.timeout_ms, 30000), max_requests_per_conn (100),
    ///   max_body_bytes (net.max_body, 8 MiB), max_headers (net.max_headers, 64),
    ///   drain_ms (5000), access_log (true), on_error (null -> 500 JSON).
    /// An explicit opts entry beats the spid3r.ini [net] default.
    public fn serve(self, max_connections) {
        if self.listener < 0 {
            throw "HttpServer.serve: call bind() or listen() first";
        }
        let app = self;
        let count = serve_listener(self.listener, fn(req) {
            return app.dispatch(req);
        }, with_logging(self.opts, self.logging), max_connections);
        return count;
    }

    /// Stop accepting and drain. Safe to call from another task (an admin
    /// endpoint, or a supervisor that saw a file appear).
    public fn shutdown(self) {
        if self.listener >= 0 {
            tcp_close(self.listener);
        }
        return true;
    }

    /// Bind and serve forever.
    public fn listen(self, addr) {
        let real = self.bind(addr);
        println("Spid3r HTTP server listening on http://" + real);
        return self.serve(-1);
    }

    /// Stop accepting connections; a blocked serve() returns.
    public fn close(self) {
        return self.shutdown();
    }
}

// ------------------------------------------------------------ the server loop

/// `server.logging` predates `opts`; honour it unless opts says otherwise.
fn with_logging(opts, logging) {
    if opts != null and type_of(opts) == "map" and opts.has("access_log") {
        return opts;
    }
    let out = map();
    if opts != null and type_of(opts) == "map" {
        for k in opts.keys() {
            out[k] = opts[k];
        }
    }
    out["access_log"] = logging;
    return out;
}

fn opt(m, key, dflt) {
    if m == null or type_of(m) != "map" {
        return dflt;
    }
    if m.has(key) {
        return m[key];
    }
    return dflt;
}

fn header_of(req, name) {
    if not req.has("headers") or type_of(req["headers"]) != "map" {
        return null;
    }
    let h = req["headers"];
    if h.has(name) {
        return string(h[name]);
    }
    return null;
}

/// Does this request allow the connection to stay open?
fn wants_keep_alive(req) {
    let c = header_of(req, "connection");
    if c != null {
        let v = c.lower();
        if v.contains("close") {
            return false;
        }
        if v.contains("keep-alive") {
            return true;
        }
    }
    // HTTP/1.1 keeps alive by default; HTTP/1.0 does not unless it asked.
    return string(opt(req, "version", "HTTP/1.1")) != "HTTP/1.0";
}

fn bump(counter, delta) {
    let g = counter.lock();
    g["n"] = g["n"] + delta;
    counter.unlock();
    return g["n"];
}

fn inflight_count(counter) {
    let g = counter.lock();
    let n = g["n"];
    counter.unlock();
    return n;
}

/// The production accept loop, shared by `HttpServer` and `WebApp`.
///
/// What it does that a bare `while tcp_accept` does not:
///   * **keep-alive** - several requests per connection, bounded by
///     `max_requests_per_conn` and an idle timeout between them;
///   * **graceful shutdown** - `shutdown_requested()` (Ctrl+C / SIGTERM) closes
///     the listener, then the loop waits up to `drain_ms` for in-flight
///     connections before returning;
///   * **error isolation** - a throwing dispatcher answers 500 and keeps the
///     connection sane instead of dropping it mid-response;
///   * **limits** - a body larger than `max_body_bytes` is rejected with 413,
///     and more than `max_headers` request headers with 431, before the
///     handler runs.
///
/// Per-connection limits (keep-alive, timeouts, body and header caps) are
/// resolved inside `handle_connection` from `opts`, falling back to the
/// `spid3r.ini` [net] keys, so they are re-read for every accepted connection.
///
/// Returns the number of accepted connections.
fn serve_worker_loop(listener, dispatch, opts, counter, watch_signals, is_tls, max_connections) {
    let accepted = 0;
    while max_connections < 0 or accepted < max_connections {
        if watch_signals and shutdown_requested() {
            tcp_close(listener);
            break;
        }
        // A *bounded* accept, not a blocking one. Interrupting a blocked
        // accept() is best-effort at best: std guarantees nothing, and the
        // self-connect that tcp_close uses to poke it can fail (seen on
        // windows-latest, where the accept then stayed blocked forever and the
        // server never noticed the shutdown). Polling gives the loop a bound it
        // owns, so shutdown is deterministic on every platform.
        let c = null;
        if is_tls {
            c = tls_accept(listener, 50);
        } else {
            try {
                c = tcp_accept_timeout(listener, 50);
            } catch (e) {
                if string(e).contains("is a TLS listener") {
                    is_tls = true;
                    c = tls_accept(listener, 50);
                } else {
                    throw e;
                }
            }
        }
        if c == null {
            if watch_signals and shutdown_requested() {
                tcp_close(listener);
                break;
            }
            continue;
        }
        if c.is_err() {
            let emsg = string(c.unwrap_err());
            if emsg.contains("TLS handshake") {
                continue;
            }
            break;
        }
        let conn = c.unwrap();
        accepted += 1;
        bump(counter, 1);
        spawn fn() {
            handle_connection(conn, dispatch, opts);
            bump(counter, -1);
            return 0;
        };
    }
    return accepted;
}

public fn serve_listener(listener, dispatch, opts, max_connections) {
    let drain_ms = int(opt(opts, "drain_ms", 5000));
    // A process-global signal flag stops *every* server in the process, which
    // is right for a standalone app and wrong for an embedded one (or a test
    // suite running several servers). opt out with watch_signals: false.
    let watch_signals = opt(opts, "watch_signals", true);
    let is_tls = opt(opts, "tls", false);
    let workers = 1;
    if max_connections < 0 and not is_tls {
        workers = int(opt(opts, "workers", 4));
        if workers < 1 {
            workers = 1;
        }
        if workers > 16 {
            workers = 16;
        }
    }

    let counter = mutex(map("n", 0));
    let wtasks = list();
    let wi = 1;
    while wi < workers {
        wtasks.push(spawn fn() {
            return serve_worker_loop(listener, dispatch, opts, counter, watch_signals, is_tls, max_connections);
        });
        wi += 1;
    }
    let accepted = serve_worker_loop(listener, dispatch, opts, counter, watch_signals, is_tls, max_connections);
    for wt in wtasks {
        accepted += wt.join();
    }
    if watch_signals and shutdown_requested() {
        tcp_close(listener);
    }

    // Drain: give in-flight requests a bounded window to finish.
    let waited = 0;
    while waited < drain_ms and inflight_count(counter) > 0 {
        sleep_ms(50);
        waited += 50;
    }
    return accepted;
}

/// Make a value safe to write into a log line: control characters, and the
/// escape character itself, become visible escapes.
///
/// The request path and the error text both contain client-controlled bytes. A
/// raw `\r\n` in either one forges an extra log line, and an ANSI escape
/// rewrites the operator's terminal (audit F-13).
fn log_safe(s) {
    let text = string(s);
    let out = "";
    let i = 0;
    let n = len(text);
    while i < n {
        let c = text.slice(i, i + 1);
        if c == "\n" {
            out = out + "\\n";
        } elif c == "\r" {
            out = out + "\\r";
        } elif c == "\t" {
            out = out + "\\t";
        } elif c == "\\" {
            out = out + "\\\\";
        } else {
            let code = ord(c);
            if code < 32 or code == 127 {
                out = out + "\\x" + hex_encode(bytes([code]));
            } else {
                out = out + c;
            }
        }
        i = i + 1;
    }
    return out;
}

/// A resolved integer from the live spid3r.ini (via the `config_get` native),
/// or `dflt` when the key is missing or not an integer.
fn cfg_int(key, dflt) {
    let v = config_get(key);
    if v == null {
        return dflt;
    }
    let n = int(v);
    if n == null {
        return dflt;
    }
    return n;
}

fn opt_cfg_int(m, key, cfg_key, dflt) {
    if m != null and type_of(m) == "map" and m.has(key) {
        let v = int(m[key]);
        if v != null {
            return v;
        }
    }
    return cfg_int(cfg_key, dflt);
}

fn write_stream_body(conn, source) {
    let st = type_of(source);
    if st == "list" {
        for item in source {
            if item != null and len(item) > 0 {
                let r = http_write_response_chunk(conn, item, false);
                if r.is_err() {
                    return false;
                }
            }
        }
        return http_write_response_chunk(conn, "", true).is_ok();
    }
    if st == "function" {
        while true {
            let chunk = source();
            if chunk == null or len(chunk) == 0 {
                break;
            }
            let r = http_write_response_chunk(conn, chunk, false);
            if r.is_err() {
                return false;
            }
        }
        return http_write_response_chunk(conn, "", true).is_ok();
    }
    if st == "int" {
        while true {
            let r = tcp_read(source, 8192);
            if r.is_err() {
                r = file_read(source, 8192);
                if r.is_err() {
                    break;
                }
            }
            let chunk = r.unwrap();
            if chunk == null or len(chunk) == 0 {
                break;
            }
            let w = http_write_response_chunk(conn, chunk, false);
            if w.is_err() {
                return false;
            }
        }
        return http_write_response_chunk(conn, "", true).is_ok();
    }
    if source != null and len(source) > 0 {
        return http_write_response_chunk(conn, source, true).is_ok();
    }
    return http_write_response_chunk(conn, "", true).is_ok();
}

fn with_chunked_header(headers) {
    if type_of(headers) == "list" {
        let out = list();
        for e in headers {
            out.push(e);
        }
        out.push(map("name", "transfer-encoding", "value", "chunked"));
        return out;
    }
    let out = map();
    if headers != null and type_of(headers) == "map" {
        for k in headers.keys() {
            out[k] = headers[k];
        }
    }
    out["transfer-encoding"] = "chunked";
    return out;
}

/// Serve one connection: up to `max_requests_per_conn` requests, then close.
///
/// Limits resolve per connection: an explicit `opts` entry wins, otherwise the
/// matching spid3r.ini [net] key is re-read (so `spid3r config reload` applies
/// to connections accepted afterwards):
///   timeout_ms           <- net.timeout_ms   (framing deadline; 0 disables)
///   idle_timeout_ms      <- net.keepalive_ms (idle window between requests)
///   max_body_bytes       <- net.max_body     (413 above it)
///   max_headers          <- net.max_headers  (431 above it)
fn handle_connection(conn, dispatch, opts) {
    let keep_alive = opt(opts, "keep_alive", true);
    let idle = opt_cfg_int(opts, "idle_timeout_ms", "net.keepalive_ms", 5000);
    let io_timeout = opt_cfg_int(opts, "timeout_ms", "net.timeout_ms", 30000);
    let max_reqs = int(opt(opts, "max_requests_per_conn", 100));
    let max_body = opt_cfg_int(opts, "max_body_bytes", "net.max_body", 8 * 1024 * 1024);
    let max_headers = opt_cfg_int(opts, "max_headers", "net.max_headers", 64);
    let access_log = opt(opts, "access_log", true);
    let on_error = opt(opts, "on_error", null);
    let watch_signals = opt(opts, "watch_signals", true);
    tcp_set_timeout(conn, io_timeout);
    let cur_timeout = io_timeout;
    let served = 0;
    while served < max_reqs {
        let start = 0;
        if access_log {
            start = now_ms();
        }
        let read = http_read_request(conn);
        if read.is_err() {
            let emsg = string(read.unwrap_err());
            if emsg.contains("body exceeds") {
                http_write_response(
                    conn,
                    413,
                    map("content-type", "application/json; charset=utf-8"),
                    json_write(map("error", "payload too large", "limit", max_body)),
                    false
                );
                break;
            }
            // A malformed first request deserves an answer; an idle timeout or
            // a peer that hung up does not.
            if served == 0 and not emsg.contains("timed out") {
                http_write_response(conn, 400, map(), "400 Bad Request", false);
            }
            break;
        }
        // Restore io_timeout after keep-alive idle wait only when they differ.
        if cur_timeout != io_timeout {
            tcp_set_timeout(conn, io_timeout);
            cur_timeout = io_timeout;
        }
        let req = read.unwrap();
        let req_headers = req["headers"];
        if len(req_headers) > max_headers {
            http_write_response(
                conn,
                431,
                map("content-type", "application/json; charset=utf-8"),
                json_write(
                    map("error", "request header fields too large", "limit", max_headers)
                ),
                false
            );
            break;
        }
        let actual_len = len(req["body_bytes"]);
        if actual_len > max_body {
            http_write_response(
                conn,
                413,
                map("content-type", "application/json; charset=utf-8"),
                json_write(map("error", "payload too large", "limit", max_body)),
                false
            );
            break;
        }
        if req_headers.has("content-length") {
            let cl = int(req_headers["content-length"]);
            if cl != null and cl > max_body {
                http_write_response(
                    conn,
                    413,
                    map("content-type", "application/json; charset=utf-8"),
                    json_write(map("error", "payload too large", "limit", max_body)),
                    false
                );
                break;
            }
        }
        let res = null;
        try {
            res = dispatch(req);
        } catch (e) {
            eprint(
                "[http] handler error on "
                + log_safe(opt(req, "method", "?"))
                + " "
                + log_safe(opt(req, "path", "?"))
                + ": "
                + log_safe(e)
                + "\n"
            );
            if on_error != null {
                try {
                    res = on_error(req, e);
                } catch (_e) {
                    res = null;
                }
            }
            if res == null {
                res = map(
                    "__http_response",
                    true,
                    "status",
                    500,
                    "headers",
                    map("content-type", "application/json; charset=utf-8"),
                    "body",
                    json_write(map("error", "internal server error"))
                );
            }
        }
        let status = 200;
        let headers = map();
        let body = "";
        let stream_src = null;
        if type_of(res) == "map" and res.has("__http_response") {
            status = res["status"];
            headers = res["headers"];
            body = res["body"];
            if res.has("stream") {
                stream_src = res["stream"];
            }
        } else {
            // A dispatcher that returned a bare value: answer as text.
            status = 200;
            body = string(res);
        }
        // keep_alive / idle = 0, pipelining detected, or graceful shutdown
        // requested: close after this response (Connection: close).
        let req_ka = true;
        if req_headers.has("connection") {
            let cv = string(req_headers["connection"]).lower();
            if cv.contains("close") {
                req_ka = false;
            } elif cv.contains("keep-alive") {
                req_ka = true;
            } elif req.has("version") and string(req["version"]) == "HTTP/1.0" {
                req_ka = false;
            }
        } elif req.has("version") and string(req["version"]) == "HTTP/1.0" {
            req_ka = false;
        }
        let more = keep_alive
        and idle > 0
        and req_ka
        and not (req.has("pipelined") and req["pipelined"])
        and not (watch_signals and shutdown_requested())
        and served + 1 < max_reqs;
        let head = req.has("method") and req["method"] == "HEAD";
        if stream_src != null {
            let sh = with_chunked_header(headers);
            let hw = http_write_response(conn, status, sh, null, more);
            if hw.is_err() {
                break;
            }
            if head {
                if http_write_response_chunk(conn, "", true).is_err() {
                    break;
                }
            } else {
                if not write_stream_body(conn, stream_src) {
                    break;
                }
            }
        } else {
            if head {
                body = "";
            }
            http_write_response(conn, status, headers, body, more);
        }
        served += 1;
        if access_log {
            eprint(
                "[http] "
                + log_safe(opt(req, "method", "GET"))
                + " "
                + log_safe(opt(req, "path", "/"))
                + " -> "
                + string(status)
                + " ("
                + string(now_ms() - start)
                + " ms)\n"
            );
        }
        if not more {
            break;
        }
        // Idle timeout between requests: a keep-alive connection that goes
        // quiet is closed instead of holding a worker forever.
        if cur_timeout != idle {
            tcp_set_timeout(conn, idle);
            cur_timeout = idle;
        }
    }
    tcp_close(conn);
    return true;
}
