// stdlib/http.matrix - a small HTTP/1.1 web framework, written in Spid3r.
//
//   import "http";
//
//   fn main() {
//       let app = new HttpServer();
//       app.get("/", fn(req) { return http_html(200, "<h1>Hello</h1>"); });
//       app.get("/users/:id", fn(req) {
//           return http_json(200, map("id", req["params"]["id"]));
//       });
//       app.listen("127.0.0.1:8080");
//       return 0;
//   }
//
// Socket I/O and HTTP framing are runtime natives (src/stdlib/net.rs); this
// module adds routing, path parameters, middleware, and response helpers.
// Every connection is handled in its own `spawn`ed task on the scheduler's
// OS-thread pool, so a slow client never blocks the others.
//
// A handler receives the request map and returns one of:
//   - a response built by http_response / http_text / http_html / http_json /
//     http_redirect
//   - a string             -> 200 text/html
//   - any other value      -> 200 application/json (json_write of the value)
//   - null                 -> 204 No Content
//
// Request map keys: method, path, query (map), raw_query, version,
// headers (map, lower-case names), body, remote, params (map of :name
// captures).

// ------------------------------------------------------------ responses

/// A response with an explicit status, header map, and body.
public fn http_response(status, headers, body) {
    return map("__http_response", true, "status", status, "headers", headers, "body", body);
}

public fn http_text(status, body) {
    return http_response(status, map("content-type", "text/plain; charset=utf-8"), body);
}

public fn http_html(status, body) {
    return http_response(status, map("content-type", "text/html; charset=utf-8"), body);
}

/// Serialize `value` with json_write.
public fn http_json(status, value) {
    return http_response(
        status,
        map("content-type", "application/json; charset=utf-8"),
        json_write(value)
    );
}

public fn http_redirect(location) {
    return http_response(302, map("location", location), "");
}

/// Make an HTTP client request: ok(response) or err(msg).
public fn http_fetch(method, url, headers = null, body = null) {
    if headers == null and body == null {
        return __http_fetch(method, url);
    } elif body == null {
        return __http_fetch(method, url, headers);
    } else {
        return __http_fetch(method, url, headers, body);
    }
}

/// Parse a request's JSON body: ok(value) / err(message).
public fn http_body_json(req) {
    try {
        return ok(json_parse(req["body"]));
    } catch (e) {
        return err("invalid JSON body: " + string(e));
    }
}

/// Turn whatever a handler returned into a response map.
fn to_response(value) {
    if value == null {
        return http_response(204, map(), "");
    }
    let t = type_of(value);
    if t == "string" {
        return http_html(200, value);
    }
    if t == "map" {
        if value.has("__http_response") {
            return value;
        }
    }
    return http_json(200, value);
}

// ------------------------------------------------------------ routing

fn split_path(path) {
    let out = list();
    for part in path.split("/") {
        if part != "" {
            out.push(part);
        }
    }
    return out;
}

/// Match a route pattern against a path. Returns some(params) or none.
/// `:name` captures one segment; a trailing `*` captures the rest as
/// params["*"].
fn match_path(pattern_parts, path) {
    let parts = split_path(path);
    let params = map();
    let n = len(pattern_parts);
    let i = 0;
    while i < n {
        let p = pattern_parts[i];
        if p == "*" {
            let rest = list();
            let j = i;
            while j < len(parts) {
                rest.push(parts[j]);
                j += 1;
            }
            params["*"] = rest.join("/");
            return some(params);
        }
        if i >= len(parts) {
            return none;
        }
        if p.starts_with(":") {
            params[p.slice(1)] = parts[i];
        } elif p != parts[i] {
            return none;
        }
        i += 1;
    }
    if len(parts) != n {
        return none;
    }
    return some(params);
}

// ------------------------------------------------------------ server

public class HttpServer {
    private let routes;
    private let middleware;
    private let listener;
    public let logging;
    /// Serve tuning: keep_alive, idle_timeout_ms, timeout_ms,
    /// max_requests_per_conn, max_body_bytes, drain_ms, access_log, on_error.
    public let opts;

    fn new () {
        self.routes = list();
        self.middleware = list();
        self.listener = -1;
        self.logging = true;
        self.opts = map();
    }

    /// Register `handler` for `method` ("GET", "POST", ..., or "*" for any).
    public fn route(self, method, pattern, handler) {
        self.routes.push(
            map(
                "method",
                method.upper(),
                "pattern",
                pattern,
                "parts",
                split_path(pattern),
                "handler",
                handler
            )
        );
        return self;
    }

    public fn get(self, pattern, handler) {
        return self.route("GET", pattern, handler);
    }

    public fn post(self, pattern, handler) {
        return self.route("POST", pattern, handler);
    }

    public fn put(self, pattern, handler) {
        return self.route("PUT", pattern, handler);
    }

    public fn patch(self, pattern, handler) {
        return self.route("PATCH", pattern, handler);
    }

    public fn delete(self, pattern, handler) {
        return self.route("DELETE", pattern, handler);
    }

    /// Middleware runs before routing, in registration order. It receives
    /// the request and returns null to continue, or a response to stop.
    public fn before(self, handler) {
        self.middleware.push(handler);
        return self;
    }

    /// Route one request to a response map (no sockets involved), so apps
    /// can be unit-tested without a network.
    public fn dispatch(self, req) {
        if not req.has("params") {
            req["params"] = map();
        }
        for mw in self.middleware {
            let early = mw(req);
            if early != null {
                return to_response(early);
            }
        }
        let method = req["method"];
        let path_matched = false;
        for r in self.routes {
            let m = match_path(r["parts"], req["path"]);
            if m.is_some() {
                path_matched = true;
                let rm = r["method"];
                if rm == "*" or rm == method or (rm == "GET" and method == "HEAD") {
                    req["params"] = m.unwrap();
                    let h = r["handler"];
                    return to_response(h(req));
                }
            }
        }
        if path_matched {
            return http_text(405, "405 Method Not Allowed");
        }
        return http_text(404, "404 Not Found: " + req["path"]);
    }

    /// Bind without serving yet. Returns the real address, which matters
    /// when `addr` uses port 0 ("127.0.0.1:0" picks a free port).
    public fn bind(self, addr) {
        let r = tcp_listen(addr);
        if r.is_err() {
            throw r.unwrap_err();
        }
        self.listener = r.unwrap();
        return tcp_local_addr(self.listener).unwrap();
    }

    /// Accept connections on a bound server. `max_connections < 0` serves
    /// forever; otherwise returns after that many connections are accepted.
    ///
    /// Tuning lives in `server.opts` (a map, read at serve time):
    ///   keep_alive (true), idle_timeout_ms (5000), timeout_ms (30000),
    ///   max_requests_per_conn (100), max_body_bytes (8 MiB), drain_ms (5000),
    ///   access_log (true), on_error (null -> 500 JSON)
    public fn serve(self, max_connections) {
        if self.listener < 0 {
            throw "HttpServer.serve: call bind() or listen() first";
        }
        let app = self;
        let count = serve_listener(self.listener, fn(req) {
            return app.dispatch(req);
        }, with_logging(self.opts, self.logging), max_connections);
        return count;
    }

    /// Stop accepting and drain. Safe to call from another task (an admin
    /// endpoint, or a supervisor that saw a file appear).
    public fn shutdown(self) {
        if self.listener >= 0 {
            tcp_close(self.listener);
        }
        return true;
    }

    /// Bind and serve forever.
    public fn listen(self, addr) {
        let real = self.bind(addr);
        println("Spid3r HTTP server listening on http://" + real);
        return self.serve(-1);
    }

    /// Stop accepting connections; a blocked serve() returns.
    public fn close(self) {
        return self.shutdown();
    }
}

// ------------------------------------------------------------ the server loop

/// `server.logging` predates `opts`; honour it unless opts says otherwise.
fn with_logging(opts, logging) {
    if opts != null and type_of(opts) == "map" and opts.has("access_log") {
        return opts;
    }
    let out = map();
    if opts != null and type_of(opts) == "map" {
        for k in opts.keys() {
            out[k] = opts[k];
        }
    }
    out["access_log"] = logging;
    return out;
}

fn opt(m, key, dflt) {
    if m == null or type_of(m) != "map" {
        return dflt;
    }
    if m.has(key) {
        return m[key];
    }
    return dflt;
}

fn header_of(req, name) {
    if not req.has("headers") or type_of(req["headers"]) != "map" {
        return null;
    }
    let h = req["headers"];
    if h.has(name) {
        return string(h[name]);
    }
    return null;
}

/// Does this request allow the connection to stay open?
fn wants_keep_alive(req) {
    let c = header_of(req, "connection");
    if c != null {
        let v = c.lower();
        if v.contains("close") {
            return false;
        }
        if v.contains("keep-alive") {
            return true;
        }
    }
    // HTTP/1.1 keeps alive by default; HTTP/1.0 does not unless it asked.
    return string(opt(req, "version", "HTTP/1.1")) != "HTTP/1.0";
}

fn bump(counter, delta) {
    let g = counter.lock();
    g["n"] = g["n"] + delta;
    counter.unlock();
    return g["n"];
}

fn inflight_count(counter) {
    let g = counter.lock();
    let n = g["n"];
    counter.unlock();
    return n;
}

/// The production accept loop, shared by `HttpServer` and `WebApp`.
///
/// What it does that a bare `while tcp_accept` does not:
///   * **keep-alive** - several requests per connection, bounded by
///     `max_requests_per_conn` and an idle timeout between them;
///   * **graceful shutdown** - `shutdown_requested()` (Ctrl+C / SIGTERM) closes
///     the listener, then the loop waits up to `drain_ms` for in-flight
///     connections before returning;
///   * **error isolation** - a throwing dispatcher answers 500 and keeps the
///     connection sane instead of dropping it mid-response;
///   * **limits** - a body larger than `max_body_bytes` is rejected with 413
///     before the handler runs.
///
/// Returns the number of accepted connections.
public fn serve_listener(listener, dispatch, opts, max_connections) {
    let keep_alive = opt(opts, "keep_alive", true);
    let idle = int(opt(opts, "idle_timeout_ms", 5000));
    let io_timeout = int(opt(opts, "timeout_ms", 30000));
    let max_reqs = int(opt(opts, "max_requests_per_conn", 100));
    let max_body = int(opt(opts, "max_body_bytes", 8 * 1024 * 1024));
    let drain_ms = int(opt(opts, "drain_ms", 5000));
    let access_log = opt(opts, "access_log", true);
    let on_error = opt(opts, "on_error", null);
    // A process-global signal flag stops *every* server in the process, which
    // is right for a standalone app and wrong for an embedded one (or a test
    // suite running several servers). opt out with watch_signals: false.
    let watch_signals = opt(opts, "watch_signals", true);

    let counter = mutex(map("n", 0));
    let stopping = map("v", false);

    // Ctrl+C / SIGTERM: close the listener so the blocking accept returns.
    if watch_signals {
        spawn fn() {
            while not stopping["v"] {
                if shutdown_requested() {
                    tcp_close(listener);
                    return 0;
                }
                sleep_ms(200);
            }
            return 0;
        };
    }

    let accepted = 0;
    while max_connections < 0 or accepted < max_connections {
        let c = tcp_accept(listener);
        if c.is_err() {
            break;
        }
        let conn = c.unwrap();
        accepted += 1;
        bump(counter, 1);
        spawn fn() {
            handle_connection(
                conn,
                dispatch,
                keep_alive,
                idle,
                io_timeout,
                max_reqs,
                max_body,
                access_log,
                on_error
            );
            bump(counter, -1);
            return 0;
        };
    }
    stopping["v"] = true;

    // Drain: give in-flight requests a bounded window to finish.
    let waited = 0;
    while waited < drain_ms and inflight_count(counter) > 0 {
        sleep_ms(50);
        waited += 50;
    }
    return accepted;
}

/// Make a value safe to write into a log line: control characters, and the
/// escape character itself, become visible escapes.
///
/// The request path and the error text both contain client-controlled bytes. A
/// raw `\r\n` in either one forges an extra log line, and an ANSI escape
/// rewrites the operator's terminal (audit F-13).
fn log_safe(s) {
    let text = string(s);
    let out = "";
    let i = 0;
    let n = len(text);
    while i < n {
        let c = text.slice(i, i + 1);
        if c == "\n" {
            out = out + "\\n";
        } elif c == "\r" {
            out = out + "\\r";
        } elif c == "\t" {
            out = out + "\\t";
        } elif c == "\\" {
            out = out + "\\\\";
        } else {
            let code = ord(c);
            if code < 32 or code == 127 {
                out = out + "\\x" + hex_encode(bytes([code]));
            } else {
                out = out + c;
            }
        }
        i = i + 1;
    }
    return out;
}

/// Serve one connection: up to `max_reqs` requests, then close.
fn handle_connection(
    conn,
    dispatch,
    keep_alive,
    idle,
    io_timeout,
    max_reqs,
    max_body,
    access_log,
    on_error
) {
    tcp_set_timeout(conn, io_timeout);
    let served = 0;
    while served < max_reqs {
        let start = now_ms();
        let read = http_read_request(conn);
        if read.is_err() {
            // A malformed first request deserves an answer; an idle timeout or
            // a peer that hung up does not.
            if served == 0 and not read.unwrap_err().contains("timed out") {
                http_write_response(conn, 400, map(), "400 Bad Request", false);
            }
            break;
        }
        let req = read.unwrap();
        let declared = header_of(req, "content-length");
        if declared != null and int(declared) != null and int(declared) > max_body {
            http_write_response(
                conn,
                413,
                map("content-type", "application/json; charset=utf-8"),
                json_write(map("error", "payload too large", "limit", max_body)),
                false
            );
            break;
        }
        let res = null;
        try {
            res = dispatch(req);
        } catch (e) {
            eprint(
                "[http] handler error on "
                + log_safe(opt(req, "method", "?"))
                + " "
                + log_safe(opt(req, "path", "?"))
                + ": "
                + log_safe(e)
                + "\n"
            );
            if on_error != null {
                try {
                    res = on_error(req, e);
                } catch (_e) {
                    res = null;
                }
            }
            if res == null {
                res = map(
                    "__http_response",
                    true,
                    "status",
                    500,
                    "headers",
                    map("content-type", "application/json; charset=utf-8"),
                    "body",
                    json_write(map("error", "internal server error"))
                );
            }
        }
        let status = 200;
        let headers = map();
        let body = "";
        if type_of(res) == "map" and res.has("__http_response") {
            status = res["status"];
            headers = res["headers"];
            body = res["body"];
        } else {
            // A dispatcher that returned a bare value: answer as text.
            status = 200;
            body = string(res);
        }
        let more = keep_alive and wants_keep_alive(req) and served + 1 < max_reqs;
        let head = string(opt(req, "method", "GET")) == "HEAD";
        if head {
            body = "";
        }
        http_write_response(conn, status, headers, body, more);
        served += 1;
        if access_log {
            eprint(
                "[http] "
                + log_safe(opt(req, "method", "GET"))
                + " "
                + log_safe(opt(req, "path", "/"))
                + " -> "
                + string(status)
                + " ("
                + string(now_ms() - start)
                + " ms)\n"
            );
        }
        if not more {
            break;
        }
        // Idle timeout between requests: a keep-alive connection that goes
        // quiet is closed instead of holding a worker forever.
        tcp_set_timeout(conn, idle);
    }
    tcp_close(conn);
    return true;
}
