// stdlib/semver.matrix - semantic version parsing and comparison, in Spid3r.
//
//   import "semver" as sv;
//
//   let v = sv.parse("1.2.3-alpha.1+build");
//   println(v["major"]);              // 1
//   println(sv.compare("1.2.3", "1.10.0"));   // -1 (1.2.3 < 1.10.0)
//   println(sv.compare("2.0.0", "1.9.9"));    // 1
//   println(sv.satisfies("1.2.3", ">=1.0.0 <2.0.0")); // true
//
// Follows semver.org 2.0.0: MAJOR.MINOR.PATCH[-prerelease][+build]. Build
// metadata is ignored in comparisons; prerelease ordering follows the spec
// (numeric identifiers compare numerically, alphanumeric lexically, and a
// prerelease version sorts BEFORE its release).

/// Parse a semver string into a map, or null when invalid.
public fn parse(v) {
    let build = "";
    let core = v;
    let plus = v.index_of("+");
    if plus >= 0 {
        core = v.slice(0, plus);
        build = v.slice(plus + 1, len(v));
    }
    let pre = "";
    let dash = core.index_of("-");
    if dash >= 0 {
        pre = core.slice(dash + 1, len(core));
        core = core.slice(0, dash);
    }
    let parts = core.split(".");
    if len(parts) != 3 {
        return null;
    }
    let major = int(parts[0]);
    let minor = int(parts[1]);
    let patch = int(parts[2]);
    if major == null or minor == null or patch == null {
        return null;
    }
    let pre_ids = [];
    if pre != "" {
        pre_ids = pre.split(".");
    }
    return map(
        "major", major,
        "minor", minor,
        "patch", patch,
        "prerelease", pre_ids,
        "build", build
    );
}

/// Is `s` all digits (an int parse that never throws)?
fn is_numeric(s) {
    if len(s) == 0 {
        return false;
    }
    let digits = "0123456789";
    let i = 0;
    while i < len(s) {
        if not digits.contains(s.slice(i, i + 1)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// -1 / 0 / 1 comparing two semver strings (invalid input compares as 0).
public fn compare(a, b) {
    let x = parse(a);
    let y = parse(b);
    if x == null or y == null {
        return 0;
    }
    if x["major"] != y["major"] {
        if x["major"] < y["major"] {
            return -1;
        }
        return 1;
    }
    if x["minor"] != y["minor"] {
        if x["minor"] < y["minor"] {
            return -1;
        }
        return 1;
    }
    if x["patch"] != y["patch"] {
        if x["patch"] < y["patch"] {
            return -1;
        }
        return 1;
    }
    // A version with a prerelease sorts before the same version without.
    let xp = x["prerelease"];
    let yp = y["prerelease"];
    if len(xp) == 0 and len(yp) == 0 {
        return 0;
    }
    if len(xp) == 0 {
        return 1;
    }
    if len(yp) == 0 {
        return -1;
    }
    let n = len(xp);
    if len(yp) < n {
        n = len(yp);
    }
    let i = 0;
    while i < n {
        let xa = xp[i];
        let ya = yp[i];
        let xn = null;
        let yn = null;
        if is_numeric(xa) {
            xn = int(xa);
        }
        if is_numeric(ya) {
            yn = int(ya);
        }
        if xn != null and yn != null {
            if xn != yn {
                if xn < yn {
                    return -1;
                }
                return 1;
            }
        } else if xn != null {
            return -1; // numeric < alphanumeric
        } else if yn != null {
            return 1;
        } else if xa != ya {
            if xa < ya {
                return -1;
            }
            return 1;
        }
        i = i + 1;
    }
    if len(xp) != len(yp) {
        if len(xp) < len(yp) {
            return -1;
        }
        return 1;
    }
    return 0;
}

fn cmp_one(v, op, target) {
    let c = compare(v, target);
    if op == ">=" {
        return c >= 0;
    }
    if op == "<=" {
        return c <= 0;
    }
    if op == ">" {
        return c > 0;
    }
    if op == "<" {
        return c < 0;
    }
    if op == "=" or op == "==" {
        return c == 0;
    }
    return false;
}

/// Does `v` satisfy a space-separated comparator chain
/// (`">=1.0.0 <2.0.0"`, or a bare version for exact equality)?
public fn satisfies(v, range) {
    let tokens = range.split(" ");
    let i = 0;
    while i < len(tokens) {
        let tok = tokens[i].trim();
        if tok != "" {
            let op = "=";
            let rest = tok;
            if tok.starts_with(">=") {
                op = ">=";
                rest = tok.slice(2, len(tok));
            } else if tok.starts_with("<=") {
                op = "<=";
                rest = tok.slice(2, len(tok));
            } else if tok.starts_with(">") {
                op = ">";
                rest = tok.slice(1, len(tok));
            } else if tok.starts_with("<") {
                op = "<";
                rest = tok.slice(1, len(tok));
            } else if tok.starts_with("=") {
                op = "=";
                rest = tok.slice(1, len(tok));
            }
            if not cmp_one(v, op, rest) {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

/// The major.minor.patch core (no prerelease/build), e.g. for display.
public fn core(v) {
    let p = parse(v);
    if p == null {
        return v;
    }
    return string(p["major"]) + "." + string(p["minor"]) + "." + string(p["patch"]);
}
