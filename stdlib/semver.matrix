// stdlib/semver.matrix - semantic version parsing and comparison, in Spid3r.
//
//   import "semver" as sv;
//
//   let v = sv.parse("1.2.3-alpha.1+build");
//   println(v["major"]);              // 1
//   println(sv.compare("1.2.3", "1.10.0"));   // -1 (1.2.3 < 1.10.0)
//   println(sv.compare("2.0.0", "1.9.9"));    // 1
//   println(sv.satisfies("1.2.3", ">=1.0.0 <2.0.0")); // true
//
// Follows semver.org 2.0.0: MAJOR.MINOR.PATCH[-prerelease][+build]. Build
// metadata is ignored in comparisons; prerelease ordering follows the spec
// (numeric identifiers compare numerically, alphanumeric lexically, and a
// prerelease version sorts BEFORE its release).

/// Parse a semver string into a map, or null when invalid.
public fn parse(v) {
    let build = "";
    let core = v;
    let plus = v.index_of("+");
    if plus >= 0 {
        core = v.slice(0, plus);
        build = v.slice(plus + 1, len(v));
    }
    let pre = "";
    let dash = core.index_of("-");
    if dash >= 0 {
        pre = core.slice(dash + 1, len(core));
        core = core.slice(0, dash);
    }
    let parts = core.split(".");
    if len(parts) != 3 {
        return null;
    }
    if not is_numeric(parts[0]) or not is_numeric(parts[1]) or not is_numeric(parts[2]) {
        return null;
    }
    let major = int(parts[0]);
    let minor = int(parts[1]);
    let patch = int(parts[2]);
    if major == null or minor == null or patch == null {
        return null;
    }
    let pre_ids = [];
    if pre != "" {
        pre_ids = pre.split(".");
    }
    return map(
        "major",
        major,
        "minor",
        minor,
        "patch",
        patch,
        "prerelease",
        pre_ids,
        "build",
        build
    );
}

/// Is `s` all digits (an int parse that never throws)?
fn is_numeric(s) {
    if len(s) == 0 {
        return false;
    }
    let digits = "0123456789";
    let i = 0;
    while i < len(s) {
        if not digits.contains(s.slice(i, i + 1)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// -1 / 0 / 1 comparing two semver strings (invalid input compares as 0).
public fn compare(a, b) {
    let x = parse(a);
    let y = parse(b);
    if x == null or y == null {
        return 0;
    }
    if x["major"] != y["major"] {
        if x["major"] < y["major"] {
            return -1;
        }
        return 1;
    }
    if x["minor"] != y["minor"] {
        if x["minor"] < y["minor"] {
            return -1;
        }
        return 1;
    }
    if x["patch"] != y["patch"] {
        if x["patch"] < y["patch"] {
            return -1;
        }
        return 1;
    }
    // A version with a prerelease sorts before the same version without.
    let xp = x["prerelease"];
    let yp = y["prerelease"];
    if len(xp) == 0 and len(yp) == 0 {
        return 0;
    }
    if len(xp) == 0 {
        return 1;
    }
    if len(yp) == 0 {
        return -1;
    }
    let n = len(xp);
    if len(yp) < n {
        n = len(yp);
    }
    let i = 0;
    while i < n {
        let xa = xp[i];
        let ya = yp[i];
        let xn = null;
        let yn = null;
        if is_numeric(xa) {
            xn = int(xa);
        }
        if is_numeric(ya) {
            yn = int(ya);
        }
        if xn != null and yn != null {
            if xn != yn {
                if xn < yn {
                    return -1;
                }
                return 1;
            }
        } else if xn != null {
            return -1;  // numeric < alphanumeric
        } else if yn != null {
            return 1;
        } else if xa != ya {
            if xa < ya {
                return -1;
            }
            return 1;
        }
        i = i + 1;
    }
    if len(xp) != len(yp) {
        if len(xp) < len(yp) {
            return -1;
        }
        return 1;
    }
    return 0;
}

fn cmp_one(v, op, target) {
    let c = compare(v, target);
    if op == ">=" {
        return c >= 0;
    }
    if op == "<=" {
        return c <= 0;
    }
    if op == ">" {
        return c > 0;
    }
    if op == "<" {
        return c < 0;
    }
    if op == "=" or op == "==" {
        return c == 0;
    }
    return false;
}

fn parse_partial(spec) {
    let core = spec;
    let plus = core.index_of("+");
    if plus >= 0 {
        core = core.slice(0, plus);
    }
    let dash = core.index_of("-");
    if dash >= 0 {
        core = core.slice(0, dash);
    }
    let parts = core.split(".");
    if len(parts) < 1 or len(parts) > 3 {
        return null;
    }
    if not is_numeric(parts[0]) {
        return null;
    }
    let major = int(parts[0]);
    let minor = null;
    let patch = null;
    if len(parts) >= 2 {
        if not is_numeric(parts[1]) {
            return null;
        }
        minor = int(parts[1]);
    }
    if len(parts) == 3 {
        if not is_numeric(parts[2]) {
            return null;
        }
        patch = int(parts[2]);
    }
    return map("major", major, "minor", minor, "patch", patch, "count", len(parts));
}

fn ver_str(maj, min, pat) {
    return string(maj) + "." + string(min) + "." + string(pat);
}

fn match_wildcard(vp, tok) {
    if tok == "*" or tok == "x" or tok == "X" {
        return true;
    }
    let parts = tok.split(".");
    if len(parts) < 2 or len(parts) > 3 {
        return null;
    }
    let has_wild = false;
    let i = 0;
    while i < len(parts) {
        let p = parts[i];
        if p == "x" or p == "X" or p == "*" {
            has_wild = true;
        }
        i = i + 1;
    }
    if not has_wild {
        return null;
    }
    if parts[0] != "x" and parts[0] != "X" and parts[0] != "*" {
        if not is_numeric(parts[0]) {
            return null;
        }
        if vp["major"] != int(parts[0]) {
            return false;
        }
    }
    if parts[1] != "x" and parts[1] != "X" and parts[1] != "*" {
        if not is_numeric(parts[1]) {
            return null;
        }
        if vp["minor"] != int(parts[1]) {
            return false;
        }
    }
    if len(parts) == 3 and parts[2] != "x" and parts[2] != "X" and parts[2] != "*" {
        if not is_numeric(parts[2]) {
            return null;
        }
        if vp["patch"] != int(parts[2]) {
            return false;
        }
    }
    return true;
}

/// Does `v` satisfy a space-separated comparator chain
/// (`">=1.0.0 <2.0.0"`, `"^1.2.3"`, `"~1.2.0"`, `"1.x"`, `"*"`, or a bare
/// version for exact equality)?
public fn satisfies(v, range) {
    let vp = parse(v);
    if vp == null {
        throw "semver.satisfies: invalid version '" + string(v) + "'";
    }
    let tokens = range.split(" ");
    let i = 0;
    while i < len(tokens) {
        let tok = tokens[i].trim();
        if tok != "" {
            let wm = match_wildcard(vp, tok);
            if wm != null {
                if not wm {
                    return false;
                }
            } else if tok.starts_with("^") {
                let rest = tok.slice(1, len(tok));
                let p = parse_partial(rest);
                if p == null {
                    throw "semver.satisfies: invalid caret range '" + tok + "'";
                }
                let maj = p["major"];
                let min = 0;
                if p["minor"] != null {
                    min = p["minor"];
                }
                let pat = 0;
                if p["patch"] != null {
                    pat = p["patch"];
                }
                let lower = rest;
                if parse(lower) == null {
                    lower = ver_str(maj, min, pat);
                }
                let upper = "";
                if maj > 0 {
                    upper = ver_str(maj + 1, 0, 0);
                } else if p["minor"] != null and min > 0 {
                    upper = ver_str(0, min + 1, 0);
                } else if p["patch"] != null {
                    upper = ver_str(0, 0, pat + 1);
                } else if p["minor"] != null {
                    upper = ver_str(0, 1, 0);
                } else {
                    upper = ver_str(1, 0, 0);
                }
                if not cmp_one(v, ">=", lower) or not cmp_one(v, "<", upper + "-0") {
                    return false;
                }
            } else if tok.starts_with("~") {
                let rest = tok.slice(1, len(tok));
                let p = parse_partial(rest);
                if p == null {
                    throw "semver.satisfies: invalid tilde range '" + tok + "'";
                }
                let maj = p["major"];
                let min = 0;
                if p["minor"] != null {
                    min = p["minor"];
                }
                let pat = 0;
                if p["patch"] != null {
                    pat = p["patch"];
                }
                let lower = rest;
                if parse(lower) == null {
                    lower = ver_str(maj, min, pat);
                }
                let upper = "";
                if p["count"] == 1 {
                    upper = ver_str(maj + 1, 0, 0);
                } else {
                    upper = ver_str(maj, min + 1, 0);
                }
                if not cmp_one(v, ">=", lower) or not cmp_one(v, "<", upper + "-0") {
                    return false;
                }
            } else {
                let op = "=";
                let rest = tok;
                if tok.starts_with(">=") {
                    op = ">=";
                    rest = tok.slice(2, len(tok));
                } else if tok.starts_with("<=") {
                    op = "<=";
                    rest = tok.slice(2, len(tok));
                } else if tok.starts_with("==") {
                    op = "==";
                    rest = tok.slice(2, len(tok));
                } else if tok.starts_with(">") {
                    op = ">";
                    rest = tok.slice(1, len(tok));
                } else if tok.starts_with("<") {
                    op = "<";
                    rest = tok.slice(1, len(tok));
                } else if tok.starts_with("=") {
                    op = "=";
                    rest = tok.slice(1, len(tok));
                } else if not is_numeric(tok.slice(0, 1)) {
                    let k = 0;
                    while k < len(tok) and not is_numeric(tok.slice(k, k + 1)) {
                        k = k + 1;
                    }
                    let bad_op = tok.slice(0, k);
                    throw "semver.satisfies: unknown operator '" + bad_op + "' in '" + tok + "'";
                }
                if parse(rest) == null {
                    throw "semver.satisfies: invalid version '" + rest + "' in '" + tok + "'";
                }
                if not cmp_one(v, op, rest) {
                    return false;
                }
            }
        }
        i = i + 1;
    }
    return true;
}

/// The major.minor.patch core (no prerelease/build), e.g. for display.
public fn core(v) {
    let p = parse(v);
    if p == null {
        return v;
    }
    return string(p["major"]) + "." + string(p["minor"]) + "." + string(p["patch"]);
}
