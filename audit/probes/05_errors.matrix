// probe 05: throw/catch/finally semantics
fn thrower() {
    throw "boom";
}

fn main() {
    try {
        thrower();
    } catch (e) {
        println("caught " + e);
    }

    try {
        throw 42;
    } catch (e) {
        println("int " + string(e) + " " + type_of(e));
    }

    try {
        throw map("code", 7);
    } catch (e) {
        println("map " + string(e));
    }

    try {
        try {
            throw "deep";
        } finally {
            println("inner-finally");
        }
    } catch (e) {
        println("outer " + e);
    }

    try {
        throw "x";
    } catch (e) {
        println("c1");
    } finally {
        println("fin");
    }

    let order = list();
    fn rethrow() {
        try {
            throw "r";
        } catch (e) {
            order.push("catch");
            throw e;
        } finally {
            order.push("finally");
        }
    }
    try {
        rethrow();
    } catch (e) {
        order.push("outer");
    }
    println(order);

    try {
        let xs = list();
        xs.pop();
    } catch (e) {
        println("pop: " + e);
    }
    return 0;
}
