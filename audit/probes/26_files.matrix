// probe 26: files, env, args
fn main() {
    println(file_exists("nonexistent_file_xyz.txt"));
    let w = write_file("probe_out.txt", "line1\nline2");
    println(w.is_ok());
    let r = read_file("probe_out.txt");
    println(r.is_ok());
    println(r.unwrap());
    println(args().len());
    println(env("SPID3R_PROBE_UNSET"));
    return 0;
}
