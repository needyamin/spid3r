// probe 06: classes, inheritance, interfaces, privacy, method values
class Animal {
    public let name;
    private let noise;

    fn new(name, noise) {
        self.name = name;
        self.noise = noise;
    }

    public fn speak(self) -> string {
        return self.name + " says " + self.noise;
    }

    fn noise_of(self) {
        return self.noise;
    }
}

class Dog extends Animal {
    fn new(name) {
        self.name = name;
        self.noise = "woof";
    }

    public fn speak(self) -> string {
        return "dog: " + self.name;
    }
}

class Puppy extends Dog {
    fn new(name) {
        self.name = name;
        self.noise = "yip";
    }
}

interface Greeter {
    fn greet(self);
}

class G implements Greeter {
    public let who;
    fn new(who) {
        self.who = who;
    }
    public fn greet(self) {
        return "hi " + self.who;
    }
}

fn main() {
    let d = new Dog("Rex");
    println(d.speak());
    let p = new Puppy("Bit");
    println(p.speak());
    try {
        println(p.noise_of());
    } catch (e) {
        println("noisef: " + e);
    }
    let g = new G("bob");
    println(g.greet());
    try {
        println(d.noise);
    } catch (e) {
        println("private: " + e);
    }
    let m = d.speak;
    println(m());
    try {
        let x = new Dog();
    } catch (e) {
        println("arity: " + e);
    }
    println(type_of(d));
    return 0;
}
