// probe 07b: node-based collections - heap/bst/graph/matrix
fn main() {
    let h = heap("min");
    h.push(5);
    h.push(1);
    h.push(3);
    println(h.pop());
    println(h.peek());

    let hmax = heap("max");
    hmax.push(5);
    hmax.push(1);
    println(hmax.pop());

    let b = bst();
    b.insert(5);
    b.insert(3);
    b.insert(8);
    b.insert(3);
    println(b.traverse("inorder"));
    println(b.min());
    println(b.max());
    println(b.depth());

    let g = graph("undirected");
    g.add_node("a");
    g.add_node("b");
    g.add_node("c");
    g.add_edge("a", "b");
    g.add_edge("b", "c");
    println(g.bfs("a"));
    println(g.dfs("a"));
    println(g.path_exists("a", "c"));
    println(g.neighbors("b"));

    let mx = matrix(2, 3, 0);
    mx[0][0] = 9;
    println(mx[0][0]);
    println(mx[1][2]);
    try {
        println(mx[2][0]);
    } catch (e) {
        println("mx: " + e);
    }

    let ll = linked_list();
    ll.push_back(1);
    ll.push_back(2);
    ll.push_front(0);
    println(ll.peek());
    println(ll.len());
    println(ll.pop_back());
    println(ll.len());
    return 0;
}
