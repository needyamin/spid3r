// probe 03: closures, capture, loop-variable capture
fn make_counter() {
    let c = 0;
    let inc = fn() {
        c = c + 1;
        return c;
    };
    return inc;
}

fn main() {
    let a = make_counter();
    let b = make_counter();
    a();
    a();
    println(a());
    println(b());

    let fns = list();
    for x in[0, 1, 2] {
        fns.push(fn() {
            return x;
        });
    }
    println(fns[0]());
    println(fns[1]());
    println(fns[2]());

    let ws = list();
    let i = 0;
    while i < 3 {
        ws.push(fn() {
            return i;
        });
        i = i + 1;
    }
    println(ws[0]());
    println(ws[2]());

    let n = 100;
    let outer = fn() {
        return fn() {
            return n;
        };
    };
    println(outer()());

    let base = 5;
    let addb = fn(x) {
        return x + base;
    };
    println(addb(2));
    return 0;
}
