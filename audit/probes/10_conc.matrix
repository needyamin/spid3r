// probe 10: channels, tasks, ref, mutex
async fn settle(t) {
    return await t;
}

fn main() {
    let ch = channel();
    spawn fn() {
        ch.send(1);
        ch.send(2);
    };
    println(ch.recv());
    println(ch.recv());

    let ch2 = channel();
    spawn fn() {
        sleep_ms(10);
        ch2.send("late");
    };
    println(ch2.try_recv());
    println(ch2.recv());
    println(ch2.try_recv());

    let t = spawn fn() {
        return 7;
    };
    println(settle(t));
    let ts = spawn fn() {
        sleep_ms(20);
        return "slow";
    };
    println(settle(ts));
    println(task_count() >= 0);

    let r = ref(5);
    r.set(r.get() + 1);
    println(r.get());

    let m = mutex(0);
    let v1 = m.lock();
    println(v1);

    let tfail = spawn fn() {
        throw "task-error";
    };
    sleep_ms(30);
    println(tfail.status());
    try {
        println(tfail.join());
    } catch (e) {
        println("joined-error: " + e);
    }
    return 0;
}
