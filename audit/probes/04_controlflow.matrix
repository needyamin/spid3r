// probe 04: control flow, short-circuit, try/finally with return
fn f(x) {
    if x == 1 {
        return "one";
    } elif x == 2 {
        return "two";
    } elif x == 3 {
        return "three";
    } else {
        return "many";
    }
}

fn main() {
    println(f(1));
    println(f(2));
    println(f(3));
    println(f(9));

    let s = 0;
    for i in[1, 2, 3, 4, 5] {
        if i == 2 {
            continue;
        }
        if i == 5 {
            break;
        }
        s = s + i;
    }
    println(s);

    let t = 0;
    for let k = 0; k < 10; k = k + 1 {
        if k % 2 == 0 {
            continue;
        }
        if k > 6 {
            break;
        }
        t = t + k;
    }
    println(t);

    let total = 0;
    for i in[1, 2] {
        for j in[1, 2] {
            if j == 2 {
                break;
            }
            total = total + i * 10 + j;
        }
    }
    println(total);

    let log = list();
    fn g() {
        try {
            return "from-try";
        } finally {
            log.push("finally-ran");
        }
    }
    println(g());
    println(log.len());

    fn h() {
        try {
            throw "inner";
        } catch (e) {
            return "caught-" + e;
        } finally {
            log.push("h-finally");
        }
    }
    println(h());
    println(log.len());

    let i2 = 0;
    while true {
        i2 = i2 + 1;
        if i2 >= 3 {
            break;
        }
    }
    println(i2);

    let calls = 0;
    fn bump(v) {
        calls = calls + 1;
        return v;
    }
    let r1 = false and bump(true);
    println(r1);
    println(calls);
    let r2 = true or bump(true);
    println(r2);
    println(calls);
    let r3 = true and bump(true);
    println(r3);
    println(calls);

    println(not true);
    println(not 0);
    println(not "");
    return 0;
}
