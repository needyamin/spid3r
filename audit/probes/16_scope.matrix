// probe 16: scoping and shadowing
fn main() {
    let x = 1;
    if true {
        let x = 2;
        println(x);
    }
    println(x);

    fn shadow_test(v) {
        let v = v + 1;
        return v;
    }
    println(shadow_test(5));

    let capme = "before";
    fn cap() {
        return capme;
    }
    let r = cap();
    println(r);
    return 0;
}
