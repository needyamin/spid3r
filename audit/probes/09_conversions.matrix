// probe 09: conversions, type_of, JSON
fn main() {
    println(type_of(1));
    println(type_of(1.0));
    println(type_of("s"));
    println(type_of(true));
    println(type_of(null));
    println(type_of(list()));
    println(type_of(map()));
    try {
        println(int("abc"));
    } catch (e) {
        println("i1: " + e);
    }
    println(int("42"));
    println(int(4.7));
    println(int(-4.7));
    println(int(true));
    try {
        println(int(null));
    } catch (e) {
        println("i2: " + e);
    }
    println(float("2.5"));
    try {
        println(float("x"));
    } catch (e) {
        println("f1: " + e);
    }
    println(string(12));
    println(string(1.5));
    println(string(list(1, 2)));
    println(string(map("a", 1)));
    println(bool(1));
    println(bool(0.0));
    println(bool("a"));
    println(bool(list()));
    println(bool(null));
    try {
        println(int(list(1)));
    } catch (e) {
        println("i3: " + e);
    }
    println(json_write(map("a", 1, "b", list(true, null))));
    println(json_parse("{\"k\": [1, 2.5, \"s\", true, null]}"));
    println(json_write(json_parse("[1, -2, 3.25]")));
    try {
        println(json_parse("{bad"));
    } catch (e) {
        println("j1: " + e);
    }
    return 0;
}
