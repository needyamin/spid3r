// probe 14: edge cases - indexing, bad ops, equality (isolated)
fn main() {
    let s = "hello";
    try {
        println(s[0]);
    } catch (e) {
        println("s0: " + e);
    }
    try {
        println(list(1, 2)[5]);
    } catch (e) {
        println("oob: " + e);
    }
    try {
        println(map("a", 1)["zz"]);
    } catch (e) {
        println("mk: " + e);
    }
    try {
        println(null.foo());
    } catch (e) {
        println("nf: " + e);
    }
    try {
        println(1.foo());
    } catch (e) {
        println("if: " + e);
    }
    try {
        println("a" - "b");
    } catch (e) {
        println("ssub: " + e);
    }
    try {
        println(list(1) + list(2));
    } catch (e) {
        println("ladd: " + e);
    }
    try {
        println(-"a");
    } catch (e) {
        println("negstr: " + e);
    }
    try {
        println(1 + null);
    } catch (e) {
        println("addnull: " + e);
    }
    try {
        println(list(1, 2) == list(1, 2));
    } catch (e) {
        println("leq: " + e);
    }
    try {
        println(map("a", 1) == map("a", 1));
    } catch (e) {
        println("meq: " + e);
    }
    try {
        println(list(1, 2) < list(2));
    } catch (e) {
        println("llt: " + e);
    }
    return 0;
}
