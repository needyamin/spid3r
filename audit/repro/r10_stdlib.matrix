fn main() {
    println(random_int(0, 100) >= 0);
    println(random_int(0, 100) != random_int(0, 100));
    println(json_write(json_parse("1e30")));
    println(json_write(json_parse("2.0")));
    println(json_parse(json_write(json_parse("\"\\u00e9\\ud83d\\ude00\""))));
    println(json_write(map("a\"b", 1, "x", "y\"z")));
    println(file_exists("."));
    let a = args();
    println(a.len());
    return 0;
}