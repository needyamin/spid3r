// examples/demo_apps/ecommerce/server.matrix
// Professional Mini E-Commerce Platform Server in pure Spid3r.
// Powered by Spid3r stdlib/http.matrix + SQLite 3 Persistence + Bootstrap 5 / jQuery.

import "http";

// ============================================================================
// 1. SQLite Database Initialization & Schema
// ============================================================================

fn resolve_db_path() -> string {
    let existing = list(
        "data/ecommerce.db",
        "examples/demo_apps/ecommerce/data/ecommerce.db",
        "../data/ecommerce.db"
    );
    for p in existing {
        if file_exists(p) {
            return p;
        }
    }
    if is_dir("examples/demo_apps/ecommerce/data") {
        return "examples/demo_apps/ecommerce/data/ecommerce.db";
    }
    if is_dir("../data") {
        return "../data/ecommerce.db";
    }
    return "data/ecommerce.db";
}

let DB_FILE = resolve_db_path();
let db = db_open(DB_FILE);
let server_start_time = unix_time();
let request_counter = mutex(ref(0));

fn init_sqlite_schema() {
    db.exec("CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price REAL NOT NULL, stock INTEGER NOT NULL, category TEXT NOT NULL, rating REAL NOT NULL, image TEXT NOT NULL, description TEXT NOT NULL)");
    db.exec("CREATE TABLE IF NOT EXISTS cart (product_id INTEGER PRIMARY KEY, qty INTEGER NOT NULL)");
    db.exec("CREATE TABLE IF NOT EXISTS coupons (code TEXT PRIMARY KEY, discount_type TEXT NOT NULL, value REAL NOT NULL)");
    db.exec("CREATE TABLE IF NOT EXISTS orders (order_id INTEGER PRIMARY KEY, customer_name TEXT NOT NULL, email TEXT NOT NULL, address TEXT NOT NULL, payment_method TEXT NOT NULL, items_json TEXT NOT NULL, items_count INTEGER NOT NULL, subtotal REAL NOT NULL, coupon TEXT NOT NULL, discount REAL NOT NULL, shipping REAL NOT NULL, tax REAL NOT NULL, total REAL NOT NULL, status TEXT NOT NULL, created_at INTEGER NOT NULL)");
    db.exec("CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT NOT NULL)");

    // Seed coupons if empty
    db.run("INSERT OR REPLACE INTO coupons (code, discount_type, value) VALUES (?, ?, ?)", list("SPID3R20", "percent", 0.20));
    db.run("INSERT OR REPLACE INTO coupons (code, discount_type, value) VALUES (?, ?, ?)", list("BOOTSTRAP", "fixed", 15.0));
    db.run("INSERT OR REPLACE INTO coupons (code, discount_type, value) VALUES (?, ?, ?)", list("SAVE10", "fixed", 10.0));
    db.run("INSERT OR REPLACE INTO coupons (code, discount_type, value) VALUES (?, ?, ?)", list("FLASH50", "percent", 0.50));

    // Seed default settings if missing
    db.run("INSERT OR IGNORE INTO settings (key, value) VALUES ('active_coupon', 'SPID3R20')");
    db.run("INSERT OR IGNORE INTO settings (key, value) VALUES ('next_order_id', '1001')");

    // Check if products table has data, seed if empty or incomplete
    let count_res = db.query("SELECT count(*) AS c FROM products");
    if count_res[0]["c"] < 8 {
        seed_baseline_products();
    }
}

fn seed_baseline_products() {
    db.run("DELETE FROM products");
    let prods = list(
        list(1, "Spid3r Mechanical Keyboard", 89.99, 15, "Peripherals", 4.9, "keyboard", "Tactile hot-swappable mechanical switches, RGB backlight & wireless Bluetooth."),
        list(2, "Ergonomic Gaming Mouse", 49.50, 20, "Peripherals", 4.8, "mouse", "Ultra-lightweight 58g chassis, 26K optical sensor & PTFE glide feet."),
        list(3, "UltraWide 34' Curved Monitor", 399.00, 5, "Displays", 4.9, "monitor", "165Hz QHD 1500R curved gaming panel with HDR400 and USB-C connectivity."),
        list(4, "Spatial Audio ANC Headphones", 129.99, 8, "Audio", 4.7, "headphones", "Active noise cancellation, 40-hour battery life and lossless audio codec."),
        list(5, "Aluminum 10-in-1 USB-C Dock", 64.00, 12, "Accessories", 4.6, "dock", "Dual 4K HDMI, Gigabit Ethernet, 100W Power Delivery and SD card slots."),
        list(6, "Studio Condenser Microphone", 79.99, 10, "Audio", 4.8, "mic", "Cardioid polar pattern, 24-bit/192kHz sampling, built-in shock mount and pop filter."),
        list(7, "Spid3r Mascot Ceramic Mug", 14.99, 50, "Merchandise", 5.0, "mug", "Premium 15oz matte ceramic coffee mug featuring the official Spid3r logo."),
        list(8, "XL Precision Felt Desk Mat", 24.50, 25, "Accessories", 4.7, "mat", "900x400mm water-resistant felt desk protector with stitched anti-fray edges.")
    );

    for p in prods {
        db.run("INSERT INTO products (id, name, price, stock, category, rating, image, description) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", p);
    }
    println("[SQLite] Seeded 8 products into SQLite database (" + DB_FILE + ")");
}

// ============================================================================
// 2. Financial & Cart Calculations from SQLite
// ============================================================================

fn calculate_discount(subtotal: float, coupon: string) -> float {
    if coupon == "SPID3R20" {
        return subtotal * 0.20; // 20% discount
    } elif coupon == "SAVE10" {
        if subtotal < 10.0 { return subtotal; }
        return 10.0;           // Fixed $10 off
    } elif coupon == "BOOTSTRAP" {
        if subtotal < 15.0 { return subtotal; }
        return 15.0;           // Fixed $15 off
    } elif coupon == "FLASH50" {
        return subtotal * 0.50; // 50% discount
    }
    return 0.0;
}

fn calculate_shipping(discounted_subtotal: float) -> float {
    if discounted_subtotal >= 50.0 or discounted_subtotal == 0.0 {
        return 0.0; // Free shipping threshold
    }
    return 5.99;    // Flat standard rate
}

fn fetch_active_coupon() -> string {
    let rows = db.query("SELECT value FROM settings WHERE key = 'active_coupon'");
    if rows.len() > 0 {
        return string(rows[0]["value"]);
    }
    return "";
}

fn fetch_cart_summary() {
    let rows = db.query("SELECT c.product_id, c.qty, p.name, p.price, p.stock, p.category, p.image FROM cart c JOIN products p ON c.product_id = p.id ORDER BY c.product_id ASC");
    let coupon = fetch_active_coupon();

    let items_out = list();
    let subtotal = 0.0;
    let total_qty = 0;

    for r in rows {
        let p_price = float(r["price"]);
        let p_qty = int(r["qty"]);
        let line_total = p_price * float(p_qty);
        subtotal = subtotal + line_total;
        total_qty = total_qty + p_qty;

        items_out.push(map(
            "product_id", r["product_id"],
            "name", r["name"],
            "price", p_price,
            "stock", r["stock"],
            "category", r["category"],
            "image", r["image"],
            "qty", p_qty,
            "line_total", line_total
        ));
    }

    let discount = calculate_discount(subtotal, coupon);
    let discounted = subtotal - discount;
    let shipping = calculate_shipping(discounted);
    let tax = discounted * 0.085; // 8.5%
    let total = discounted + shipping + tax;

    return map(
        "items", items_out,
        "total_qty", total_qty,
        "coupon", coupon,
        "subtotal", subtotal,
        "discount", discount,
        "shipping", shipping,
        "tax", tax,
        "total", total,
        "storage", "SQLite 3"
    );
}

// ============================================================================
// 3. HTTP / CORS Helpers
// ============================================================================

fn cors_json(status, data) {
    let headers = map(
        "content-type", "application/json; charset=utf-8",
        "access-control-allow-origin", "*",
        "access-control-allow-methods", "GET, POST, OPTIONS",
        "access-control-allow-headers", "content-type"
    );
    return http_response(status, headers, json_write(data));
}

fn cors_html(status, html_content) {
    let headers = map(
        "content-type", "text/html; charset=utf-8",
        "access-control-allow-origin", "*"
    );
    return http_response(status, headers, html_content);
}

fn cors_file(status, content_type, content) {
    let headers = map(
        "content-type", content_type,
        "access-control-allow-origin", "*",
        "cache-control", "no-cache"
    );
    return http_response(status, headers, content);
}

// ============================================================================
// 4. Main Server & API Routes
// ============================================================================

fn main() {
    init_sqlite_schema();

    let app = new HttpServer();

    // Middleware: Handle CORS preflight & count requests
    app.before(fn(req) {
        let counter = request_counter.lock();
        let cur = counter.get();
        counter.set(cur + 1);

        if req["method"] == "OPTIONS" {
            let headers = map(
                "access-control-allow-origin", "*",
                "access-control-allow-methods", "GET, POST, OPTIONS",
                "access-control-allow-headers", "content-type"
            );
            return http_response(204, headers, "");
        }
        return null;
    });

    // ------------------------------------------------------------------------
    // Static Asset Delivery Helper
    // ------------------------------------------------------------------------
    fn serve_static_asset(path: string, content_type: string) {
        let candidates = list(
            "public/" + path,
            "../public/" + path,
            "examples/demo_apps/ecommerce/public/" + path,
            "c:/Users/needyamin/OneDrive/Desktop/spid3r/examples/demo_apps/ecommerce/public/" + path,
            path,
            "examples/demo_apps/ecommerce/" + path
        );

        for p in candidates {
            let res = read_file(p);
            if res.is_ok() {
                return cors_file(200, content_type, res.unwrap());
            }
        }
        return cors_json(404, map("error", "Static asset not found: " + path));
    }

    // ------------------------------------------------------------------------
    // Route 1: Serve Frontend HTML & Static Assets
    // ------------------------------------------------------------------------
    app.get("/", fn(_req) {
        return serve_static_asset("index.html", "text/html; charset=utf-8");
    });

    app.get("/index.html", fn(_req) {
        return serve_static_asset("index.html", "text/html; charset=utf-8");
    });

    app.get("/css/app.css", fn(_req) {
        return serve_static_asset("css/app.css", "text/css; charset=utf-8");
    });

    app.get("/js/app.js", fn(_req) {
        return serve_static_asset("js/app.js", "application/javascript; charset=utf-8");
    });

    app.get("/favicon.ico", fn(_req) {
        return map("status", 204, "headers", map("Content-Type", "image/x-icon"), "body", "");
    });

    // ------------------------------------------------------------------------
    // Route 2: System Health & SQLite Metrics (GET /api/health)
    // ------------------------------------------------------------------------
    app.get("/api/health", fn(_req) {
        let now = unix_time();
        let counter = request_counter.lock();
        let prods_count = int(db.query("SELECT count(*) as c FROM products")[0]["c"]);
        let orders_count = int(db.query("SELECT count(*) as c FROM orders")[0]["c"]);
        let cart_qty = int(db.query("SELECT ifnull(sum(qty), 0) as q FROM cart")[0]["q"]);

        return cors_json(200, map(
            "status", "healthy",
            "server", "Spid3r HTTP/1.1 Native Engine",
            "database", "SQLite 3 (Persistent)",
            "db_path", DB_FILE,
            "version", "1.0.0",
            "uptime_seconds", now - server_start_time,
            "requests_served", counter.get(),
            "products_count", prods_count,
            "orders_count", orders_count,
            "cart_items_count", cart_qty
        ));
    });

    // ------------------------------------------------------------------------
    // Route 3: Catalog Listing from SQLite (GET /api/products)
    // ------------------------------------------------------------------------
    app.get("/api/products", fn(_req) {
        let prods = db.query("SELECT id, name, price, stock, category, rating, image, description FROM products ORDER BY id ASC");
        return cors_json(200, map("products", prods, "storage", "SQLite 3"));
    });

    // ------------------------------------------------------------------------
    // Route 4: Single Product Detail (GET /api/products/:id)
    // ------------------------------------------------------------------------
    app.get("/api/products/:id", fn(req) {
        let raw = string(req["params"]["id"]).replace("prod-", "").trim();
        let id_val = int(raw);
        let rows = db.query("SELECT id, name, price, stock, category, rating, image, description FROM products WHERE id = ?", list(id_val));
        if rows.len() > 0 {
            return cors_json(200, rows[0]);
        }
        return cors_json(404, map("error", "Product not found"));
    });

    // ------------------------------------------------------------------------
    // Route 4b: SQLite Storage Statistics (GET /api/db/stats)
    // ------------------------------------------------------------------------
    app.get("/api/db/stats", fn(_req) {
        let prods_count = int(db.query("SELECT count(*) as c FROM products")[0]["c"]);
        let orders_count = int(db.query("SELECT count(*) as c FROM orders")[0]["c"]);
        let cart_qty = int(db.query("SELECT ifnull(sum(qty), 0) as q FROM cart")[0]["q"]);
        let coupons_count = int(db.query("SELECT count(*) as c FROM coupons")[0]["c"]);
        return cors_json(200, map(
            "engine", "SQLite 3",
            "db_path", DB_FILE,
            "products", prods_count,
            "orders", orders_count,
            "coupons", coupons_count,
            "cart_items", cart_qty
        ));
    });

    // ------------------------------------------------------------------------
    // Route 5: Read Shopping Cart (GET /api/cart)
    // ------------------------------------------------------------------------
    app.get("/api/cart", fn(_req) {
        return cors_json(200, fetch_cart_summary());
    });

    // Helper: Safely extract product ID from JSON payload (supports product_id, productId, id, and 'prod-X' strings)
    fn extract_target_id(body) {
        let raw = "";
        if body.has("product_id") {
            raw = string(body["product_id"]);
        } else if body.has("productId") {
            raw = string(body["productId"]);
        } else if body.has("id") {
            raw = string(body["id"]);
        }
        if raw == "" {
            return 0;
        }
        let cleaned = raw.replace("prod-", "").trim();
        return int(cleaned);
    }

    // Helper: Safely extract quantity (supports qty or quantity)
    fn extract_target_qty(body) {
        if body.has("qty") {
            return int(body["qty"]);
        } else if body.has("quantity") {
            return int(body["quantity"]);
        }
        return 1;
    }

    // ------------------------------------------------------------------------
    // Route 6: Add Item to Cart with Stock Verification (POST /api/cart/add)
    // (FIXED: Zero deadlock, SQLite transactional updates, safe key parsing)
    // ------------------------------------------------------------------------
    app.post("/api/cart/add", fn(req) {
        let parsed = http_body_json(req);
        if parsed.is_err() {
            return cors_json(400, map("error", parsed.unwrap_err()));
        }
        let body = parsed.unwrap();
        let prod_id = extract_target_id(body);
        if prod_id <= 0 {
            return cors_json(400, map("error", "Missing or invalid product_id parameter"));
        }
        let qty = extract_target_qty(body);
        if qty <= 0 {
            return cors_json(400, map("error", "Quantity must be greater than zero"));
        }

        try {
            let p_rows = db.query("SELECT id, name, price, stock FROM products WHERE id = ?", list(prod_id));
            if p_rows.len() == 0 {
                return cors_json(404, map("error", "Product #" + string(prod_id) + " not found in database"));
            }
            let p = p_rows[0];
            let max_stock = int(p["stock"]);

            let cart_rows = db.query("SELECT qty FROM cart WHERE product_id = ?", list(prod_id));
            let cur_qty = 0;
            if cart_rows.len() > 0 {
                cur_qty = int(cart_rows[0]["qty"]);
            }

            if cur_qty + qty > max_stock {
                return cors_json(400, map("error", "Cannot add: only " + string(max_stock) + " units in stock"));
            }

            if cart_rows.len() > 0 {
                db.run("UPDATE cart SET qty = qty + ? WHERE product_id = ?", list(qty, prod_id));
            } else {
                db.run("INSERT INTO cart (product_id, qty) VALUES (?, ?)", list(prod_id, qty));
            }

            println("[SQLite Store] Added product #" + string(prod_id) + " (" + p["name"] + ") to cart. Qty added: " + string(qty));
            return cors_json(200, fetch_cart_summary());
        } catch (e) {
            return cors_json(500, map("error", "Failed to add item: " + string(e)));
        }
    });

    // ------------------------------------------------------------------------
    // Route 7: Update Cart Quantity (POST /api/cart/update)
    // ------------------------------------------------------------------------
    app.post("/api/cart/update", fn(req) {
        let parsed = http_body_json(req);
        if parsed.is_err() {
            return cors_json(400, map("error", parsed.unwrap_err()));
        }
        let body = parsed.unwrap();
        let prod_id = extract_target_id(body);
        if prod_id <= 0 {
            return cors_json(400, map("error", "Missing or invalid product_id parameter"));
        }
        let new_qty = 0;
        if body.has("qty") {
            new_qty = int(body["qty"]);
        } else if body.has("quantity") {
            new_qty = int(body["quantity"]);
        }

        try {
            if new_qty <= 0 {
                db.run("DELETE FROM cart WHERE product_id = ?", list(prod_id));
            } else {
                let p_rows = db.query("SELECT stock FROM products WHERE id = ?", list(prod_id));
                if p_rows.len() == 0 {
                    return cors_json(404, map("error", "Product not found"));
                }
                let max_stock = int(p_rows[0]["stock"]);
                if new_qty > max_stock {
                    return cors_json(400, map("error", "Requested quantity exceeds available stock (" + string(max_stock) + ")"));
                }
                db.run("UPDATE cart SET qty = ? WHERE product_id = ?", list(new_qty, prod_id));
            }
            return cors_json(200, fetch_cart_summary());
        } catch (e) {
            return cors_json(500, map("error", "Update failed: " + string(e)));
        }
    });

    // ------------------------------------------------------------------------
    // Route 8: Remove Item from Cart (POST /api/cart/remove)
    // ------------------------------------------------------------------------
    app.post("/api/cart/remove", fn(req) {
        let parsed = http_body_json(req);
        if parsed.is_err() {
            return cors_json(400, map("error", parsed.unwrap_err()));
        }
        let body = parsed.unwrap();
        let prod_id = extract_target_id(body);
        if prod_id <= 0 {
            return cors_json(400, map("error", "Missing or invalid product_id parameter"));
        }

        try {
            db.run("DELETE FROM cart WHERE product_id = ?", list(prod_id));
            return cors_json(200, fetch_cart_summary());
        } catch (e) {
            return cors_json(500, map("error", "Remove failed: " + string(e)));
        }
    });

    // ------------------------------------------------------------------------
    // Route 9: Clear Cart (POST /api/cart/clear)
    // ------------------------------------------------------------------------
    app.post("/api/cart/clear", fn(_req) {
        try {
            db.run("DELETE FROM cart");
            return cors_json(200, fetch_cart_summary());
        } catch (e) {
            return cors_json(500, map("error", "Clear cart failed: " + string(e)));
        }
    });

    // ------------------------------------------------------------------------
    // Route 10: Apply Promo Coupon (POST /api/cart/coupon)
    // ------------------------------------------------------------------------
    app.post("/api/cart/coupon", fn(req) {
        let parsed = http_body_json(req);
        if parsed.is_err() {
            return cors_json(400, map("error", parsed.unwrap_err()));
        }
        let body = parsed.unwrap();
        let code = "";
        if body.has("coupon") {
            code = string(body["coupon"]).upper();
        }

        try {
            db.run("INSERT OR REPLACE INTO settings (key, value) VALUES ('active_coupon', ?)", list(code));
            println("[SQLite Store] Active coupon updated to: '" + code + "'");
            return cors_json(200, fetch_cart_summary());
        } catch (e) {
            return cors_json(500, map("error", "Coupon update failed: " + string(e)));
        }
    });

    // ------------------------------------------------------------------------
    // Route 11: Transactional Checkout (POST /api/checkout)
    // ------------------------------------------------------------------------
    app.post("/api/checkout", fn(req) {
        let parsed = http_body_json(req);
        if parsed.is_err() {
            return cors_json(400, map("error", parsed.unwrap_err()));
        }
        let body = parsed.unwrap();
        let customer_name = "Guest Customer";
        if body.has("customer_name") and body["customer_name"] != "" {
            customer_name = string(body["customer_name"]);
        } else if body.has("customerName") and body["customerName"] != "" {
            customer_name = string(body["customerName"]);
        }
        let email = "customer@example.com";
        if body.has("email") and body["email"] != "" {
            email = string(body["email"]);
        } else if body.has("customerEmail") and body["customerEmail"] != "" {
            email = string(body["customerEmail"]);
        }
        let address = "Standard Shipping Address";
        if body.has("address") and body["address"] != "" {
            address = string(body["address"]);
        } else if body.has("shippingAddress") and body["shippingAddress"] != "" {
            address = string(body["shippingAddress"]);
        }
        let payment_method = "Spid3r Pay";
        if body.has("payment_method") and body["payment_method"] != "" {
            payment_method = string(body["payment_method"]);
        } else if body.has("paymentMethod") and body["paymentMethod"] != "" {
            payment_method = string(body["paymentMethod"]);
        }

        try {
            let cart_items = db.query("SELECT c.product_id, c.qty, p.name, p.price, p.stock FROM cart c JOIN products p ON c.product_id = p.id");
            if cart_items.len() == 0 {
                return cors_json(400, map("error", "Cannot checkout an empty shopping cart"));
            }

            // Phase 1: Stock validation guard
            for item in cart_items {
                let req_qty = int(item["qty"]);
                let cur_stock = int(item["stock"]);
                if req_qty > cur_stock {
                    return cors_json(400, map("error", "Insufficient stock for " + item["name"] + " (requested: " + string(req_qty) + ", available: " + string(cur_stock) + ")"));
                }
            }

            // Phase 2: Deduct stock from SQLite products table
            let subtotal = 0.0;
            let items_list = list();
            for item in cart_items {
                let pid = int(item["product_id"]);
                let p_qty = int(item["qty"]);
                let p_price = float(item["price"]);
                let line_total = p_price * float(p_qty);
                subtotal = subtotal + line_total;

                db.run("UPDATE products SET stock = stock - ? WHERE id = ?", list(p_qty, pid));

                items_list.push(map(
                    "product_id", pid,
                    "name", item["name"],
                    "price", p_price,
                    "qty", p_qty,
                    "line_total", line_total
                ));
            }

            // Financials
            let coupon = fetch_active_coupon();
            let discount = calculate_discount(subtotal, coupon);
            let discounted = subtotal - discount;
            let shipping = calculate_shipping(discounted);
            let tax = discounted * 0.085;
            let total = discounted + shipping + tax;

            // Generate order ID from SQLite settings
            let next_id_rows = db.query("SELECT value FROM settings WHERE key = 'next_order_id'");
            let order_id = 1001;
            if next_id_rows.len() > 0 {
                order_id = int(next_id_rows[0]["value"]);
            }
            db.run("UPDATE settings SET value = ? WHERE key = 'next_order_id'", list(string(order_id + 1)));

            let created_at = unix_time();
            let items_json_str = json_write(items_list);

            // Record into SQLite orders table
            db.run("INSERT INTO orders (order_id, customer_name, email, address, payment_method, items_json, items_count, subtotal, coupon, discount, shipping, tax, total, status, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", list(
                order_id,
                customer_name,
                email,
                address,
                payment_method,
                items_json_str,
                cart_items.len(),
                subtotal,
                coupon,
                discount,
                shipping,
                tax,
                total,
                "CONFIRMED",
                created_at
            ));

            // Clear cart & coupon after successful confirmation
            db.run("DELETE FROM cart");
            db.run("UPDATE settings SET value = '' WHERE key = 'active_coupon'");

            let receipt = map(
                "order_id", order_id,
                "customer_name", customer_name,
                "email", email,
                "address", address,
                "payment_method", payment_method,
                "items", items_list,
                "items_count", cart_items.len(),
                "subtotal", subtotal,
                "coupon", coupon,
                "discount", discount,
                "shipping", shipping,
                "tax", tax,
                "total", total,
                "status", "CONFIRMED",
                "timestamp", created_at,
                "storage", "SQLite 3 (Persistent)"
            );

            println("\n========================================================");
            println("[SQLite Checkout] Order #" + string(order_id) + " CONFIRMED for " + customer_name);
            println("  Total: $" + string(total) + " (" + string(items_list.len()) + " distinct items)");
            println("========================================================\n");

            return cors_json(200, receipt);
        } catch (e) {
            return cors_json(500, map("error", "Checkout transaction failed: " + string(e)));
        }
    });

    // ------------------------------------------------------------------------
    // Route 12: Order History from SQLite (GET /api/orders)
    // ------------------------------------------------------------------------
    app.get("/api/orders", fn(_req) {
        let orders = db.query("SELECT order_id, customer_name, email, items_count, subtotal, discount, shipping, tax, total, status, created_at FROM orders ORDER BY order_id DESC");
        return cors_json(200, map("orders", orders, "storage", "SQLite 3"));
    });

    // ------------------------------------------------------------------------
    // Route 13: Restock Inventory in SQLite (POST /api/inventory/restock)
    // ------------------------------------------------------------------------
    app.post("/api/inventory/restock", fn(_req) {
        try {
            seed_baseline_products();
            return cors_json(200, map("status", "ok", "message", "SQLite product inventory replenished successfully"));
        } catch (e) {
            return cors_json(500, map("error", "Restock failed: " + string(e)));
        }
    });

    // ------------------------------------------------------------------------
    // Start Listening
    // ------------------------------------------------------------------------
    let port = "8080";
    let a = args();
    if len(a) > 0 {
        port = a[0];
    }

    println("================================================================");
    println("      SPID3R MINI E-COMMERCE PLATFORM (SQLITE 3 EDITION)        ");
    println("================================================================");
    println("  Database:   " + DB_FILE + " (SQLite 3 Active)");
    println("  Running on: http://127.0.0.1:" + port);
    println("  Web UI:     http://127.0.0.1:" + port + "/");
    println("  REST API:   http://127.0.0.1:" + port + "/api/products");
    println("  Press Ctrl+C to terminate the server");
    println("================================================================\n");

    app.listen("127.0.0.1:" + port);
    return 0;
}
