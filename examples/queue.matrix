// examples/queue.matrix - strict FIFO, and the deque.
fn main() {
    let tickets = queue();
    tickets.push("T-1");
    tickets.push("T-2");
    tickets.push("T-3");

    println(tickets.pop());
    println(tickets.pop());
    println(tickets.len());

    let dq = deque();
    dq.push_back(2);
    dq.push_front(1);
    dq.push_back(3);
    println(dq.pop_front());
    println(dq.pop_back());
    println(dq.peek_front());
    return 0;
}
