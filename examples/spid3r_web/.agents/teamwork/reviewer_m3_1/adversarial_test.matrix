// .agents/teamwork/reviewer_m3_1/adversarial_test.matrix
// Independent adversarial stress-test suite for SpiderBD Template Engine

import "framework/View/BD";
import "app/Models/Post";
import "app/Models/User";

fn assert_true(cond: bool, msg: string) {
    assert(cond, msg);
}

fn test_edge_cases_and_adversarial_inputs() {
    let bd = new BD();

    // 1. Tag whitespace variations
    let t_view = "resources/views/adv_ws.bd.html";
    let content = "<p>" + "{{" + "$val" + "}}" + "</p>" +
                  "<p>" + "{{" + "      $val     " + "}}" + "</p>" +
                  "<p>" + "{!!" + "   raw_val   " + "!!}" + "</p>";
    write_file(t_view, content);
    let r1 = bd.render("adv_ws", map("val", "hello", "raw_val", "<b>ok</b>"));
    file_delete(t_view);

    assert_true(r1.contains("<p>hello</p>"), "Zero-space variable tag should interpolate");
    assert_true(r1.contains("<p>hello</p>"), "Excessive whitespace in tag should interpolate");
    assert_true(r1.contains("<p><b>ok</b></p>"), "Raw tag with whitespace should interpolate unescaped");

    // 2. HTML escaping vs raw
    let xss = "<script>alert('xss & \"attack\"')</script>";
    let t2_view = "resources/views/adv_esc.bd.html";
    write_file(t2_view, "esc:" + "{{" + "xss" + "}}" + " raw:" + "{!!" + "xss" + "!!}");
    let r2 = bd.render("adv_esc", map("xss", xss));
    file_delete(t2_view);

    assert_true(r2.contains("esc:&lt;script&gt;alert(&#039;xss &amp; &quot;attack&quot;&#039;)&lt;/script&gt;"), "Escaped output should escape all special chars");
    assert_true(r2.contains("raw:" + xss), "Raw output should not be escaped");

    // 3. Null and missing values
    let t3_view = "resources/views/adv_null.bd.html";
    write_file(t3_view, "A:[" + "{{" + "missing" + "}}" + "] B:[" + "{{" + "deep.null.prop" + "}}" + "] C:[" + "{{" + "null_val" + "}}" + "]");
    let r3 = bd.render("adv_null", map("null_val", null, "deep", map("null", null)));
    file_delete(t3_view);

    assert_true(r3.contains("A:[] B:[] C:[]"), "Missing and null variables should produce empty string without crash");

    // 4. Numeric and boolean values
    let t4_view = "resources/views/adv_types.bd.html";
    write_file(t4_view, "zero:" + "{{" + "n0" + "}}" + " pos:" + "{{" + "n1" + "}}" + " true:" + "{{" + "b1" + "}}" + " false:" + "{{" + "b0" + "}}");
    let r4 = bd.render("adv_types", map("n0", 0, "n1", 42, "b1", true, "b0", false));
    file_delete(t4_view);

    assert_true(r4.contains("zero:0 pos:42 true:true false:false"), "Numbers and booleans should stringify correctly");

    // 5. List indexing in dot-path
    let t5_view = "resources/views/adv_list.bd.html";
    write_file(t5_view, "item0:" + "{{" + "items.0.name" + "}}" + " item1:" + "{{" + "items.1.name" + "}}" + " oob:[" + "{{" + "items.9.name" + "}}" + "]");
    let r5 = bd.render("adv_list", map("items", list(map("name", "first"), map("name", "second"))));
    file_delete(t5_view);

    assert_true(r5.contains("item0:first item1:second oob:[]"), "List numeric indexing in dot-path should work and out-of-bounds return empty");

    // 6. Active Record Model attributes resolution
    let post = new Post(map("title", "Adversarial Testing", "views_count", 999));
    let t6_view = "resources/views/adv_model.bd.html";
    write_file(t6_view, "title:" + "{{" + "post.title" + "}}" + " count:" + "{{" + "post.views_count" + "}}");
    let r6 = bd.render("adv_model", map("post", post));
    file_delete(t6_view);

    assert_true(r6.contains("title:Adversarial Testing count:999"), "Active Record Model attributes should resolve");

    // 7. Malformed tags (unclosed)
    let t7_view = "resources/views/adv_unclosed.bd.html";
    write_file(t7_view, "Start " + "{{" + " unclosed " + " End");
    let r7 = bd.render("adv_unclosed", map("unclosed", "should_not_crash"));
    file_delete(t7_view);

    assert_true(r7.contains("Start {{ unclosed  End"), "Unclosed tag should not crash and preserve text");

    let t8_view = "resources/views/adv_unclosed_raw.bd.html";
    write_file(t8_view, "Start " + "{!!" + " unclosed_raw " + " End");
    let r8 = bd.render("adv_unclosed_raw", map("unclosed_raw", "should_not_crash"));
    file_delete(t8_view);

    assert_true(r8.contains("Start {!! unclosed_raw  End"), "Unclosed raw tag should not crash and preserve text");

    // 8. Adjacent tags
    let t9_view = "resources/views/adv_adj.bd.html";
    write_file(t9_view, "{{" + "a" + "}}" + "{{" + "b" + "}}" + "{{" + "c" + "}}");
    let r9 = bd.render("adv_adj", map("a", "1", "b", "2", "c", "3"));
    file_delete(t9_view);

    assert_true(r9.contains("123"), "Adjacent tags should concatenate properly");

    // 9. Data injection defense (single-pass verification)
    // If data value itself contains {{ injected }}, it must NOT be evaluated!
    let t10_view = "resources/views/adv_inject.bd.html";
    write_file(t10_view, "User: " + "{{" + "input" + "}}");
    let r10 = bd.render("adv_inject", map("input", "{{ secret }}", "secret", "LEAKED"));
    file_delete(t10_view);

    assert_true(r10.contains("User: {{ secret }}"), "Single-pass scanner must not evaluate injected template tags in data values");

    println("  [PASS] All 9 adversarial edge case categories passed successfully!");
}

fn test_loop_with_models() {
    let bd = new BD();
    let posts = list(
        new Post(map("id", 1, "title", "Post One")),
        new Post(map("id", 2, "title", "Post Two"))
    );

    let t_view = "resources/views/adv_loop.bd.html";
    let template = "@foreach(posts as post)\n" +
                   "<div>" + "{{" + "post.id" + "}}" + ": " + "{{" + "post.title" + "}}" + "</div>\n" +
                   "@endforeach";
    write_file(t_view, template);
    let result = bd.render("adv_loop", map("posts", posts));
    file_delete(t_view);

    assert_true(result.contains("<div>1: Post One</div>"), "Loop item 1 model should resolve");
    assert_true(result.contains("<div>2: Post Two</div>"), "Loop item 2 model should resolve");
    println("  [PASS] Active Record Model loop iteration passed successfully!");
}

fn test_unquoted_section_resolution() {
    let bd = new BD();
    let t_view = "resources/views/adv_sec.bd.html";
    let template = "@extends('layouts/app')\n" +
                   "@section('title', post.title)\n" +
                   "@section('content')\n" +
                   "<p>Content for " + "{{" + "post.title" + "}}" + "</p>\n" +
                   "@endsection";
    write_file(t_view, template);
    let rendered = bd.render("adv_sec", map("post", map("title", "Evaluated Title"), "is_auth", false));
    file_delete(t_view);

    assert_true(rendered.contains("<title>Evaluated Title</title>"), "Unquoted section argument should resolve in layout title yield");
    assert_true(rendered.contains("<p>Content for Evaluated Title</p>"), "Content section with variable should evaluate");
    println("  [PASS] Unquoted section argument resolution passed successfully!");
}

fn main() {
    println("\n=== Running Adversarial Stress Tests for SpiderBD ===");
    test_edge_cases_and_adversarial_inputs();
    test_loop_with_models();
    test_unquoted_section_resolution();
    println("=== All Adversarial Stress Tests Passed! ===\n");
}
