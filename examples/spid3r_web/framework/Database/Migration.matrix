// framework/Database/Migration.matrix
// Spid3rWeb Transactional Database Migration Runner

import "DB";
import "Schema";

public class Migration {
    public let name;

    fn new(name: string = "") {
        self.name = name;
    }

    public fn up(self) {}
    public fn down(self) {}
}

public class MigrationRunner {
    fn new() {
        self.ensure_migrations_table();
    }

    fn ensure_migrations_table(self) {
        DB.statement("CREATE TABLE IF NOT EXISTS migrations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            migration TEXT NOT NULL UNIQUE,
            batch INTEGER NOT NULL,
            applied_at TEXT NOT NULL
        );");
    }

    public fn get_applied(self) {
        let rows = DB.select("SELECT migration, batch FROM migrations ORDER BY id ASC");
        let applied_map = {};
        for r in rows {
            applied_map[string(r["migration"])] = int(r["batch"]);
        }
        return applied_map;
    }

    public fn get_next_batch(self) -> int {
        let rows = DB.select("SELECT max(batch) as max_b FROM migrations");
        if rows.len() > 0 and rows[0]["max_b"] != null {
            let val = rows[0]["max_b"];
            let t = type_of(val);
            if t == "int" {
                return int(val) + 1;
            }
            if t == "string" and val != "" {
                return int(val) + 1;
            }
        }
        return 1;
    }

    public fn migrate(self, migrations_list) {
        let applied = self.get_applied();
        let next_batch = self.get_next_batch();
        let ran_count = 0;

        for m in migrations_list {
            let m_name = m.name;
            if not applied.has(m_name) {
                println("[Migrate] Running: {m_name}");
                m.up();
                let now = string(unix_time());
                DB.statement("INSERT INTO migrations (migration, batch, applied_at) VALUES (?, ?, ?)", [m_name, next_batch, now]);
                println("[Migrate] Done:    {m_name}");
                ran_count = ran_count + 1;
            }
        }

        if ran_count == 0 {
            println("[Migrate] Nothing to migrate. Database is up to date.");
        }
        return ran_count;
    }

    public fn rollback(self, migrations_list) {
        let rows = DB.select("SELECT max(batch) as max_b FROM migrations");
        if rows.len() == 0 or rows[0]["max_b"] == null {
            println("[Rollback] Nothing to rollback.");
            return 0;
        }
        let val = rows[0]["max_b"];
        if type_of(val) == "bytes" or val == null {
            println("[Rollback] Nothing to rollback.");
            return 0;
        }
        let last_batch = int(val);
        let batch_rows = DB.select("SELECT migration FROM migrations WHERE batch = ? ORDER BY id DESC", [last_batch]);

        let rolled_count = 0;
        for r in batch_rows {
            let target_name = string(r["migration"]);
            for m in migrations_list {
                if m.name == target_name {
                    println("[Rollback] Rolling back: {m.name}");
                    m.down();
                    DB.statement("DELETE FROM migrations WHERE migration = ?", [m.name]);
                    println("[Rollback] Reverted:     {m.name}");
                    rolled_count = rolled_count + 1;
                }
            }
        }
        return rolled_count;
    }

    public fn status(self, migrations_list) {
        let applied = self.get_applied();
        println("\n+------------------------------------------------+-------+");
        println("| Migration                                      | Ran?  |");
        println("+------------------------------------------------+-------+");

        for m in migrations_list {
            let status = "No";
            if applied.has(m.name) {
                let batch_num = applied[m.name];
                status = "Yes ({batch_num})";
            }
            let name_padded = m.name;
            while name_padded.len() < 46 {
                name_padded = name_padded + " ";
            }
            println("| {name_padded} | {status}   |");
        }
        println("+------------------------------------------------+-------+\n");
    }
}
