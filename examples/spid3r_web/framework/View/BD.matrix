// framework/View/BD.matrix
// SpiderBD Template Engine: Layouts, Sections, Yielding, Partials, and Directives (.bd.html)

import "framework/Response";

public fn html_escape(value) -> string {
    if value == null {
        return "";
    }
    return string(value)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace("\"", "&quot;")
        .replace("'", "&#039;");
}

public class BD {
    public let views_path;

    fn new(views_path: string = "resources/views") {
        self.views_path = views_path;
    }

    public fn render(self, view_name: string, data = null) -> string {
        if data == null {
            data = map();
        }
        let file_path = self.resolve_view_path(view_name);
        let res = read_file(file_path);
        if res.is_err() {
            return "<!-- BD Error: View '" + view_name + "' not found at '" + file_path + "' -->";
        }
        let template = res.unwrap();

        // 1. Check for layout extension (@extends('...'))
        let layout_name = "";
        let trimmed_first_lines = template.split("\n");
        for line in trimmed_first_lines {
            let s = line.trim();
            if s.starts_with("@extends(") and s.ends_with(")") {
                layout_name = self.extract_quoted_arg(s, "@extends(");
                break;
            }
        }

        // 2. Parse sections from the view
        let sections = self.parse_sections(template);

        // 3. If view extends a layout, load the layout template
        let output = "";
        if layout_name != "" {
            let layout_file = self.resolve_view_path(layout_name);
            let layout_res = read_file(layout_file);
            if layout_res.is_ok() {
                output = layout_res.unwrap();
                // Replace @yield('section_name') with section content
                output = self.apply_yields(output, sections);
            } else {
                output = template; // fallback
            }
        } else {
            output = template;
        }

        // 4. Handle @include('...') partials
        output = self.apply_includes(output);

        // 5. Evaluate Directives: @if, @foreach, and Variable Interpolation
        output = self.evaluate_conditionals(output, data);
        output = self.evaluate_loops(output, data);
        output = self.evaluate_variables(output, data);

        return output;
    }

    fn resolve_view_path(self, view_name: string) -> string {
        let clean = view_name.replace(".", "/");
        let candidates = list(
            self.views_path + "/" + clean + ".bd.html",
            self.views_path + "/" + clean + ".html",
            "resources/views/" + clean + ".bd.html",
            "resources/views/" + clean + ".html",
            "examples/spid3r_web/resources/views/" + clean + ".bd.html",
            "examples/spid3r_web/resources/views/" + clean + ".html"
        );
        for p in candidates {
            if file_exists(p) {
                return p;
            }
        }
        return self.views_path + "/" + clean + ".bd.html";
    }

    fn extract_quoted_arg(self, line: string, prefix: string) -> string {
        let inner = line.replace(prefix, "");
        if inner.ends_with(")") {
            inner = inner.slice(0, inner.len() - 1);
        }
        inner = inner.trim();
        if (inner.starts_with("'") and inner.ends_with("'")) or (inner.starts_with("\"") and inner.ends_with("\"")) {
            return inner.slice(1, inner.len() - 1);
        }
        return inner;
    }

    fn parse_sections(self, template: string) {
        let sections = map();
        let lines = template.split("\n");
        let current_section = "";
        let current_content = list();
        let in_section = false;

        for raw_line in lines {
            let line = raw_line.trim();

            // Simple 1-line section: @section('title', 'My Page') or @section('title', post.title)
            if line.starts_with("@section(") and line.contains(",") and line.ends_with(")") {
                let inner = line.slice(9, line.len() - 1).trim();
                let comma_idx = inner.index_of(",");
                if comma_idx > 0 {
                    let sec_name = inner.slice(0, comma_idx).trim().replace("'", "").replace("\"", "");
                    let raw_val = inner.slice(comma_idx + 1, inner.len()).trim();
                    let sec_val = raw_val;
                    if (raw_val.starts_with("'") and raw_val.ends_with("'")) or (raw_val.starts_with("\"") and raw_val.ends_with("\"")) {
                        sec_val = raw_val.slice(1, raw_val.len() - 1);
                    } else {
                        // Unquoted expression (e.g. post.title): wrap in {{ ... }} so layout @yield renders the evaluated title
                        sec_val = "{{" + raw_val + "}}";
                    }
                    sections[sec_name] = sec_val;
                }
                continue;
            }

            // Block section: @section('content')
            if line.starts_with("@section(") and line.ends_with(")") {
                current_section = self.extract_quoted_arg(line, "@section(");
                current_content = list();
                in_section = true;
                continue;
            }

            if in_section and (line == "@endsection" or line == "@stop") {
                sections[current_section] = current_content.join("\n");
                in_section = false;
                current_section = "";
                continue;
            }

            if in_section {
                current_content.push(raw_line);
            }
        }

        return sections;
    }

    fn apply_yields(self, layout: string, sections) -> string {
        let out_lines = list();
        let lines = layout.split("\n");

        for raw_line in lines {
            let line = raw_line;
            while line.contains("@yield(") {
                let start_idx = line.index_of("@yield(");
                let end_idx = line.index_of(")");
                if start_idx >= 0 and end_idx > start_idx {
                    let yield_call = line.slice(start_idx, end_idx + 1);
                    let inner = yield_call.replace("@yield(", "");
                    if inner.ends_with(")") {
                        inner = inner.slice(0, inner.len() - 1);
                    }
                    inner = inner.trim();
                    let replacement = "";
                    let comma_idx = inner.index_of(",");
                    if comma_idx > 0 {
                        let sec_name = inner.slice(0, comma_idx).trim().replace("'", "").replace("\"", "");
                        let def_raw = inner.slice(comma_idx + 1, inner.len()).trim();
                        let def_val = def_raw;
                        if (def_raw.starts_with("'") and def_raw.ends_with("'")) or (def_raw.starts_with("\"") and def_raw.ends_with("\"")) {
                            def_val = def_raw.slice(1, def_raw.len() - 1);
                        }
                        if sections.has(sec_name) {
                            replacement = sections[sec_name];
                        } else {
                            replacement = def_val;
                        }
                    } else {
                        let sec_name = inner.trim().replace("'", "").replace("\"", "");
                        if sections.has(sec_name) {
                            replacement = sections[sec_name];
                        }
                    }
                    line = line.replace(yield_call, replacement);
                } else {
                    break;
                }
            }
            out_lines.push(line);
        }

        return out_lines.join("\n");
    }

    fn apply_includes(self, template: string) -> string {
        let out_lines = list();
        let lines = template.split("\n");

        for raw_line in lines {
            let line = raw_line.trim();
            if line.starts_with("@include(") and line.ends_with(")") {
                let partial_name = self.extract_quoted_arg(line, "@include(");
                let p_file = self.resolve_view_path(partial_name);
                let p_res = read_file(p_file);
                if p_res.is_ok() {
                    out_lines.push(p_res.unwrap());
                } else {
                    out_lines.push("<!-- BD Include Error: " + partial_name + " -->");
                }
            } else {
                out_lines.push(raw_line);
            }
        }

        return out_lines.join("\n");
    }

    fn evaluate_conditionals(self, template: string, data) -> string {
        // Simple @if($condition) ... @else ... @endif evaluator
        let lines = template.split("\n");
        let result_lines = list();
        let skip_block = false;
        let in_conditional = false;
        let condition_met = false;

        for raw_line in lines {
            let line = raw_line.trim();

            if line.starts_with("@if(") and line.ends_with(")") {
                in_conditional = true;
                let cond_expr = self.extract_quoted_arg(line, "@if(");
                let var_name = cond_expr.replace("$", "").trim();

                let val = null;
                if data.has(var_name) {
                    val = data[var_name];
                }

                // Truthiness check
                let is_true = false;
                if val != null {
                    if type_of(val) == "bool" and val == true {
                        is_true = true;
                    } else if type_of(val) == "string" and val != "" and val != "0" and val != "false" {
                        is_true = true;
                    } else if type_of(val) == "int" and val > 0 {
                        is_true = true;
                    } else if type_of(val) == "list" and val.len() > 0 {
                        is_true = true;
                    } else if type_of(val) == "map" and val.len() > 0 {
                        is_true = true;
                    }
                }

                if is_true {
                    skip_block = false;
                    condition_met = true;
                } else {
                    skip_block = true;
                    condition_met = false;
                }
                continue;
            }

            if in_conditional and line == "@else" {
                if condition_met {
                    skip_block = true;
                } else {
                    skip_block = false;
                }
                continue;
            }

            if in_conditional and line == "@endif" {
                in_conditional = false;
                skip_block = false;
                condition_met = false;
                continue;
            }

            if not skip_block {
                result_lines.push(raw_line);
            }
        }

        return result_lines.join("\n");
    }

    fn evaluate_loops(self, template: string, data) -> string {
        // Supports @foreach($items as $item) ... @endforeach
        let lines = template.split("\n");
        let result_lines = list();
        let in_loop = false;
        let loop_list_name = "";
        let loop_item_name = "";
        let loop_body_lines = list();

        for raw_line in lines {
            let line = raw_line.trim();

            if line.starts_with("@foreach(") and line.ends_with(")") {
                in_loop = true;
                let expr = line.replace("@foreach(", "");
                expr = expr.slice(0, expr.len() - 1).trim(); // "$items as $item"
                let parts = expr.split(" as ");
                if parts.len() == 2 {
                    loop_list_name = parts[0].trim();
                    loop_item_name = parts[1].trim();
                    if loop_item_name.starts_with("$") {
                        loop_item_name = loop_item_name.slice(1, loop_item_name.len()).trim();
                    }
                }
                loop_body_lines = list();
                continue;
            }

            if in_loop and line == "@endforeach" {
                in_loop = false;
                // Render loop items
                let items = self.resolve_expression(loop_list_name, data);
                if items != null and type_of(items) == "list" {
                    for item in items {
                        let item_data = map();
                        // copy parent scope
                        for k in data.keys() {
                            item_data[k] = data[k];
                        }
                        item_data[loop_item_name] = item;

                        let rendered_body = self.render_loop_iteration(loop_body_lines, item_data, loop_item_name);
                        result_lines.push(rendered_body);
                    }
                }
                loop_body_lines = list();
                continue;
            }

            if in_loop {
                loop_body_lines.push(raw_line);
            } else {
                result_lines.push(raw_line);
            }
        }

        return result_lines.join("\n");
    }

    fn render_loop_iteration(self, body_lines, data, item_var_name: string) -> string {
        let block = body_lines.join("\n");
        return self.evaluate_variables(block, data);
    }

    fn resolve_expression(self, raw_expr: string, data) {
        let expr = raw_expr.trim();
        if expr.starts_with("$") {
            expr = expr.slice(1, expr.len()).trim();
        }
        if expr == "" {
            return null;
        }
        return self.resolve_dot_path(expr, data);
    }

    fn resolve_dot_path(self, path: string, data) {
        if path == "" or data == null {
            return null;
        }

        // Fast-path: if type_of(data) == "map" and data.has(path), return data[path]
        if type_of(data) == "map" and data.has(path) {
            return data[path];
        }

        let parts = path.split(".");
        let first = parts[0].trim();
        if type_of(data) != "map" or not data.has(first) {
            return null;
        }

        let curr = data[first];
        let i = 1;
        while i < parts.len() {
            let seg = parts[i].trim();
            if curr == null {
                return null;
            }
            curr = self.resolve_property(curr, seg);
            i = i + 1;
        }

        return curr;
    }

    fn resolve_property(self, obj, prop: string) {
        if obj == null {
            return null;
        }

        let t = type_of(obj);

        // 1. Spid3r Map
        if t == "map" {
            if obj.has(prop) {
                return obj[prop];
            }
            return null;
        }

        // 2. Class Instance (Active Record Model or Domain Object)
        if t == "instance" {
            // Check Active Record Model attributes map
            try {
                let attrs = obj.attributes;
                if attrs != null and type_of(attrs) == "map" {
                    if attrs.has(prop) {
                        return attrs[prop];
                    }
                }
            } catch (_e1) {}

            // Check obj.get(prop) method on Model
            try {
                let val = obj.get(prop);
                if val != null {
                    return val;
                }
            } catch (_e2) {}

            // Check Active Record relation methods (e.g. post.author(), user.posts())
            if prop == "author" {
                try {
                    let rel = obj.author();
                    if rel != null {
                        return rel;
                    }
                } catch (_e3) {}
            }
            if prop == "posts" {
                try {
                    let rel = obj.posts();
                    if rel != null {
                        return rel;
                    }
                } catch (_e4) {}
            }

            return null;
        }

        // 3. List (numeric indexing: items.0.title)
        if t == "list" {
            try {
                let idx = int(prop);
                if idx >= 0 and idx < obj.len() {
                    return obj[idx];
                }
            } catch (_e5) {}
            return null;
        }

        return null;
    }

    fn evaluate_variables(self, text: string, data) -> string {
        let result = "";
        let remaining = text;

        while true {
            let raw_idx = remaining.index_of("{!!");
            let esc_idx = remaining.index_of("{{");

            // No more tags to process
            if raw_idx < 0 and esc_idx < 0 {
                result = result + remaining;
                break;
            }

            // Determine which tag delimiter appears first
            let is_raw = false;
            let start_idx = -1;
            let open_len = 0;
            let close_tag = "";

            if raw_idx >= 0 and (esc_idx < 0 or raw_idx < esc_idx) {
                is_raw = true;
                start_idx = raw_idx;
                open_len = 3; // "{!!".len()
                close_tag = "!!}";
            } else {
                is_raw = false;
                start_idx = esc_idx;
                open_len = 2; // "{{".len()
                close_tag = "}}";
            }

            // Emit plain template text preceding the tag
            result = result + remaining.slice(0, start_idx);
            let after_open = remaining.slice(start_idx + open_len, remaining.len());

            let end_idx = after_open.index_of(close_tag);
            if end_idx < 0 {
                // Malformed tag without closing delimiter: emit verbatim and terminate
                let open_str = "{{";
                if is_raw {
                    open_str = "{!!";
                }
                result = result + open_str + after_open;
                break;
            }

            // Extract expression and trim surrounding whitespace (guarantees whitespace tolerance)
            let expr = after_open.slice(0, end_idx).trim();
            remaining = after_open.slice(end_idx + close_tag.len(), after_open.len());

            let val = self.resolve_expression(expr, data);
            let s_val = "";
            if val != null {
                s_val = string(val);
            }

            if is_raw {
                result = result + s_val;
            } else {
                result = result + html_escape(s_val);
            }
        }

        return result;
    }
}

// Global Singleton View Renderer
public let global_bd = new BD();

public fn view(view_name: string, data = null) {
    if data == null {
        data = map();
    }
    let rendered = global_bd.render(view_name, data);
    let res = response(rendered, 200);
    res.header("content-type", "text/html; charset=utf-8");
    return res;
}

public fn bd_view(view_name: string, data = null) {
    return view(view_name, data);
}
