// framework/Application.matrix
// Spid3rWeb Application Kernel & HTTP Request Coordinator

import "http";
import "framework/Request";
import "framework/Response";
import "framework/Router";
import "framework/Middleware";
import "framework/Auth/Auth";

public class Application {
    public let router;
    public let global_middleware;
    public let base_path;
    public let name;
    public let env;
    public let debug;

    fn new(base_path: string = ".") {
        self.base_path = base_path;
        self.router = Route;
        self.global_middleware = list(
            new CorsMiddleware()
        );
        self.name = "Spid3rWeb";
        self.env = "local";
        self.debug = true;
    }

    public fn use(self, mw) {
        self.global_middleware.push(mw);
        return self;
    }

    // ------------------------------------------------------------------------
    // Static Asset Delivery
    // ------------------------------------------------------------------------
    fn try_serve_static(self, path: string) {
        let clean = path;
        if clean.starts_with("/") {
            clean = clean.slice(1, clean.len());
        }

        let candidates = list(
            "public/" + clean,
            "examples/spid3r_web/public/" + clean,
            clean
        );

        for p in candidates {
            if file_exists(p) {
                let res = read_file(p);
                if res.is_ok() {
                    let content_type = "text/plain";
                    if p.ends_with(".css") { content_type = "text/css; charset=utf-8"; }
                    elif p.ends_with(".js") { content_type = "application/javascript; charset=utf-8"; }
                    elif p.ends_with(".html") { content_type = "text/html; charset=utf-8"; }
                    elif p.ends_with(".png") { content_type = "image/png"; }
                    elif p.ends_with(".svg") { content_type = "image/svg+xml"; }

                    let resp = response(res.unwrap(), 200);
                    resp.header("content-type", content_type);
                    resp.header("cache-control", "no-cache");
                    return resp;
                }
            }
        }
        return null;
    }

    // ------------------------------------------------------------------------
    // HTTP Request Handler
    // ------------------------------------------------------------------------
    public fn handle_request(self, raw_req) {
        Auth.clear();
        let req = new Request(raw_req);
        if req.session_id != "" {
            Auth.authenticate_token(req.session_id);
        }

        // 1. Static file check (e.g. /css/app.css, /js/app.js)
        if req.method == "GET" and (req.path.starts_with("/css/") or req.path.starts_with("/js/") or req.path.starts_with("/assets/")) {
            let static_res = self.try_serve_static(req.path);
            if static_res != null {
                return static_res.to_http();
            }
        }

        // 2. Global Pipeline (CORS, Logging)
        let pipeline = new Pipeline();
        pipeline.send(req).through(self.global_middleware);

        let match_result = self.router.match_route(req.method, req.path);

        if match_result == null {
            // Check if static root (e.g. /favicon.ico)
            if req.path == "/favicon.ico" {
                return http_response(204, map("content-type", "image/x-icon"), "");
            }
            return self.render_404(req);
        }

        let route_entry = match_result["route"];
        req.params = match_result["params"];

        // 3. Route-specific Middleware Pipeline
        let route_pipeline = new Pipeline();
        let mw_instances = self.resolve_middleware(route_entry.middleware_list);
        route_pipeline.send(req).through(mw_instances);

        let final_response = route_pipeline.then(fn(r) {
            try {
                return self.router.dispatch(route_entry.handler, r);
            } catch (e) {
                return self.render_500(r, e);
            }
        });

        if final_response == null {
            return http_response(200, map("content-type", "text/plain"), "");
        }

        // Convert Response object to raw HTTP response
        if type_of(final_response) == "map" and final_response.has("status") and final_response.has("headers") {
            return final_response;
        }

        return final_response.to_http();
    }

    fn resolve_middleware(self, mw_names) {
        let resolved = list();
        for name in mw_names {
            if name == "auth" {
                resolved.push(new AuthMiddleware());
            } elif name == "cors" {
                resolved.push(new CorsMiddleware());
            } elif name == "logger" {
                resolved.push(new LoggerMiddleware());
            }
        }
        return resolved;
    }

    fn render_404(self, req) {
        if req.path.starts_with("/api/") {
            return json(map("error", "Not Found", "message", "The requested endpoint was not found."), 404).to_http();
        }
        let html_content = "<!DOCTYPE html>
<html lang='en'>
<head><meta charset='utf-8'><title>404 Not Found - Spid3rWeb</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #f8fafc; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
  .card { background: #1e293b; padding: 2.5rem 3rem; border-radius: 1rem; border: 1px solid #334155; text-align: center; max-width: 500px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); }
  h1 { font-size: 4rem; margin: 0; color: #38bdf8; font-weight: 800; }
  p { color: #94a3b8; font-size: 1.1rem; margin: 1rem 0 2rem; }
  a { background: #38bdf8; color: #0f172a; text-decoration: none; padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-weight: 600; }
</style>
</head>
<body>
  <div class='card'>
    <h1>404</h1>
    <h2>Route Not Found</h2>
    <p>No route defined matching <code>" + req.method + " " + req.path + "</code></p>
    <a href='/'>Return to Home</a>
  </div>
</body>
</html>";
        return html(html_content, 404).to_http();
    }

    fn render_500(self, req, exception) {
        if req.path.starts_with("/api/") {
            return json(map("error", "Internal Server Error", "exception", string(exception)), 500).to_http();
        }
        let html_content = "<!DOCTYPE html>
<html lang='en'>
<head><meta charset='utf-8'><title>500 Error - Spid3rWeb</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0b0f17; color: #f1f5f9; padding: 3rem; }
  .box { background: #1e293b; border-left: 6px solid #ef4444; border-radius: 8px; padding: 2rem; }
  h1 { color: #ef4444; font-size: 1.8rem; margin: 0 0 1rem; }
  pre { background: #0f172a; padding: 1.5rem; border-radius: 6px; overflow-x: auto; color: #fca5a5; font-family: monospace; }
</style>
</head>
<body>
  <div class='box'>
    <h1>âš ï¸ Spid3rWeb Unhandled Exception</h1>
    <p><strong>Route:</strong> <code>" + req.method + " " + req.path + "</code></p>
    <pre>" + string(exception) + "</pre>
  </div>
</body>
</html>";
        return html(html_content, 500).to_http();
    }

    public fn listen(self, port: int = 8000) {
        let r = tcp_listen("127.0.0.1:" + string(port));
        if r.is_err() {
            throw r.unwrap_err();
        }
        let listener = r.unwrap();
        let real_addr = tcp_local_addr(listener).unwrap();
        let app = self;
        let opts = map("access_log", false);
        println("[Spid3rWeb] Development server running on http://" + real_addr);
        println("[Spid3rWeb] Press Ctrl+C to stop the server\n");

        let _count = serve_listener(listener, fn(raw_req) {
            return app.handle_request(raw_req);
        }, opts, -1);
    }
}

