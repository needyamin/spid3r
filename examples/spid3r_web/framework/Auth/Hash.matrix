// framework/Auth/Hash.matrix
// Spid3rWeb Password Hashing Facade using Spid3r Stdlib Bcrypt

public class HashManager {
    fn new() {}

    public fn make(self, plain_text: string) -> string {
        return bcrypt_hash(plain_text);
    }

    public fn check(self, plain_text: string, hashed: string) -> bool {
        try {
            return bcrypt_verify(plain_text, hashed);
        } catch (_e) {
            return false;
        }
    }
}

public let Hash = new HashManager();
