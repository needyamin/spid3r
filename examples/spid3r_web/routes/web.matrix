// routes/web.matrix
// Spid3rWeb Web Application Route Registrations

import "framework/Router";
import "app/Controllers/HomeController";
import "app/Controllers/AuthController";
import "app/Controllers/PostController";

let home_ctrl = new HomeController();
let auth_ctrl = new AuthController();
let post_ctrl = new PostController();

public fn register_web_routes() {
    // Landing & Feed
    Route.get("/", fn(req) { return home_ctrl.index(req); }).name("home");

    // Articles & Publishing
    Route.get("/posts", fn(req) { return post_ctrl.index(req); }).name("posts.index");
    Route.get("/posts/create", fn(req) { return post_ctrl.create(req); }).middleware("auth").name("posts.create");
    Route.post("/posts", fn(req) { return post_ctrl.store(req); }).middleware("auth").name("posts.store");
    Route.get("/posts/:id", fn(req) { return post_ctrl.show(req); }).name("posts.show");
    Route.get("/posts/:id/edit", fn(req) { return post_ctrl.edit(req); }).middleware("auth").name("posts.edit");
    Route.post("/posts/:id/update", fn(req) { return post_ctrl.update(req); }).middleware("auth").name("posts.update");
    Route.post("/posts/:id/delete", fn(req) { return post_ctrl.destroy(req); }).middleware("auth").name("posts.destroy");

    // User Authentication
    Route.get("/login", fn(req) { return auth_ctrl.showLogin(req); }).name("login");
    Route.post("/login", fn(req) { return auth_ctrl.login(req); }).name("login.submit");
    Route.get("/register", fn(req) { return auth_ctrl.showRegister(req); }).name("register");
    Route.post("/register", fn(req) { return auth_ctrl.register(req); }).name("register.submit");
    Route.post("/logout", fn(req) { return auth_ctrl.logout(req); }).name("logout");
}
