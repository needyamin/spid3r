// routes/api.matrix
// Spid3rWeb JSON REST API Routes

import "framework/Router";
import "framework/Response";
import "app/Controllers/AuthController";
import "app/Controllers/PostController";

let api_auth = new AuthController();
let api_posts = new PostController();

public fn register_api_routes() {
    Route.group(map("prefix", "/api/v1"), fn() {
        // Public API
        Route.get("/status", fn(_req) {
            return json(map(
                "status", "healthy",
                "framework", "Spid3rWeb",
                "version", "1.0.0",
                "timestamp", unix_time()
            ));
        });

        Route.post("/login", fn(req) { return api_auth.login(req); });
        Route.post("/register", fn(req) { return api_auth.register(req); });

        Route.get("/posts", fn(req) { return api_posts.apiIndex(req); });
        Route.get("/posts/:id", fn(req) { return api_posts.apiShow(req); });

        // Authenticated API
        Route.post("/posts", fn(req) { return api_posts.apiStore(req); }).middleware("auth");
    });
}
