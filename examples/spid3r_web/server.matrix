// server.matrix
// Spid3rWeb Production & Development HTTP Application Server

import "framework/Application";
import "routes/web";
import "routes/api";

fn main() {
    println("==================================================================");
    println("                  Spid3rWeb Application Server                   ");
    println("==================================================================");

    // 1. Initialize Application Kernel
    let app = new Application();

    // 2. Register Web and API Routes
    register_web_routes();
    register_api_routes();

    // 3. Port Configuration (default 8000)
    let port = 8000;
    let cli_args = args();
    if cli_args.len() > 0 {
        let p_val = int(cli_args[0]);
        if p_val > 0 {
            port = p_val;
        }
    }

    // 4. Start HTTP Server
    app.listen(port);
}
