// tests/test_model.matrix
// Unit tests for Spid3rWeb Active Record Models

import "app/Models/User";
import "app/Models/Post";
import "framework/Database/DB";

fn test_user_post_models() {
    let now = string(unix_time());

    // 1. Create User
    let user = UserModel.create(map(
        "name", "Linus Torvalds",
        "email", "linus_" + now + "@kernel.org",
        "password", "secret_git"
    ));
    assert(user != null, "User should be created");
    assert(user.get("id") != null, "User should have id");
    let uid = int(user.get("id"));

    // 2. Find User
    let found_user = UserModel.find(uid);
    assert(found_user != null, "UserModel.find should return user");
    assert(found_user.get("name") == "Linus Torvalds", "User name should match");

    // 3. Create Post
    let post = PostModel.create(map(
        "title", "Git: Fast Version Control",
        "slug", "git-fast-vcs-" + now,
        "content", "Git was designed for high performance and reliability.",
        "category", "Tools",
        "user_id", uid,
        "status", "published",
        "views_count", 100
    ));
    assert(post != null, "Post should be created");
    let pid = int(post.get("id"));

    // 4. Test Relationships
    let user_posts = user.posts();
    assert(user_posts.len() > 0, "User should have at least 1 post");
    assert(user_posts[0]["title"] == "Git: Fast Version Control", "Post title should match");

    let author = post.author();
    assert(author != null, "Post author should be resolved");
    assert(author["name"] == "Linus Torvalds", "Author name should match");

    // 5. Update Post
    post.update(map("title", "Git: Distributed Version Control"));
    let reloaded_post = PostModel.find(pid);
    assert(reloaded_post.get("title") == "Git: Distributed Version Control", "Updated title should match");

    // 6. Clean up
    post.delete();
    user.delete();

    assert(PostModel.find(pid) == null, "Post should be deleted");
    assert(UserModel.find(uid) == null, "User should be deleted");
    println("  [PASS] test_user_post_models");
}

fn test_modern_static_and_inheritance() {
    let now = string(unix_time());

    // 1. Test direct static method User.create and class inheritance
    let email = "ada_" + now + "@lovelace.org";
    let user = User.create({
        "name": "Ada Lovelace",
        "email": email,
        "password": "analytical_engine"
    });
    assert(user != null, "User.create should succeed");
    assert(user.get("name") == "Ada Lovelace", "user.get should work via Model inheritance");
    assert(user.model != null, "user.model property must exist for backward compatibility");
    let uid = int(user.get("id"));

    // 2. Test direct static method User.find & User.findByEmail
    let found = User.find(uid);
    assert(found != null, "User.find should locate user");
    assert(found.get("name") == "Ada Lovelace", "Found user name should match");

    let found_by_email = User.findByEmail(email);
    assert(found_by_email != null, "User.findByEmail should locate user");
    assert(int(found_by_email.get("id")) == uid, "Found by email ID should match");

    // 3. Test direct static method Post.create and Post.findBySlug
    let slug = "first-algorithm-" + now;
    let post = Post.create({
        "title": "Note G: The First Algorithm",
        "slug": slug,
        "content": "Algorithm for calculating Bernoulli numbers.",
        "category": "History",
        "user_id": uid,
        "status": "published",
        "views_count": 42
    });
    assert(post != null, "Post.create should succeed");
    let pid = int(post.get("id"));

    let found_slug = Post.findBySlug(slug);
    assert(found_slug != null, "Post.findBySlug should locate post");
    assert(found_slug.get("title") == "Note G: The First Algorithm", "Post title should match");

    // 4. Test Post.published() and Post.all()
    let pub_posts = Post.published();
    assert(pub_posts.len() > 0, "Post.published should return at least 1 post");

    let all_posts = Post.all();
    assert(all_posts.len() > 0, "Post.all should return at least 1 post");

    // 5. Test User.all()
    let all_users = User.all();
    assert(all_users.len() > 0, "User.all should return at least 1 user");

    // 6. Test Model to_map()
    let post_map = post.to_map();
    assert(post_map.has("title"), "to_map should contain title");
    assert(post_map["slug"] == slug, "to_map slug should match");

    // Teardown
    post.delete();
    user.delete();
    assert(User.find(uid) == null, "User should be deleted");
    assert(Post.find(pid) == null, "Post should be deleted");
    println("  [PASS] test_modern_static_and_inheritance");
}

fn main() {
    println("\n=== Running Model Test Suite ===");
    test_user_post_models();
    test_modern_static_and_inheritance();
    DB.close();
    println("=== All Model Tests Passed! ===\n");
    return 0;
}
