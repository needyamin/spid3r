// tests/run_all.matrix
// Spid3rWeb Complete Test Suite Runner

fn resolve_spid3r_binary() -> string {
    let cur = exe_path();
    if cur.is_ok() {
        let p = cur.unwrap();
        if file_exists(p) {
            return p;
        }
    }

    let env_keys = list(
        "SPID3R_BIN",
        "SPID3R_EXE",
        "CARGO_BIN_EXE_spid3r",
        "CARGO_BIN_EXE_spidr"
    );
    for k in env_keys {
        let v = env(k);
        if v.is_some() {
            let p = v.unwrap();
            if file_exists(p) {
                return p;
            }
        }
    }

    let candidates = list(
        "target/debug/spid3r.exe",
        "target/debug/spid3r",
        "../../target/debug/spid3r.exe",
        "../../target/debug/spid3r",
        "target/release/spid3r.exe",
        "target/release/spid3r",
        "../../target/release/spid3r.exe",
        "../../target/release/spid3r"
    );
    for c in candidates {
        if file_exists(c) {
            return c;
        }
    }

    return "spid3r";
}

fn cleanup_artifacts() {
    let candidates = list(
        "database/database.sqlite-shm",
        "database/database.sqlite-wal",
        "examples/spid3r_web/database/database.sqlite-shm",
        "examples/spid3r_web/database/database.sqlite-wal"
    );
    for c in candidates {
        if file_exists(c) {
            file_delete(c);
        }
    }
}

fn run_test(path: string, spid3r_bin: string) -> bool {
    println("------------------------------------------------------------------");
    println("Running: " + path);
    println("------------------------------------------------------------------");

    let res = exec_capture(spid3r_bin, list("run", path), null);
    if res.is_ok() {
        let out = res.unwrap();
        print(out["stdout"]);
        if out["stderr"] != "" {
            print(out["stderr"]);
        }
        return out["code"] == 0;
    } else {
        println("[EXEC ERROR] " + res.unwrap_err());
        return false;
    }
}

fn main() {
    if file_exists("framework") {
        env_set("SPID3R_PATH", ".");
    } elif file_exists("examples/spid3r_web/framework") {
        env_set("SPID3R_PATH", "examples/spid3r_web");
    }

    let spid3r_bin = resolve_spid3r_binary();

    println("==================================================================");
    println("            Spid3rWeb Complete Test Suite Execution               ");
    println("==================================================================");

    let tests = list(
        "tests/test_router.matrix",
        "tests/test_validator.matrix",
        "tests/test_query_builder.matrix",
        "tests/test_model.matrix",
        "tests/test_bd.matrix",
        "tests/test_http_lifecycle.matrix"
    );

    let passed = 0;
    for t in tests {
        let p = t;
        let candidates = list(
            t,
            "examples/spid3r_web/" + t
        );
        for c in candidates {
            if file_exists(c) {
                p = c;
                break;
            }
        }
        if run_test(p, spid3r_bin) {
            passed = passed + 1;
        } else {
            println("[FAILED]: " + t);
        }
    }

    cleanup_artifacts();

    println("==================================================================");
    println("Test Summary: " + string(passed) + "/" + string(tests.len()) + " test suites passed.");
    println("==================================================================");
    if passed < tests.len() {
        return 1;
    }
    return 0;
}
