// tests/e2e/run_e2e.matrix
// Spid3rWeb Complete 4-Tier E2E Test Suite Orchestrator & Runner

fn get_spid3r_bin() -> string {
    let candidates = list(
        "target/release/spid3r.exe",
        "../../target/release/spid3r.exe",
        "target/debug/spid3r.exe",
        "../../target/debug/spid3r.exe",
        "target/release/spid3r",
        "../../target/release/spid3r",
        "spid3r"
    );
    for c in candidates {
        if file_exists(c) {
            return c;
        }
    }
    return "spid3r";
}

fn run_suite(spid3r_bin: string, suite_path: string) -> bool {
    println("------------------------------------------------------------------");
    println("Running Suite: " + suite_path);
    println("------------------------------------------------------------------");

    let resolved_path = suite_path;
    if not file_exists(resolved_path) and file_exists("examples/spid3r_web/" + suite_path) {
        resolved_path = "examples/spid3r_web/" + suite_path;
    }

    let res = exec_capture(spid3r_bin, list("run", resolved_path), null);
    if res.is_ok() {
        let out = res.unwrap();
        print(out["stdout"]);
        if out["stderr"] != "" {
            print(out["stderr"]);
        }
        return out["code"] == 0;
    } else {
        println("[EXEC ERROR]: " + res.unwrap_err());
        return false;
    }
}

fn main() {
    if file_exists("framework") {
        env_set("SPID3R_PATH", ".");
    } elif file_exists("examples/spid3r_web/framework") {
        env_set("SPID3R_PATH", "examples/spid3r_web");
    }

    let spid3r_bin = get_spid3r_bin();
    let start_all = unix_ms();

    println("==================================================================");
    println("        Spid3rWeb Complete 4-Tier E2E Test Suite Execution        ");
    println("==================================================================");
    println("Runtime: " + spid3r_bin);
    let current_dir = "";
    let cwd_res = cwd();
    if cwd_res.is_ok() {
        current_dir = cwd_res.unwrap();
    }
    println("Working Directory: " + current_dir);
    println("Time: " + string(unix_time()));
    println("==================================================================\n");

    let suites = list(
        map("tier", "Tier 1: Feature Coverage", "file", "tests/e2e/tier1_features_cli.matrix", "expected", 15),
        map("tier", "Tier 1: Feature Coverage", "file", "tests/e2e/tier1_features_orm.matrix", "expected", 15),
        map("tier", "Tier 1: Feature Coverage", "file", "tests/e2e/tier1_features_http.matrix", "expected", 25),
        map("tier", "Tier 1: Feature Coverage", "file", "tests/e2e/tier1_features_advanced.matrix", "expected", 30),
        map("tier", "Tier 2: Boundary & Corner Cases", "file", "tests/e2e/tier2_boundaries_part1.matrix", "expected", 45),
        map("tier", "Tier 2: Boundary & Corner Cases", "file", "tests/e2e/tier2_boundaries_part2.matrix", "expected", 40),
        map("tier", "Tier 3: Cross-Feature Interactions", "file", "tests/e2e/tier3_cross_feature.matrix", "expected", 17),
        map("tier", "Tier 4: Real-World Scenarios", "file", "tests/e2e/tier4_real_world.matrix", "expected", 5)
    );

    let passed_suites = 0;
    let failed_suites = 0;
    let suite_results = list();

    for s in suites {
        let ok = run_suite(spid3r_bin, s["file"]);
        if ok {
            passed_suites = passed_suites + 1;
            suite_results.push(map("file", s["file"], "status", "PASS", "tier", s["tier"], "count", s["expected"]));
        } else {
            failed_suites = failed_suites + 1;
            suite_results.push(map("file", s["file"], "status", "FAIL", "tier", s["tier"], "count", s["expected"]));
        }
    }

    let elapsed = unix_ms() - start_all;

    println("\n==================================================================");
    println("             Spid3rWeb 4-Tier E2E Execution Summary               ");
    println("==================================================================");
    println("+-------------------------------------------+---------+----------+");
    println("| Test Suite File                           | Status  | Tests    |");
    println("+-------------------------------------------+---------+----------+");

    let total_tests_count = 0;
    for r in suite_results {
        let f_padded = r["file"];
        while f_padded.len() < 41 {
            f_padded = f_padded + " ";
        }
        let stat_padded = r["status"] + "   ";
        let cnt = string(r["count"]);
        while cnt.len() < 8 {
            cnt = cnt + " ";
        }
        total_tests_count = total_tests_count + r["count"];
        println("| " + f_padded + " | " + stat_padded + " | " + cnt + " |");
    }

    println("+-------------------------------------------+---------+----------+");
    println("Total Tests Designed & Executed: " + string(total_tests_count));
    println("Suite Pass Rate: " + string(passed_suites) + "/" + string(suites.len()) + " suites passed");
    println("Total Elapsed Time: " + string(elapsed) + "ms");
    println("==================================================================\n");

    let cli_args = args();
    let strict_mode = false;
    for a in cli_args {
        if a == "--strict" {
            strict_mode = true;
        }
    }

    if strict_mode and failed_suites > 0 {
        return 1;
    }

    return 0;
}
