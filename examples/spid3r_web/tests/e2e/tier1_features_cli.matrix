// tests/e2e/tier1_features_cli.matrix
// Tier 1: Feature Coverage for CLI and Package Manifest (Features 1, 2, 3)

import "tests/e2e/test_helpers";
import "framework/Console/ConsoleKernel";
import "routes/web";
import "routes/api";

fn get_spid3r_bin() -> string {
    let candidates = list(
        "target/release/spid3r.exe",
        "../../target/release/spid3r.exe",
        "target/debug/spid3r.exe",
        "../../target/debug/spid3r.exe",
        "target/release/spid3r",
        "../../target/release/spid3r",
        "spid3r"
    );
    for c in candidates {
        if file_exists(c) {
            return c;
        }
    }
    return "spid3r";
}

fn create_kernel() -> ConsoleKernel {
    register_web_routes();
    register_api_routes();
    return new ConsoleKernel();
}

fn main() {
    println("\n==================================================================");
    println("  Tier 1: Feature Coverage - CLI & Package Manifest (F1, F2, F3) ");
    println("==================================================================");

    let runner = new TestRunner("Tier 1: CLI & Manifest");

    // ------------------------------------------------------------------------
    // Feature 1: Magic CLI Test Subcommand (PROJECT.md §Interface Contracts)
    // ------------------------------------------------------------------------

    runner.test("F1.1: Magic test subcommand execution", fn() {
        let kernel = create_kernel();
        let code = kernel.handle(list("test"));
        test_assert_eq(code, 0, "spid3r magic test should return exit code 0 on success");
    });

    runner.test("F1.2: Magic test CLI invocation via process", fn() {
        let spid3r_bin = get_spid3r_bin();
        let res = exec_capture(spid3r_bin, list("magic", "test"), null);
        test_assert(res.is_ok(), "Process execution of 'magic test' should succeed");
        let out = res.unwrap();
        test_assert_eq(out["code"], 0, "magic test process should exit with 0");
    });

    runner.test("F1.3: Magic help lists test subcommand", fn() {
        let spid3r_bin = get_spid3r_bin();
        let res = exec_capture(spid3r_bin, list("magic", "help"), null);
        test_assert(res.is_ok(), "Process execution of 'magic help' should succeed");
        let out = res.unwrap();
        test_assert_contains(out["stdout"], "test", "Help output should list test command");
    });

    runner.test("F1.4: Test runner script tests/run_all.matrix execution", fn() {
        let spid3r_bin = get_spid3r_bin();
        let res = exec_capture(spid3r_bin, list("run", "tests/run_all.matrix"), null);
        test_assert(res.is_ok(), "Executing tests/run_all.matrix should succeed");
        let out = res.unwrap();
        test_assert_eq(out["code"], 0, "tests/run_all.matrix should exit with 0");
        test_assert_contains(out["stdout"], "test suites passed", "Should report test suite summary");
    });

    runner.test("F1.5: Magic CLI binary path resolution fallback", fn() {
        let bin = get_spid3r_bin();
        test_assert(bin != "", "Spid3r binary should be resolvable");
        test_assert(not bin.ends_with(".exe.exe"), "Binary path should not have double extensions");
    });

    // ------------------------------------------------------------------------
    // Feature 2: Magic CLI Help & Route Listing
    // ------------------------------------------------------------------------

    runner.test("F2.1: Magic help header contract", fn() {
        let spid3r_bin = get_spid3r_bin();
        let res = exec_capture(spid3r_bin, list("magic", "help"), null);
        test_assert(res.is_ok(), "Executing 'magic help' should succeed");
        let out = res.unwrap();
        test_assert_contains(out["stdout"], "Spid3rWeb Magic CLI", "Header must match contract");
    });

    runner.test("F2.2: Magic route:list contains /api/v1/posts contract", fn() {
        let spid3r_bin = get_spid3r_bin();
        let res = exec_capture(spid3r_bin, list("magic", "route:list"), null);
        test_assert(res.is_ok(), "Executing 'magic route:list' should succeed");
        let out = res.unwrap();
        test_assert_contains(out["stdout"], "/api/v1/posts", "route:list must include /api/v1/posts");
    });

    runner.test("F2.3: Magic route:list table formatting", fn() {
        let spid3r_bin = get_spid3r_bin();
        let res = exec_capture(spid3r_bin, list("magic", "route:list"), null);
        test_assert(res.is_ok(), "Executing 'magic route:list' should succeed");
        let out = res.unwrap();
        test_assert_contains(out["stdout"], "Method", "Table header should include Method");
        test_assert_contains(out["stdout"], "URI", "Table header should include URI");
        test_assert_contains(out["stdout"], "Action", "Table header should include Action");
    });

    runner.test("F2.4: Magic CLI empty arguments defaults to help", fn() {
        let kernel = create_kernel();
        let code = kernel.handle(list());
        test_assert_eq(code, 0, "No arguments should show help and return 0");
    });

    runner.test("F2.5: Magic CLI unknown subcommand reports error and returns 1", fn() {
        let kernel = create_kernel();
        let code = kernel.handle(list("unknown:subcommand:xyz"));
        test_assert_eq(code, 1, "Unknown command should return exit code 1");
    });

    // ------------------------------------------------------------------------
    // Feature 3: Package Manifest Toolchain
    // ------------------------------------------------------------------------

    runner.test("F3.1: Package manifest exists and readable", fn() {
        test_assert(file_exists("spider.toml"), "spider.toml manifest should exist");
        let content_res = read_file("spider.toml");
        test_assert(content_res.is_ok(), "spider.toml should be readable");
    });

    runner.test("F3.2: Package manifest name and entry point", fn() {
        let content = read_file("spider.toml").unwrap();
        test_assert_contains(content, "name = \"spid3r_web\"", "Package name must be spid3r_web");
        test_assert_contains(content, "entry = \"server.matrix\"", "Entry point must be server.matrix");
    });

    runner.test("F3.3: Package manifest semver version", fn() {
        let content = read_file("spider.toml").unwrap();
        test_assert_contains(content, "version = \"1.0.0\"", "Version should be 1.0.0");
    });

    runner.test("F3.4: Package manifest dependencies table", fn() {
        let content = read_file("spider.toml").unwrap();
        test_assert_contains(content, "[dependencies]", "Should declare [dependencies] section");
    });

    runner.test("F3.5: Package manifest conforms to spid3r test requirements", fn() {
        let content = read_file("spider.toml").unwrap();
        // Manifest must not contain unsupported 'description' in [package] section
        test_assert(not content.contains("description ="), "spider.toml [package] must not contain unsupported 'description' key");
    });

    let success = runner.summary();
    if not success {
        return 1;
    }
    return 0;
}
