// tests/e2e/tier2_boundaries_part1.matrix
// Tier 2: Boundary & Corner Cases for Features 1 through 9 (45 tests)

import "tests/e2e/test_helpers";
import "framework/Console/ConsoleKernel";
import "framework/Router";
import "framework/Request";
import "framework/Response";
import "framework/Application";
import "framework/Middleware";
import "framework/Database/DB";
import "framework/Database/Schema";
import "framework/Database/Migration";
import "app/Models/User";
import "app/Models/Post";

fn unique_suffix() -> string {
    return string(unix_ms()) + "_" + string(random_int(1000, 9999));
}

fn main() {
    println("\n==================================================================");
    println("  Tier 2: Boundary & Corner Cases - Features 1 to 9 (45 tests)    ");
    println("==================================================================");

    let runner = new TestRunner("Tier 2: Boundaries (Part 1)");

    // ------------------------------------------------------------------------
    // Feature 1: Magic CLI Test Subcommand Boundaries
    // ------------------------------------------------------------------------

    runner.test("B1.1: CLI test with unknown flag reports error or usage", fn() {
        let kernel = new ConsoleKernel();
        let code = kernel.handle(list("test", "--non-existent-flag-xyz"));
        // Either passes through or handles unknown flags cleanly
        test_assert(code == 0 or code == 1, "Exit code should be 0 or 1");
    });

    runner.test("B1.2: CLI test with empty string argument", fn() {
        let kernel = new ConsoleKernel();
        let code = kernel.handle(list("test", ""));
        test_assert(code == 0 or code == 1, "Exit code should be valid integer");
    });

    runner.test("B1.3: CLI test with multiple filter arguments", fn() {
        let kernel = new ConsoleKernel();
        let code = kernel.handle(list("test", "--filter", "router", "test_validator"));
        test_assert(code == 0 or code == 1, "Exit code should be 0 or 1");
    });

    runner.test("B1.4: CLI test multiple consecutive executions", fn() {
        let kernel = new ConsoleKernel();
        let c1 = kernel.handle(list("help"));
        let c2 = kernel.handle(list("help"));
        test_assert_eq(c1, 0, "First execution should succeed");
        test_assert_eq(c2, 0, "Second execution should succeed identically");
    });

    runner.test("B1.5: CLI test runner binary discovery candidates non-empty", fn() {
        let kernel = new ConsoleKernel();
        test_assert_not_null(kernel, "Kernel instance must be valid");
    });

    // ------------------------------------------------------------------------
    // Feature 2: Magic CLI Help & Route Listing Boundaries
    // ------------------------------------------------------------------------

    runner.test("B2.1: CLI help with extra trailing arguments", fn() {
        let kernel = new ConsoleKernel();
        let code = kernel.handle(list("help", "extra", "unused", "args"));
        test_assert_eq(code, 0, "Help with extra arguments should still display help and exit 0");
    });

    runner.test("B2.2: CLI short help flag -h", fn() {
        let kernel = new ConsoleKernel();
        let code = kernel.handle(list("-h"));
        test_assert_eq(code, 0, "-h should display help and exit 0");
    });

    runner.test("B2.3: CLI route:list with empty route collection", fn() {
        let router = new Router();
        test_assert_eq(router.routes().len(), 0, "Fresh router should have 0 routes");
        // Ensure no crash when listing empty routes
    });

    runner.test("B2.4: CLI route:list with special characters in URI", fn() {
        let router = new Router();
        router.get("/api/v1/user-profiles/:user_id/stats-2026", fn(_r) { return response("ok", 200); });
        let matched = router.match_route("GET", "/api/v1/user-profiles/123/stats-2026");
        test_assert_not_null(matched, "Hyphenated and underscored route must match");
    });

    runner.test("B2.5: CLI unknown command formatted message", fn() {
        let kernel = new ConsoleKernel();
        let code = kernel.handle(list("bogus_command_999"));
        test_assert_eq(code, 1, "Unknown command must return code 1");
    });

    // ------------------------------------------------------------------------
    // Feature 3: Package Manifest Toolchain Boundaries
    // ------------------------------------------------------------------------

    runner.test("B3.1: Manifest file size within reasonable bounds", fn() {
        let sz_res = file_size("spider.toml");
        test_assert(sz_res.is_ok(), "file_size on spider.toml should return ok");
        let sz = sz_res.unwrap();
        test_assert(sz > 50, "spider.toml size must be > 50 bytes");
        test_assert(sz < 10000, "spider.toml size must be < 10KB");
    });

    runner.test("B3.2: Manifest entry file exists on disk", fn() {
        test_assert(file_exists("server.matrix"), "Entry file server.matrix declared in spider.toml must exist");
    });

    runner.test("B3.3: Manifest version follows major.minor.patch", fn() {
        let content = read_file("spider.toml").unwrap();
        test_assert_contains(content, "version = \"1.0.0\"", "Version must match 1.0.0");
    });

    runner.test("B3.4: Manifest package name has no trailing spaces", fn() {
        let content = read_file("spider.toml").unwrap();
        test_assert_contains(content, "name = \"spid3r_web\"", "Package name must be exact");
    });

    runner.test("B3.5: Manifest zero external dependencies integrity", fn() {
        let content = read_file("spider.toml").unwrap();
        test_assert_contains(content, "[dependencies]", "Manifest must declare dependencies section");
    });

    // ------------------------------------------------------------------------
    // Feature 4: Active Record ORM CRUD Boundaries
    // ------------------------------------------------------------------------

    runner.test("B4.1: SQL injection characters handled safely in where values", fn() {
        let suffix = unique_suffix();
        let injection_attempt = "admin' OR '1'='1' -- " + suffix;
        let res = DB.table("users").where("email", "=", injection_attempt).first();
        test_assert_null(res, "SQL injection string must be treated as literal value and return null");
    });

    runner.test("B4.2: Querying non-existent negative ID returns null", fn() {
        let res = DB.table("users").find(-9999);
        test_assert_null(res, "find(-9999) must return null");
    });

    runner.test("B4.3: Update on non-existent record returns 0 affected rows", fn() {
        let affected = DB.table("users").where("id", "=", -9999).update(map("name", "Ghost"));
        test_assert_eq(affected, 0, "Update on non-existent record should return 0");
    });

    runner.test("B4.4: Delete on non-existent record returns 0 affected rows", fn() {
        let affected = DB.table("users").where("id", "=", -9999).delete();
        test_assert_eq(affected, 0, "Delete on non-existent record should return 0");
    });

    runner.test("B4.5: Limit 0 and large offset handling", fn() {
        let rows = DB.table("users").limit(1).offset(100000).get();
        test_assert_eq(rows.len(), 0, "Large offset beyond count should return empty list");
    });

    // ------------------------------------------------------------------------
    // Feature 5: Active Record Relationships Boundaries
    // ------------------------------------------------------------------------

    runner.test("B5.1: Relationship query with non-existent foreign key", fn() {
        let orphan_post = new Post(map("id", 99999, "user_id", -1, "title", "Orphan"));
        let author = orphan_post.author();
        test_assert_null(author, "Author of post with user_id -1 must be null");
    });

    runner.test("B5.2: Relationship query on unpersisted model instance", fn() {
        let fresh_user = new User();
        let posts = fresh_user.posts();
        test_assert_eq(posts.len(), 0, "Unpersisted user posts should return empty list");
    });

    runner.test("B5.3: Relationship query when parent record deleted", fn() {
        let suffix = unique_suffix();
        let user = UserModel.create(map(
            "name", "Doomed Parent " + suffix,
            "email", "doomed_" + suffix + "@example.com",
            "password", "secret"
        ));
        let uid = int(user.get("id"));

        let post = PostModel.create(map(
            "title", "Child of Doomed",
            "slug", "child-doomed-" + suffix,
            "content", "Content",
            "category", "Test",
            "user_id", uid,
            "status", "published",
            "views_count", 0
        ));

        // Delete parent user
        user.delete();

        // Reload post and check author
        let reloaded_post = PostModel.find(int(post.get("id")));
        let missing_author = reloaded_post.author();
        test_assert_null(missing_author, "Author of post whose parent was deleted must be null");

        // Cleanup post
        post.delete();
    });

    runner.test("B5.4: Relationship list length accuracy on multiple creations", fn() {
        let suffix = unique_suffix();
        let user = UserModel.create(map(
            "name", "Batch Author " + suffix,
            "email", "batch_" + suffix + "@example.com",
            "password", "secret"
        ));
        let uid = int(user.get("id"));

        let p1 = PostModel.create(map("title", "P1", "slug", "p1_" + suffix, "content", "C1", "category", "C", "user_id", uid, "status", "pub", "views_count", 0));
        let p2 = PostModel.create(map("title", "P2", "slug", "p2_" + suffix, "content", "C2", "category", "C", "user_id", uid, "status", "pub", "views_count", 0));
        let p3 = PostModel.create(map("title", "P3", "slug", "p3_" + suffix, "content", "C3", "category", "C", "user_id", uid, "status", "pub", "views_count", 0));

        test_assert_eq(user.posts().len(), 3, "User should have exactly 3 posts");

        p1.delete();
        p2.delete();
        p3.delete();
        user.delete();
    });

    runner.test("B5.5: Relationship returns distinct list instance", fn() {
        let suffix = unique_suffix();
        let user = UserModel.create(map("name", "List User", "email", "l_" + suffix + "@example.com", "password", "p"));
        let l1 = user.posts();
        let l2 = user.posts();
        l1.push("dummy");
        test_assert_ne(l1.len(), l2.len(), "Each call to user.posts() should return a new list instance");
        user.delete();
    });

    // ------------------------------------------------------------------------
    // Feature 6: Database Migrations & DDL Boundaries
    // ------------------------------------------------------------------------

    runner.test("B6.1: Schema.dropIfExists on non-existent table succeeds quietly", fn() {
        let dropped = Schema.dropIfExists("definitely_non_existent_table_99999");
        test_assert(dropped, "dropIfExists on non-existent table should return true without error");
    });

    runner.test("B6.2: Schema.create with underscores in table and column names", fn() {
        let t_name = "test_custom_table_" + unique_suffix();
        Schema.create(t_name, fn(t) {
            t.id();
            t.string("first_name_attr");
            t.integer("score_total");
        });
        test_assert(DB.table(t_name).count() == 0, "Table should exist with 0 records");
        Schema.dropIfExists(t_name);
    });

    runner.test("B6.3: Large text storage in SQLite table", fn() {
        let t_name = "test_large_text_" + unique_suffix();
        Schema.create(t_name, fn(t) {
            t.id();
            t.text("content");
        });

        let big_str = "A";
        let i = 0;
        while i < 12 {
            big_str = big_str + big_str;
            i = i + 1;
        } // 4096 chars

        let ins_id = DB.table(t_name).insert(map("content", big_str));
        let row = DB.table(t_name).find(ins_id);
        test_assert_eq(string(row["content"]).len(), 4096, "Stored large text length should match 4096");

        Schema.dropIfExists(t_name);
    });

    runner.test("B6.4: MigrationRunner rollback when no migrations exist for batch", fn() {
        let runner_inst = new MigrationRunner();
        let rolled = runner_inst.rollback(list());
        test_assert(rolled == 0 or rolled > 0, "Rollback should return non-negative integer count");
    });

    runner.test("B6.5: Migration status table print executes cleanly", fn() {
        let runner_inst = new MigrationRunner();
        runner_inst.status(list());
        test_assert(true, "status() should execute without throwing");
    });

    // ------------------------------------------------------------------------
    // Feature 7: Router Pattern & Param Extraction Boundaries
    // ------------------------------------------------------------------------

    runner.test("B7.1: Default path assigned when omitted in raw map", fn() {
        let req = new Request(map("method", "GET"));
        test_assert_eq(req.path, "/", "Request without path should default to '/'");
    });

    runner.test("B7.2: Route with trailing slash matches definition without slash", fn() {
        let router = new Router();
        router.get("/profile", fn(_r) { return response("profile", 200); });
        let matched = router.match_route("GET", "/profile/");
        test_assert_not_null(matched, "Trailing slash /profile/ should match /profile");
    });

    runner.test("B7.3: Deep multi-parameter route extraction (4 params)", fn() {
        let router = new Router();
        router.get("/a/:p1/b/:p2/c/:p3/d/:p4", fn(_r) { return response("deep", 200); });
        let matched = router.match_route("GET", "/a/v1/b/v2/c/v3/d/v4");
        test_assert_not_null(matched, "4-parameter route should match");
        test_assert_eq(matched["params"]["p1"], "v1", "p1 match");
        test_assert_eq(matched["params"]["p2"], "v2", "p2 match");
        test_assert_eq(matched["params"]["p3"], "v3", "p3 match");
        test_assert_eq(matched["params"]["p4"], "v4", "p4 match");
    });

    runner.test("B7.4: Parameter value with hyphens, underscores and dots", fn() {
        let router = new Router();
        router.get("/files/:filename", fn(_r) { return response("file", 200); });
        let matched = router.match_route("GET", "/files/my-document_v2.0.pdf");
        test_assert_not_null(matched, "Parameter with dots and hyphens must match");
        test_assert_eq(matched["params"]["filename"], "my-document_v2.0.pdf", "Extracted filename should match");
    });

    runner.test("B7.5: Static route takes priority over dynamic parameter route", fn() {
        let router = new Router();
        router.get("/posts/recent", fn(_r) { return response("static_recent", 200); });
        router.get("/posts/:id", fn(_r) { return response("dynamic_id", 200); });

        let m = router.match_route("GET", "/posts/recent");
        test_assert_not_null(m, "/posts/recent must match");
        test_assert_eq(m["route"].path, "/posts/recent", "Exact static route should match");
    });

    // ------------------------------------------------------------------------
    // Feature 8: Router Method Dispatch & 405 Status Boundaries
    // ------------------------------------------------------------------------

    runner.test("B8.1: Lowercase HTTP method normalized to uppercase", fn() {
        let router = new Router();
        router.get("/test_case", fn(_r) { return response("ok", 200); });
        let m = router.match_route("get", "/test_case");
        test_assert_not_null(m, "Lowercase 'get' should match uppercase GET route");
    });

    runner.test("B8.2: HEAD request method check", fn() {
        let router = new Router();
        router.get("/head_target", fn(_r) { return response("body", 200); });
        // Checking behavior on HEAD
        let m = router.match_route("HEAD", "/head_target");
        test_assert(m == null or m != null, "HEAD matching evaluated cleanly");
    });

    runner.test("B8.3: Dispatching request with payload on GET route", fn() {
        let router = new Router();
        router.get("/get_with_body", fn(r) { return response("got: " + r.body, 200); });
        let raw = make_request("GET", "/get_with_body", null, "payload_in_get");
        let m = router.match_route("GET", "/get_with_body");
        let res = router.dispatch(m["route"].handler, new Request(raw));
        test_assert_eq(res.body, "got: payload_in_get", "GET handler should receive request body if present");
    });

    runner.test("B8.4: OPTIONS preflight on route with middleware", fn() {
        let cors = new CorsMiddleware();
        let raw = make_request("OPTIONS", "/api/v1/posts");
        let res = cors.handle(new Request(raw));
        test_assert_not_null(res, "OPTIONS preflight must be intercepted");
        test_assert_eq(res.status_code, 204, "Preflight must return 204");
    });

    runner.test("B8.5: Method mismatch rejection contract (M4 contract)", fn() {
        let app = new Application();
        Route.get("/e2e-405-boundary", fn(_r) { return response("ok", 200); });
        let raw = make_request("DELETE", "/e2e-405-boundary"); // GET only
        let res = app.handle_request(raw);
        test_assert_eq(res["status"], 405, "Mismatched verb on existing path should return 405");
    });

    // ------------------------------------------------------------------------
    // Feature 9: Request Validation Engine Boundaries
    // ------------------------------------------------------------------------

    runner.test("B9.1: Required rule fails on whitespace-only input", fn() {
        let req = new Request(make_request("POST", "/t", null, "title=%20%20%20"));
        let v = req.validate(map("title", "required"));
        test_assert(v.fails(), "Whitespace-only field should fail required rule");
    });

    runner.test("B9.2: Email rule rejects spaces inside address", fn() {
        let req = new Request(make_request("POST", "/t", null, "email=user%20name%40domain.com"));
        let v = req.validate(map("email", "email"));
        test_assert(v.fails(), "Email with embedded space must fail validation");
    });

    runner.test("B9.3: Min length exact boundary checks", fn() {
        let req1 = new Request(make_request("POST", "/t", null, "pin=123"));
        let req2 = new Request(make_request("POST", "/t", null, "pin=1234"));

        test_assert(req1.validate(map("pin", "min:4")).fails(), "Length 3 should fail min:4");
        test_assert(req2.validate(map("pin", "min:4")).passes(), "Length 4 should pass min:4");
    });

    runner.test("B9.4: Max length exact boundary checks", fn() {
        let req1 = new Request(make_request("POST", "/t", null, "code=ABCDE"));
        let req2 = new Request(make_request("POST", "/t", null, "code=ABCDEF"));

        test_assert(req1.validate(map("code", "max:5")).passes(), "Length 5 should pass max:5");
        test_assert(req2.validate(map("code", "max:5")).fails(), "Length 6 should fail max:5");
    });

    runner.test("B9.5: Numeric rule with decimal zero, negative, and alphanumeric", fn() {
        let req_zero = new Request(make_request("POST", "/t", null, "val=0.0"));
        let req_neg = new Request(make_request("POST", "/t", null, "val=-42.5"));
        let req_bad = new Request(make_request("POST", "/t", null, "val=123abc"));

        test_assert(req_zero.validate(map("val", "numeric")).passes(), "0.0 should pass numeric");
        test_assert(req_neg.validate(map("val", "numeric")).passes(), "-42.5 should pass numeric");
        test_assert(req_bad.validate(map("val", "numeric")).fails(), "123abc should fail numeric");
    });

    let success = runner.summary();
    if not success {
        return 1;
    }
    return 0;
}
