// tests/test_http_lifecycle.matrix
// Integration test for Spid3rWeb Full HTTP Lifecycle

import "framework/Application";
import "routes/web";
import "routes/api";
import "app/Models/User";

fn test_lifecycle_requests() {
    let app = new Application();
    register_web_routes();
    register_api_routes();

    // 1. GET / (Home page HTML)
    let res1 = app.handle_request(map(
        "method", "GET",
        "path", "/",
        "headers", map("accept", "text/html"),
        "body", ""
    ));
    assert(res1["status"] == 200, "GET / should return 200 OK");
    assert(string(res1["body"]).contains("Spid3rWeb"), "Home page should contain Spid3rWeb");
    println("  [PASS] GET / -> 200 OK (SpiderBD rendered)");

    // 2. GET /register (Register page HTML)
    let res_reg = app.handle_request(map(
        "method", "GET",
        "path", "/register",
        "headers", map("accept", "text/html"),
        "body", ""
    ));
    assert(res_reg["status"] == 200, "GET /register should return 200 OK");
    assert(string(res_reg["body"]).contains("Create Account"), "Register page should contain Create Account");
    println("  [PASS] GET /register -> 200 OK (SpiderBD rendered)");

    // 3. POST /register with invalid email
    let res_reg_bad = app.handle_request(map(
        "method", "POST",
        "path", "/register",
        "headers", map("content-type", "application/x-www-form-urlencoded"),
        "body", "name=Ada+Lovelace&email=not-an-email&password=secret123"
    ));
    assert(string(res_reg_bad["body"]).contains("The email must be a valid email address."), "Should display email validation error");
    println("  [PASS] POST /register (invalid email) -> Validation error rendered");

    // 4. POST /register with valid email containing percent-encoded %40 and +
    let t_stamp = string(unix_ms());
    let reg_email = "test_user_" + t_stamp + "@example.com";
    let encoded_reg_email = "Test_User_" + t_stamp + "%40Example.COM";
    let res_reg_ok = app.handle_request(map(
        "method", "POST",
        "path", "/register",
        "headers", map("content-type", "application/x-www-form-urlencoded"),
        "body", "name=Ada+Lovelace&email=+" + encoded_reg_email + "+&password=secret123\r\n"
    ));
    assert(res_reg_ok["status"] == 302, "POST /register should redirect 302 on success");
    assert(res_reg_ok["headers"].has("set-cookie"), "Response should set session cookie");
    assert(string(res_reg_ok["headers"]["set-cookie"]).contains("spid3r_session"), "Cookie name should be spid3r_session");
    println("  [PASS] POST /register (valid url-encoded email %40) -> 302 Redirect & Session Cookie");

    // 5. POST /register duplicate email (case-insensitive)
    let res_reg_dup = app.handle_request(map(
        "method", "POST",
        "path", "/register",
        "headers", map("content-type", "application/x-www-form-urlencoded"),
        "body", "name=Ada+Lovelace&email=" + reg_email.replace("@", "%40") + "&password=secret123"
    ));
    assert(string(res_reg_dup["body"]).contains("already registered"), "Duplicate registration should fail");
    println("  [PASS] POST /register (duplicate email) -> Conflict error rendered");

    // 6. POST /login with valid form-encoded credentials (lowercase)
    let res_login = app.handle_request(map(
        "method", "POST",
        "path", "/login",
        "headers", map("content-type", "application/x-www-form-urlencoded"),
        "body", "email=" + reg_email.replace("@", "%40") + "&password=secret123"
    ));
    assert(res_login["status"] == 302, "POST /login should redirect 302 on success");
    assert(res_login["headers"].has("set-cookie"), "Login should return session cookie");
    println("  [PASS] POST /login (form-encoded valid email %40) -> 302 Redirect & Session Cookie");

    // Clean up created test user
    let created_u = UserModel.findByEmail(reg_email);
    if created_u != null {
        created_u.delete();
    }

    // 7. GET /api/v1/status (JSON API)
    let res2 = app.handle_request(map(
        "method", "GET",
        "path", "/api/v1/status",
        "headers", map("accept", "application/json"),
        "body", ""
    ));
    assert(res2["status"] == 200, "GET /api/v1/status should return 200 OK");
    assert(string(res2["body"]).contains("healthy"), "API status should contain healthy");
    println("  [PASS] GET /api/v1/status -> 200 OK (JSON API)");

    // 8. GET /api/v1/posts (JSON posts list)
    let res3 = app.handle_request(map(
        "method", "GET",
        "path", "/api/v1/posts",
        "headers", map("accept", "application/json"),
        "body", ""
    ));
    assert(res3["status"] == 200, "GET /api/v1/posts should return 200 OK");
    assert(string(res3["body"]).contains("data"), "Posts list should contain data field");
    println("  [PASS] GET /api/v1/posts -> 200 OK (JSON Resource)");

    // 9. GET /non-existent (404 Not Found)
    let res4 = app.handle_request(map(
        "method", "GET",
        "path", "/non-existent-route-404",
        "headers", map(),
        "body", ""
    ));
    assert(res4["status"] == 404, "Unknown route should return 404 Not Found");
    assert(string(res4["body"]).contains("404"), "Body should contain 404 error page");
    println("  [PASS] GET /non-existent -> 404 Not Found");

    // 10. POST /api/v1/login with bad credentials (401 Unauthorized)
    let bad_cred_body = json_write(map(
        "email", "wrong@example.com",
        "password", "wrongpassword"
    ));
    let res5 = app.handle_request(map(
        "method", "POST",
        "path", "/api/v1/login",
        "headers", map("content-type", "application/json"),
        "body", bad_cred_body
    ));
    assert(res5["status"] == 401, "Bad credentials should return 401 Unauthorized");
    println("  [PASS] POST /api/v1/login (invalid) -> 401 Unauthorized");
}

fn main() {
    println("\n=== Running HTTP Lifecycle Test Suite ===");
    test_lifecycle_requests();
    println("=== All HTTP Lifecycle Tests Passed! ===\n");
}
