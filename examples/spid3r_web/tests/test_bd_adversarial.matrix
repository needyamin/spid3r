// tests/test_bd_adversarial.matrix
// Challenger Adversarial Stress Suite for SpiderBD Template Engine

import "framework/View/BD";
import "app/Models/User";
import "app/Models/Post";
import "framework/Database/DB";

fn assert_eq(actual, expected, msg) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg);
        println("  Expected: [" + string(expected) + "]");
        println("  Actual:   [" + string(actual) + "]");
        assert(false, msg);
    }
}

// ----------------------------------------------------------------------------
// 1. Deep Property Paths & Boundary Data Types
// ----------------------------------------------------------------------------
fn test_adv_deep_property_paths_and_values() {
    let t_view = "resources/views/adv_deep.bd.html";
    let content = "deep:" + "{{" + " a.b.c.d.e " + "}}" + " " +
                  "num_zero:" + "{{" + " zero " + "}}" + " " +
                  "num_neg:" + "{{" + " neg " + "}}" + " " +
                  "bool_t:" + "{{" + " b_true " + "}}" + " " +
                  "bool_f:" + "{{" + " b_false " + "}}" + " " +
                  "empty_str:" + "[" + "{{" + " empty " + "}}" + "] " +
                  "missing_root:" + "[" + "{{" + " not_here " + "}}" + "] " +
                  "missing_deep:" + "[" + "{{" + " a.b.missing.e " + "}}" + "] " +
                  "list_idx:" + "{{" + " list_data.1.title " + "}}" + " " +
                  "list_oob:" + "[" + "{{" + " list_data.99.title " + "}}" + "] " +
                  "list_invalid_key:" + "[" + "{{" + " list_data.invalid.title " + "}}" + "]";
    write_file(t_view, content);

    let data = map(
        "a", map("b", map("c", map("d", map("e", "EXCELLENT")))),
        "zero", 0,
        "neg", -42,
        "b_true", true,
        "b_false", false,
        "empty", "",
        "list_data", list(
            map("title", "First"),
            map("title", "Second")
        )
    );

    let rendered = global_bd.render("adv_deep", data);
    file_delete(t_view);

    assert(rendered.contains("deep:EXCELLENT"), "5-level deep dot notation must resolve correctly");
    assert(rendered.contains("num_zero:0"), "Numeric 0 must interpolate as '0', not empty string");
    assert(rendered.contains("num_neg:-42"), "Negative numbers must interpolate with negative sign");
    assert(rendered.contains("bool_t:true"), "Boolean true must interpolate as 'true'");
    assert(rendered.contains("bool_f:false"), "Boolean false must interpolate as 'false'");
    assert(rendered.contains("empty_str:[]"), "Empty string must interpolate as empty string");
    assert(rendered.contains("missing_root:[]"), "Missing root variable must resolve to empty string");
    assert(rendered.contains("missing_deep:[]"), "Missing deep property must resolve to empty string without crash");
    assert(rendered.contains("list_idx:Second"), "Numeric indexing on list must resolve correctly");
    assert(rendered.contains("list_oob:[]"), "Out of bounds list index must resolve to empty string");
    assert(rendered.contains("list_invalid_key:[]"), "Non-numeric key on list must resolve to empty string safely");

    println("  [PASS] test_adv_deep_property_paths_and_values");
}

// ----------------------------------------------------------------------------
// 2. Whitespace Tolerance Variations
// ----------------------------------------------------------------------------
fn test_adv_whitespace_variations() {
    let t_view = "resources/views/adv_ws.bd.html";
    let content = "w0:" + "{{" + "$v" + "}}" + "|" +
                  "w1:" + "{{" + " $v " + "}}" + "|" +
                  "w3:" + "{{" + "   $v   " + "}}" + "|" +
                  "n0:" + "{{" + "v" + "}}" + "|" +
                  "n1:" + "{{" + " v " + "}}" + "|" +
                  "n3:" + "{{" + "   v   " + "}}" + "|" +
                  "r0:" + "{!!" + "$r" + "!!}" + "|" +
                  "r1:" + "{!!" + " $r " + "!!}" + "|" +
                  "r3:" + "{!!" + "   $r   " + "!!}" + "|" +
                  "rn0:" + "{!!" + "r" + "!!}" + "|" +
                  "rn1:" + "{!!" + " r " + "!!}" + "|" +
                  "rn3:" + "{!!" + "   r   " + "!!}" + "|" +
                  "dot_ws:" + "{{" + "  user . profile . title  " + "}}" + "|" +
                  "adj:" + "{{" + "$a" + "}}" + "{{" + "$b" + "}}" + "{!!" + "$c" + "!!}" + "|" +
                  "empty_tag:" + "[" + "{{" + "   " + "}}" + "]" + "[" + "{!!" + "   " + "!!}" + "]";
    write_file(t_view, content);

    let data = map(
        "v", "VAL",
        "r", "RAW",
        "user", map("profile", map("title", "ADMIN")),
        "a", "A",
        "b", "B",
        "c", "C"
    );

    let rendered = global_bd.render("adv_ws", data);
    file_delete(t_view);

    assert(rendered.contains("w0:VAL|w1:VAL|w3:VAL|n0:VAL|n1:VAL|n3:VAL"), "All variable whitespace formats must match");
    assert(rendered.contains("r0:RAW|r1:RAW|r3:RAW|rn0:RAW|rn1:RAW|rn3:RAW"), "All raw tag whitespace formats must match");
    assert(rendered.contains("dot_ws:ADMIN"), "Dot notation with arbitrary internal spacing must resolve");
    assert(rendered.contains("adj:ABC"), "Consecutive adjacent tags must concatenate seamlessly");
    assert(rendered.contains("empty_tag:[][]"), "Empty tags must produce empty strings safely");

    println("  [PASS] test_adv_whitespace_variations");
}

// ----------------------------------------------------------------------------
// 3. HTML Injection & Escaping vs Raw
// ----------------------------------------------------------------------------
fn test_adv_html_injection_and_escaping() {
    let t_view = "resources/views/adv_xss.bd.html";
    let content = "esc1:" + "{{" + " payload1 " + "}}" + "\n" +
                  "esc2:" + "{{" + " payload2 " + "}}" + "\n" +
                  "esc3:" + "{{" + " payload3 " + "}}" + "\n" +
                  "esc4:" + "{{" + " payload4 " + "}}" + "\n" +
                  "raw1:" + "{!!" + " payload1 " + "!!}" + "\n" +
                  "raw2:" + "{!!" + " payload2 " + "!!}";
    write_file(t_view, content);

    let data = map(
        "payload1", "<script>alert('xss')</script>",
        "payload2", "\" onmouseover=\"evil()",
        "payload3", "' or 1=1 --",
        "payload4", "& < > \" '"
    );

    let rendered = global_bd.render("adv_xss", data);
    file_delete(t_view);

    // Escaped assertions
    assert(not rendered.contains("esc1:<script>"), "Escaped script tag must not contain unescaped <script>");
    assert(rendered.contains("esc1:&lt;script&gt;alert(&#039;xss&#039;)&lt;/script&gt;"), "Script tag must be fully escaped");
    assert(not rendered.contains("esc2:\" onmouseover"), "Escaped attribute breakout must not contain unescaped quotes");
    assert(rendered.contains("esc2:&quot; onmouseover=&quot;evil()"), "Attribute breakout must be escaped with &quot;");
    assert(rendered.contains("esc3:&#039; or 1=1 --"), "SQL-like single quotes must be escaped with &#039;");
    assert(rendered.contains("esc4:&amp; &lt; &gt; &quot; &#039;"), "All HTML special chars must be escaped");

    // Raw assertions
    assert(rendered.contains("raw1:<script>alert('xss')</script>"), "Raw tag must output unescaped payload");
    assert(rendered.contains("raw2:\" onmouseover=\"evil()"), "Raw tag must output unescaped attribute injection");

    println("  [PASS] test_adv_html_injection_and_escaping");
}

// ----------------------------------------------------------------------------
// 4. Single-Pass Template Injection Resistance (SSTI Prevention)
// ----------------------------------------------------------------------------
fn test_adv_ssti_second_pass_rejection() {
    let t_view = "resources/views/adv_ssti.bd.html";
    let content = "OUT:" + "{!!" + " untrusted " + "!!}" + ";";
    write_file(t_view, content);

    // Attacker sends {{ secret }} in raw unescaped variable
    let data = map(
        "untrusted", "{{" + " secret " + "}}",
        "secret", "CONFIDENTIAL_API_KEY_LEAK"
    );

    let rendered = global_bd.render("adv_ssti", data);
    file_delete(t_view);

    // The output MUST contain the literal string '{{ secret }}' and NOT evaluate secret
    assert(not rendered.contains("CONFIDENTIAL_API_KEY_LEAK"), "SSTI vulnerability: second-pass evaluation executed injected template tag!");
    assert(rendered.contains("OUT:{{" + " secret " + "}};"), "Single-pass scanner must output injected tag literally");

    println("  [PASS] test_adv_ssti_second_pass_rejection");
}

// ----------------------------------------------------------------------------
// 5. CSS & JS Single Curly Braces Preservation
// ----------------------------------------------------------------------------
fn test_adv_css_js_single_curly_braces() {
    let t_view = "resources/views/adv_css_js.bd.html";
    let content = "<style>\n" +
                  "body { font-family: 'Helvetica', sans-serif; font-size: 14px; margin: 0 auto; }\n" +
                  ".card { border-radius: 8px; color: " + "{{" + " theme_color " + "}}" + "; }\n" +
                  "@media (min-width: 768px) { .container { width: 750px; } }\n" +
                  "</style>\n" +
                  "<script>\n" +
                  "const config = { api: '/api/v1', debug: true, options: { retries: 3 } };\n" +
                  "function init(cfg) {\n" +
                  "  if (cfg.debug) { console.log('Current user:', " + "{{" + " user.name " + "}}" + "); }\n" +
                  "}\n" +
                  "</script>\n" +
                  "<script type=\"application/json\">{ \"status\": \"ok\", \"count\": 42 }</script>";
    write_file(t_view, content);

    let data = map(
        "theme_color", "#2563eb",
        "user", map("name", "Margaret Hamilton")
    );

    let rendered = global_bd.render("adv_css_js", data);
    file_delete(t_view);

    assert(rendered.contains("body { font-family: 'Helvetica', sans-serif; font-size: 14px; margin: 0 auto; }"), "CSS single curly braces must remain unaltered");
    assert(rendered.contains(".card { border-radius: 8px; color: #2563eb; }"), "CSS embedded template variable must interpolate properly");
    assert(rendered.contains("@media (min-width: 768px) { .container { width: 750px; } }"), "Nested CSS media queries must remain intact");
    assert(rendered.contains("const config = { api: '/api/v1', debug: true, options: { retries: 3 } };"), "JS object literal braces must remain intact");
    assert(rendered.contains("console.log('Current user:', Margaret Hamilton);"), "JS embedded variable must interpolate");
    assert(rendered.contains("<script type=\"application/json\">{ \"status\": \"ok\", \"count\": 42 }</script>"), "Inline JSON single curly braces must remain intact");

    println("  [PASS] test_adv_css_js_single_curly_braces");
}

// ----------------------------------------------------------------------------
// 6. Active Record Model Instances & Relation Chaining
// ----------------------------------------------------------------------------
fn test_adv_active_record_models_and_relations() {
    let now = string(unix_time());

    // 1. In-memory model instance testing
    let post_mem = new Post(map(
        "title", "In-Memory Post Title",
        "category", "InMemory",
        "views_count", 777
    ));

    let t_view = "resources/views/adv_model.bd.html";
    let content = "title:" + "{{" + " post.title " + "}}" + " " +
                  "cat:" + "{{" + " post.category " + "}}" + " " +
                  "views:" + "{{" + " post.views_count " + "}}" + " " +
                  "missing:" + "[" + "{{" + " post.non_existent " + "}}" + "]";
    write_file(t_view, content);

    let rendered_mem = global_bd.render("adv_model", map("post", post_mem));
    file_delete(t_view);

    assert(rendered_mem.contains("title:In-Memory Post Title"), "In-memory model attribute 'title' must resolve");
    assert(rendered_mem.contains("cat:InMemory"), "In-memory model attribute 'category' must resolve");
    assert(rendered_mem.contains("views:777"), "In-memory model attribute 'views_count' must resolve");
    assert(rendered_mem.contains("missing:[]"), "Missing model attribute must resolve to empty string safely");

    // 2. Database persisted Model & Relations: Post -> Author and User -> Posts
    let user = UserModel.create(map(
        "name", "Grace Hopper",
        "email", "grace_" + now + "@navy.mil",
        "password", "nanoseconds"
    ));
    assert(user != null, "User must be created");
    let uid = int(user.get("id"));

    let post = PostModel.create(map(
        "title", "Compilers and Flow-Matic",
        "slug", "compilers-flow-matic-" + now,
        "content", "Programming languages should be human readable.",
        "category", "History",
        "user_id", uid,
        "status", "published",
        "views_count", 1952
    ));
    assert(post != null, "Post must be created");
    let pid = int(post.get("id"));

    let t_rel_view = "resources/views/adv_rel.bd.html";
    let rel_content = "post_title:" + "{{" + " post.title " + "}}" + " " +
                      "post_author_name:" + "{{" + " post.author.name " + "}}" + " " +
                      "post_author_email:" + "{{" + " post.author.email " + "}}" + " " +
                      "user_first_post_title:" + "{{" + " user.posts.0.title " + "}}" + " " +
                      "user_post_oob:" + "[" + "{{" + " user.posts.99.title " + "}}" + "]";
    write_file(t_rel_view, rel_content);

    let rendered_rel = global_bd.render("adv_rel", map(
        "post", post,
        "user", user
    ));
    file_delete(t_rel_view);

    // Clean up database entities before assertions to ensure zero leaks
    post.delete();
    user.delete();
    DB.checkpoint();

    assert(rendered_rel.contains("post_title:Compilers and Flow-Matic"), "Post title must resolve");
    assert(rendered_rel.contains("post_author_name:Grace Hopper"), "post.author.name relation chaining must resolve");
    assert(rendered_rel.contains("post_author_email:grace_" + now + "@navy.mil"), "post.author.email relation chaining must resolve");
    assert(rendered_rel.contains("user_first_post_title:Compilers and Flow-Matic"), "user.posts.0.title relation chaining must resolve");
    assert(rendered_rel.contains("user_post_oob:[]"), "user.posts.99.title out of bounds relation must resolve to empty string safely");

    println("  [PASS] test_adv_active_record_models_and_relations");
}

// ----------------------------------------------------------------------------
// 7. Nested Collections in @foreach Loops
// ----------------------------------------------------------------------------
fn test_adv_nested_foreach_collections() {
    let t_view = "resources/views/adv_loop.bd.html";
    let content = "@foreach($org.members as $m)\n" +
                  "<p>" + "{{" + " m.name " + "}}" + " - " + "{{" + " m.role " + "}}" + "</p>\n" +
                  "@endforeach";
    write_file(t_view, content);

    let data = map(
        "org", map(
            "name", "Spid3r Team",
            "members", list(
                map("name", "Alice", "role", "Engineer"),
                map("name", "Bob", "role", "Designer")
            )
        )
    );

    let rendered = global_bd.render("adv_loop", data);
    file_delete(t_view);

    assert(rendered.contains("<p>Alice - Engineer</p>"), "First nested collection member must render in loop");
    assert(rendered.contains("<p>Bob - Designer</p>"), "Second nested collection member must render in loop");

    println("  [PASS] test_adv_nested_foreach_collections");
}

// ----------------------------------------------------------------------------
// 8. Unclosed / Malformed Tags
// ----------------------------------------------------------------------------
fn test_adv_malformed_and_boundary_tags() {
    // Case 8a: Completely unclosed tag without any closing delimiter in entire template
    let t_view = "resources/views/adv_unclosed.bd.html";
    let content = "prefix: " + "{{" + " unclosed_variable_tag";
    write_file(t_view, content);

    let rendered = global_bd.render("adv_unclosed", map("unclosed_variable_tag", "IGNORED"));
    file_delete(t_view);

    assert(rendered.contains("prefix: {{" + " unclosed_variable_tag"), "Unclosed tag with no closing delimiter should emit verbatim");

    // Case 8b: Completely unclosed raw tag
    let t_raw_view = "resources/views/adv_unclosed_raw.bd.html";
    let raw_content = "raw_prefix: " + "{!!" + " unclosed_raw_tag";
    write_file(t_raw_view, raw_content);

    let rendered_raw = global_bd.render("adv_unclosed_raw", map("unclosed_raw_tag", "IGNORED"));
    file_delete(t_raw_view);

    assert(rendered_raw.contains("raw_prefix: {!" + "! unclosed_raw_tag"), "Unclosed raw tag with no closing delimiter should emit verbatim");

    // Case 8c: Stray closing delimiter only
    let t_stray = "resources/views/adv_stray.bd.html";
    write_file(t_stray, "end_only: closed_tag }} and !!}");

    let rendered_stray = global_bd.render("adv_stray", map());
    file_delete(t_stray);

    assert(rendered_stray.contains("end_only: closed_tag }} and !!}"), "Stray closing delimiters should emit verbatim");

    // Case 8d: Single braces (CSS / JS / JSON objects)
    let t_single = "resources/views/adv_single.bd.html";
    write_file(t_single, "single_brace: { not_a_tag } and { a: 1 }");

    let rendered_single = global_bd.render("adv_single", map());
    file_delete(t_single);

    assert(rendered_single.contains("single_brace: { not_a_tag } and { a: 1 }"), "Single braces must remain verbatim");

    println("  [PASS] test_adv_malformed_and_boundary_tags");
}

fn main() {
    println("\n==================================================================");
    println("        Spid3rWeb Challenger M3 Adversarial Stress Suite          ");
    println("==================================================================");

    test_adv_deep_property_paths_and_values();
    test_adv_whitespace_variations();
    test_adv_html_injection_and_escaping();
    test_adv_ssti_second_pass_rejection();
    test_adv_css_js_single_curly_braces();
    test_adv_active_record_models_and_relations();
    test_adv_nested_foreach_collections();
    test_adv_malformed_and_boundary_tags();

    println("==================================================================");
    println("    === All SpiderBD Adversarial Stress Tests Passed (8/8) ===    ");
    println("==================================================================\n");
}
