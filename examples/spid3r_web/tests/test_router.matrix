// tests/test_router.matrix
// Unit tests for Spid3rWeb Router

import "framework/Router";
import "framework/Response";

fn test_route_registration_and_match() {
    let router = new Router();
    router.get("/hello", fn(_req) { return response("Hello World", 200); });
    router.post("/items", fn(_req) { return response("Created", 201); });

    let matched = router.match_route("GET", "/hello");
    assert(matched != null, "GET /hello should match");
    assert(matched["route"].path == "/hello", "Path should match");

    let post_matched = router.match_route("POST", "/items");
    assert(post_matched != null, "POST /items should match");

    let not_found = router.match_route("GET", "/not-existing");
    assert(not_found == null, "Non-existent route should return null");
    println("  [PASS] test_route_registration_and_match");
}

fn test_route_parameters() {
    let router = new Router();
    router.get("/posts/:id", fn(req) { return response("Post " + req.param("id"), 200); });
    router.get("/users/:uid/comments/:cid", fn(_req) { return response("ok", 200); });

    let match1 = router.match_route("GET", "/posts/42");
    assert(match1 != null, "Route with param should match");
    assert(match1["params"].has("id"), "Param 'id' should be extracted");
    assert(match1["params"]["id"] == "42", "Param 'id' value should be '42'");

    let match2 = router.match_route("GET", "/users/10/comments/99");
    assert(match2 != null, "Multiple params should match");
    assert(match2["params"]["uid"] == "10", "Param uid should match");
    assert(match2["params"]["cid"] == "99", "Param cid should match");
    println("  [PASS] test_route_parameters");
}

fn test_route_groups() {
    let router = new Router();
    router.group(map("prefix", "/api/v1"), fn() {
        router.get("/users", fn(_req) { return response("users", 200); });
        router.get("/posts", fn(_req) { return response("posts", 200); });
    });

    let m1 = router.match_route("GET", "/api/v1/users");
    assert(m1 != null, "Group prefixed route should match");
    assert(m1["route"].path == "/api/v1/users", "Group prefix should be applied");

    let m2 = router.match_route("GET", "/api/v1/posts");
    assert(m2 != null, "Group prefixed route 2 should match");
    println("  [PASS] test_route_groups");
}

fn main() {
    println("\n=== Running Router Test Suite ===");
    test_route_registration_and_match();
    test_route_parameters();
    test_route_groups();
    println("=== All Router Tests Passed! ===\n");
}
