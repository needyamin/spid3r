// ============================================================
// Web Service in Spid3r
// Demonstrating stdlib/web.matrix (Express / PHP Alternative)
// ============================================================

import "web" as w;

fn main() {
    println("=== 1. Initialize WebApp Router ===");
    let app = w.web_app();

    // Logger middleware
    app.use(fn(_req) {
        // Continue processing
        return null;
    });

    // 1. JSON endpoint with route parameter
    app.get("/api/users/:id", fn(req) {
        let user_id = req.params["id"];
        return w.json_response(
            200,
            map(
                "id",
                user_id,
                "name",
                "User " + string(user_id),
                "status",
                "active"
            )
        );
    });

    // 2. HTML template endpoint
    app.get("/profile", fn(_req) {
        let tpl = "<h1>Welcome, {{ user }}!</h1><p>Role: {{ role }}</p>";
        let html = w.render_template(tpl, map("user", "Alice", "role", "Engineer"));
        return w.html_response(200, html);
    });

    // 3. POST endpoint with JSON body and cookie setting
    app.post("/api/login", fn(_req) {
        let token = w.jwt_sign(map("sub", "alice123", "role", "admin"), "app-secret");
        let resp = w.json_response(200, map("token", token, "status", "authenticated"));
        return w.set_cookie(resp, "auth_token", token, map("path", "/", "http_only", true));
    });

    // Dispatch simulated requests through the router
    println("\n=== 2. Handling Requests ===");

    let req1 = map("method", "GET", "path", "/api/users/42", "headers", map());
    let res1 = app.handle(req1);
    println("GET /api/users/42 -> Status: " + string(res1["status"]));
    println("Response body: " + res1["body"]);

    let req2 = map("method", "GET", "path", "/profile", "headers", map());
    let res2 = app.handle(req2);
    println("\nGET /profile -> Status: " + string(res2["status"]));
    println("Response body: " + res2["body"]);

    let req3 = map("method", "POST", "path", "/api/login", "headers", map());
    let res3 = app.handle(req3);
    println("\nPOST /api/login -> Status: " + string(res3["status"]));
    println("Set-Cookie header: " + res3["headers"]["set-cookie"].slice(0, 35) + "...");

    println("\nWeb service router validated successfully.");
}
