// examples/gui/data_studio/app.matrix
// Spid3r Native GUI Application - DataLab & Analytics Studio
// Built using Spid3r native GUI subsystem (Tao + Wry webview bridge).

import "stats" as st;
import "ml" as ml;

let app_state = map(
    "dataset", list(14.2, 22.5, 18.9, 31.4, 25.0, 42.1, 38.6, 51.2, 47.8, 63.5),
    "calc_count", 0,
    "last_op", "none"
);

// ------------------------------------------------------------
// Event Handlers
// ------------------------------------------------------------

fn on_ready(event, payload) {
    println("[Spid3r GUI] Ready event received from webview.");
    // Broadcast initial dataset and stats to UI
    compute_and_push_stats(app_state["dataset"]);
    return null;
}

fn on_compute_stats(event, payload) {
    println("[Spid3r GUI] compute_stats event: " + string(payload));
    let nums = list();
    if payload.starts_with("[") or payload.starts_with("{") {
        try {
            let parsed = json_parse(payload);
            if type_of(parsed) == "list" {
                for item in parsed { nums.push(float(item)); }
            }
        } catch (e) {
            println("[Spid3r GUI] JSON parse error: " + string(e));
        }
    } else {
        for s in payload.split(",") {
            let t = s.trim();
            if t != "" {
                nums.push(float(t));
            }
        }
    }

    if len(nums) > 0 {
        app_state["dataset"] = nums;
        compute_and_push_stats(nums);
    }
    return null;
}

fn compute_and_push_stats(nums) {
    let n = len(nums);
    if n == 0 {
        return null;
    }

    let m = st.mean(nums);
    let med = st.median(nums);
    let v = st.variance(nums, 1);
    let s = st.std(nums, 1);
    let p25 = st.percentile(nums, 25);
    let p75 = st.percentile(nums, 75);
    let iqr = p75 - p25;

    let min_val = nums[0];
    let max_val = nums[0];
    let sum_val = 0.0;
    for x in nums {
        if x < min_val { min_val = x; }
        if x > max_val { max_val = x; }
        sum_val = sum_val + x;
    }

    app_state["calc_count"] = app_state["calc_count"] + 1;
    app_state["last_op"] = "Descriptive Statistics";

    let result = map(
        "count", n,
        "mean", m,
        "median", med,
        "std_dev", s,
        "variance", v,
        "min", min_val,
        "max", max_val,
        "sum", sum_val,
        "p25", p25,
        "p75", p75,
        "iqr", iqr,
        "dataset", nums,
        "total_calcs", app_state["calc_count"]
    );

    let js = "if (window.renderStats) { window.renderStats(" + json_write(result) + "); }";
    gui_eval(js);
    return null;
}

fn on_regression(event, payload) {
    println("[Spid3r GUI] regression event: " + string(payload));
    let points = list();
    if payload.starts_with("[") {
        try {
            let parsed = json_parse(payload);
            if type_of(parsed) == "list" { points = parsed; }
        } catch (e) {
            println("[Spid3r GUI] JSON parse error: " + string(e));
        }
    } else {
        for pair in payload.split("|") {
            let pt = pair.split(",");
            if len(pt) >= 2 {
                points.push(list(float(pt[0].trim()), float(pt[1].trim())));
            }
        }
    }

    let n = len(points);
    if n < 2 {
        return null;
    }

    let X = matrix(n, 1);
    let y = vector(n);

    for let i = 0; i < n; i = i + 1 {
        let pt = points[i];
        X.set(i, 0, float(pt[0]));
        y[i] = float(pt[1]);
    }

    let model = ml.linear_regression_fit(X, y);
    let weights = model["weights"];
    let intercept = weights[0];
    let slope = weights[1];

    let predictions = ml.linear_regression_predict(model, X);
    let pred_list = list();
    for let i = 0; i < n; i = i + 1 {
        pred_list.push(predictions[i]);
    }

    // Compute R^2 score
    let y_mean = y.mean();
    let ss_tot = 0.0;
    let ss_res = 0.0;
    for let i = 0; i < n; i = i + 1 {
        let diff_tot = y[i] - y_mean;
        let diff_res = y[i] - predictions[i];
        ss_tot = ss_tot + diff_tot * diff_tot;
        ss_res = ss_res + diff_res * diff_res;
    }
    let r2 = 1.0;
    if ss_tot > 0.0000001 {
        r2 = 1.0 - (ss_res / ss_tot);
    }

    app_state["calc_count"] = app_state["calc_count"] + 1;
    app_state["last_op"] = "Linear Regression";

    let result = map(
        "slope", slope,
        "intercept", intercept,
        "r2", r2,
        "points", points,
        "predictions", pred_list,
        "total_calcs", app_state["calc_count"]
    );

    let js = "if (window.renderRegression) { window.renderRegression(" + json_write(result) + "); }";
    gui_eval(js);
    return null;
}

fn on_matrix_op(event, payload) {
    println("[Spid3r GUI] matrix_op event: " + string(payload));
    let a11 = 0.0;
    let a12 = 0.0;
    let a21 = 0.0;
    let a22 = 0.0;

    if payload.starts_with("{") {
        try {
            let parsed = json_parse(payload);
            a11 = float(parsed["a11"]);
            a12 = float(parsed["a12"]);
            a21 = float(parsed["a21"]);
            a22 = float(parsed["a22"]);
        } catch (e) {
            println("[Spid3r GUI] JSON parse error: " + string(e));
        }
    } else {
        let parts = payload.split(",");
        if len(parts) >= 4 {
            a11 = float(parts[0].trim());
            a12 = float(parts[1].trim());
            a21 = float(parts[2].trim());
            a22 = float(parts[3].trim());
        }
    }

    let det = a11 * a22 - a12 * a21;
    let trace = a11 + a22;

    let inv = null;
    if det != 0.0 {
        inv = map(
            "a11", a22 / det,
            "a12", -a12 / det,
            "a21", -a21 / det,
            "a22", a11 / det
        );
    }

    // Eigenvalues for 2x2: lambda^2 - trace*lambda + det = 0
    let disc = trace * trace - 4.0 * det;
    let eigen1 = null;
    let eigen2 = null;
    if disc >= 0.0 {
        let sq = sqrt(disc);
        eigen1 = (trace + sq) / 2.0;
        eigen2 = (trace - sq) / 2.0;
    }

    app_state["calc_count"] = app_state["calc_count"] + 1;
    app_state["last_op"] = "Matrix 2x2 Decomposition";

    let result = map(
        "det", det,
        "trace", trace,
        "invertible", det != 0.0,
        "inverse", inv,
        "eigen1", eigen1,
        "eigen2", eigen2,
        "total_calcs", app_state["calc_count"]
    );

    let js = "if (window.renderMatrix) { window.renderMatrix(" + json_write(result) + "); }";
    gui_eval(js);
    return null;
}

// ------------------------------------------------------------
// Entry Point
// ------------------------------------------------------------

fn main() {
    gui_title("Spid3r DataLab Studio (Native GUI)");
    gui_on("ready", on_ready);
    gui_on("compute_stats", on_compute_stats);
    gui_on("regression", on_regression);
    gui_on("matrix_op", on_matrix_op);

    // Synthetic events for headless dry-run verification
    gui_emit("ready", "init");
    gui_emit("regression", "1,2.5|2,3.8|3,5.1|4,7.2|5,8.9");
    gui_emit("matrix_op", "4,2,1,3");
    return 0;
}
