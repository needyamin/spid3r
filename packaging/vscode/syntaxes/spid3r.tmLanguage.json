{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spid3r",
  "scopeName": "source.spid3r",
  "patterns": [{ "include": "#main" }],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#declarations" },
        { "include": "#operators" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spid3r",
          "match": "//.*$"
        },
        {
          "name": "comment.block.spid3r",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.spid3r",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.spid3r" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.spid3r" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.spid3r",
              "match": "\\\\[nrt\\\\\"']|\\\\u\\{[0-9a-fA-F]+\\}"
            },
            {
              "name": "meta.embedded.expression.spid3r",
              "match": "\\{[a-zA-Z_][a-zA-Z0-9_.]*\\}",
              "captures": {
                "0": { "name": "variable.other.interpolation.spid3r" }
              }
            }
          ]
        },
        {
          "name": "string.quoted.single.spid3r",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.spid3r" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.spid3r" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.spid3r",
          "match": "(?<![\\w.])\\d+(\\.\\d+)?([eE][+-]?\\d+)?|0[xX][0-9a-fA-F]+|0[bB][01]+"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spid3r",
          "match": "\\b(if|elif|else|while|for|in|break|continue|return|match|try|catch|finally|throw|spawn|await|async)\\b"
        },
        {
          "name": "keyword.other.spid3r",
          "match": "\\b(fn|let|const|class|interface|enum|implements|extends|new|import|as|public|private|and|or|not|self)\\b"
        },
        {
          "name": "constant.language.spid3r",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.spid3r",
          "match": "\\b(int|float|bool|string|any|list|map|set|tuple|stack|queue|deque|vec|tree|graph|heap|matrix|bytes|bag|option|result)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.spid3r",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.fn.spid3r" },
            "2": { "name": "entity.name.function.spid3r" }
          }
        },
        {
          "name": "meta.class.spid3r",
          "match": "\\b(class|interface|enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.type.spid3r" },
            "2": { "name": "entity.name.type.spid3r" }
          }
        },
        {
          "name": "meta.variable.spid3r",
          "match": "\\b(let|const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.spid3r" },
            "2": { "name": "variable.other.spid3r" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.spid3r",
          "match": "(\\?\\?|\\?\\.|->|=>|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%=<>!&|^])"
        }
      ]
    }
  }
}
