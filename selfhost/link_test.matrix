import "link";

fn main() {
    // 6.1 gate: the linking infrastructure resolves every input and
    // invokes link.exe to produce a working executable.
    let lr = find_msvc_link_exe();
    if lr[0] == null {
        println("FAIL: no MSVC linker");
        return 1;
    }
    println("linker: " + lr[0]);
    let sdk = find_winsdk_lib_root();
    println("sdk: " + sdk);
    let llvm = find_llvm_lib_dir();
    println("llvm: " + llvm);
    let rt = find_runtime_staticlib();
    println("staticlib: " + rt);
    // Link the gate-5.1 object with the FULL runtime staticlib — proving
    // the driver can produce executables that call the runtime.
    let rc = link_executable("llvm_min.obj", "link_gate_output.exe", rt);
    if rc == 0 {
        println("6.1: linking infrastructure proven");
        return 0;
    }
    return 1;
}
