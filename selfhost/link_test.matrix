import "link";

fn main() {
    // 6.1 smoke harness: the linking infrastructure resolves every input.
    // The full 6.1 gate (executables for the whole corpus, stdout + exit
    // parity vs Stage 0) lives in tools/selfhost_native_parity.sh, which
    // drives this same link_executable on every corpus build; this file is
    // the fast single-shot discovery check (and printed the same four roots
    // in the original 2026-11-14 gate, then against the gate-5.1 object).
    let lr = find_msvc_link_exe();
    if lr[0] == null {
        println("FAIL: no MSVC linker");
        return 1;
    }
    println("linker: " + lr[0]);
    let sdk = find_winsdk_lib_root();
    if sdk == null {
        println("FAIL: no Windows SDK");
        return 1;
    }
    println("sdk: " + sdk);
    let llvm = find_llvm_lib_dir();
    println("llvm: " + llvm);
    let rt = find_runtime_staticlib();
    if rt == null {
        println("FAIL: no runtime staticlib");
        return 1;
    }
    println("staticlib: " + rt);
    println("6.1: linking inputs resolved (full corpus gate: selfhost_native_parity.sh)");
    return 0;
}
