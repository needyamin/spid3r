// selfhost/llvm.matrix — the LLVM-C extern surface (roadmap Phase 5, step
// 5.1, docs/SELFHOST.md SH-7).
//
// The exact LLVM C API subset the codegen (selfhost/codegen.matrix) drives,
// declared through the Phase-0 ptr/usize boundary (SH-7). The oracle's
// inkwell bindings resolve these same symbols from LLVM-C.lib — which
// `spid3r build` already puts on every built executable's link line
// (docs/BUILDING.md; src/native/link.rs passes LLVM-C.lib + /DELAYLOAD).
//
// Type mapping (docs/FFI.md, the Phase-0 contract):
//   LLVM pointer handles  -> ptr     (opaque, i64-encoded handles)
//   C int / LLVMBool      -> int     (32-bit C ABI width; mask returns to 32
//                                    bits — the upper half of an i64 read of
//                                    a C `int` return is zero-extended by the
//                                    x86-64 `mov eax` write, but mask anyway)
//   C size_t / u64        -> usize
//   const char* params    -> string  (copied to a C buffer, freed after the
//                                    call)
//   const char* returns   -> string  (spid3r_value_from_cstr boxes the C
//                                    string into a Spid3r value; the buffer
//                                    is NOT freed — the callee may own it.
//                                    LLVM results disposed by
//                                    LLVMDisposeMessage leak into the
//                                    process arena: a compiler process exits
//                                    after emitting.)
//
// The runtime trampolines (src/native/rt.rs) ride the same extern surface:
// they live in the runtime staticlib linked into every built executable.

// ------------------------------------------------------------ LLVM core

public extern fn LLVMContextCreate() -> ptr;
public extern fn LLVMModuleCreateWithNameInContext(name: string, ctx: ptr) -> ptr;
public extern fn LLVMCreateBuilderInContext(ctx: ptr) -> ptr;
public extern fn LLVMDisposeModule(m: ptr);
public extern fn LLVMDisposeBuilder(b: ptr);
public extern fn LLVMContextDispose(c: ptr);

