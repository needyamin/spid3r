// selfhost/semantic.matrix — the Spid3r-written semantic checker
// (roadmap Phase 3, docs/SELFHOST.md SH-5).
//
// A port of src/semantic/mod.rs + ty.rs over the Phase-2 AST node model.
// Parity surfaces (all byte-for-byte against the stage-0 oracle):
//   * the first check diagnostic — `error[semantic]: msg` + span line — on
//     every corpus negative and fuzz case;
//   * the declaration registry JSON (`registry` mode here,
//     `check --dump-registry-json` in the oracle), on every corpus positive.
//
// Scoping decisions (ledger 2026-11-14, Phase 3):
//   * lint WARNINGS (unused-*, unreachable code, explicit main call) are not
//     ported — the Phase 3 gates gate ERRORS and the registry, not warnings;
//     pop_scope therefore just pops.
//   * module resolution covers the corpus's needs: sibling files and the
//     stdlib/ root; SPID3R_PATH roots are not followed (the parity runs
//     happen from the repo root).
//
// Types are tagged lists: ["Any"] ["Int"] ["Float"] ["Bool"] ["Str"] ["Null"]
// ["Coll", name, elem-or-null] ["Class", name] ["Interface", name]
// ["Nullable", inner] ["Union", members] ["Fn", sig-or-null]; a signature is
// [arity, min_arity, params, ret]. Deep == on lists is the type equality.

import "token";
import "ast";
import "lexer";
import "parser";
import "lexer_json";

// ------------------------------------------------------------- builtins

