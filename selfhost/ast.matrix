// selfhost/parser/ast.matrix — the AST model and its JSON serializer
// (roadmap Phase 2, docs/SELFHOST.md SH-3/SH-5).
//
// The parser builds positional node lists shaped like the stage-0 oracle's
// dump (src/oracle.rs program_to_json): a node is
//   [tag, field..., [line, col, len]]
// where `tag` is an internal name (distinct where the dump reuses one node
// name for two shapes: BlockStmt vs Block, If vs IfE, FieldDecl vs FieldE)
// and the trailing span triple is what the dump emits as line/col/len.
// The serializer below emits byte-identical JSON to the oracle; the parity
// harness diffs this output against `spid3r parse --dump-ast-json`.
//
// Serialization accumulates into a fragment list and joins once — immutable
// Spid3r strings make `+=` quadratic (Phase 1 finding, ledger).

import "token";

// ---------------------------------------------------------------- spans

// Span composition, ported 1:1 from src/parser/mod.rs `join`: a composite
// node runs from a's start to b's end; multi-line spans keep a's own length.
public fn join(a, b) {
    if b[0] >= a[0] {
        let end_col = b[1] + b[2];
        let len = end_col - a[1];
        if len < 1 {
            len = 1;
        }
        return [a[0], a[1], len];
    }
    let len = a[2];
    if len < 1 {
        len = 1;
    }
    return [a[0], a[1], len];
}

// The span of any node that carries one (the trailing triple).
public fn nsp(node) {
    return node[node.len() - 1];
}

// ---------------------------------------------------------- constructors

public fn n_import(path, alias, sp) {
    return ["Import", path, alias, sp];
}

public fn n_fn_stmt(f) {
    return ["Fn", f, nsp(f)];
}

public fn n_class(vis, name, is_abstract, abstracts, parent, interfaces, type_params, fields, methods, sp) {
    return ["Class", vis, name, is_abstract, abstracts, parent, interfaces, type_params, fields, methods, sp];
}

