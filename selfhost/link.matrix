// selfhost/link.matrix — the build driver's linking half
// (roadmap Phase 6, step 6.1, docs/SELFHOST.md SH-6).
//
// A port of src/native/link.rs's Windows path: MSVC/SDK/staticlib discovery
// and the link.exe invocation. The oracle's argument set (link_windows) is
// reproduced exactly — the driver links the emitted object with the runtime
// staticlib, LLVM-C (delay-loaded), and the CRT into a standalone executable.
//
// The codegen half (parse → check → lower → LLVM-C codegen → object) is
// Phase 5.2's scope; this module provides the linking that Phase 7's
// bootstrap needs to produce a compiler executable from its own object.
//
// Process spawning uses the runtime's spawn_process native (a capability-
// gated stdlib builtin — the same funnel the interpreter and VM install).

// The MSVC CRT + Windows SDK + linker discovery, ported from vs_roots() +
// winsdk_lib_root(). Both search the standard installation roots in the
// oracle's order and take the newest version.

public fn find_msvc_link_exe() {
    // vs_roots: Program Files + Program Files (x86), BuildTools/VC/Tools/MSVC,
    // newest version last. Then bin/HostX64/x64/link.exe.
    let roots = [];
    let bases = ["C:/Program Files/Microsoft Visual Studio",
    "C:/Program Files (x86)/Microsoft Visual Studio"];
    for base in bases {
        if not is_dir(base) {
            continue;
        }
        let lr = list_dir(base);
        if lr.is_err() {
            continue;
        }
        let entries = lr.unwrap();
        for e in entries {
            let vc = base + "/" + e + "/BuildTools/VC/Tools/MSVC";
            if not is_dir(vc) {
                continue;
            }
            let vr = list_dir(vc);
            if vr.is_err() {
                continue;
            }
            let versions = vr.unwrap();
            // newest last (lexicographic sort like the oracle's dirs.sort())
            versions.sort();
            if versions.len() > 0 {
                roots.push(vc + "/" + versions[versions.len() - 1]);
            }
        }
    }
    // Search roots for bin/HostX64/x64/link.exe (newest MSVC first).
    let i = roots.len() - 1;
    while i >= 0 {
        let cand = roots[i] + "/bin/HostX64/x64/link.exe";
        if file_exists(cand) {
            let libdir = roots[i] + "/lib/x64";
            return [cand, libdir];
        }
        i -= 1;
    }
    return [null, null];
}

public fn find_winsdk_lib_root() {
    // winsdk_lib_root: C:/Program Files (x86)/Windows Kits/10/Lib, newest last.
    let base = "C:/Program Files (x86)/Windows Kits/10/Lib";
    if not is_dir(base) {
        return null;
    }
    let vr = list_dir(base);
    if vr.is_err() {
        return null;
    }
    let versions = vr.unwrap();
    versions.sort();
    if versions.len() > 0 {
        return base + "/" + versions[versions.len() - 1];
    }
    return null;
}

// find_llvm_lib_dir: the LLVM-C import library directory, mirroring
// build.rs's search order (SPID3R_LLVM_LIB_DIR → LLVM_SYS_231_PREFIX →
// C:/LLVM-23/lib → C:/Program Files/LLVM/lib).
public fn find_llvm_lib_dir() {
    let env_opt = env("SPID3R_LLVM_LIB_DIR");
    if env_opt.is_some() {
        let dir = env_opt.unwrap();
        if is_dir(dir) {
            return dir;
        }
    }
    let prefixes = ["C:/LLVM-23", "C:/Program Files/LLVM"];
    for p in prefixes {
        let lib = p + "/lib";
        if is_file(lib + "/LLVM-C.lib") {
            return lib;
        }
    }
    return null;
}

// find_staticlib: the runtime staticlib, mirroring src/native/mod.rs's
// search order (SPID3R_RUNTIME_LIB → SPID3R_LIB_DIR → exe dir → cwd →
// target/{debug,release}).
public fn find_runtime_staticlib() {
    let env_opt = env("SPID3R_RUNTIME_LIB");
    if env_opt.is_some() {
        let dir = env_opt.unwrap();
        if is_file(dir) {
            return dir;
        }
        if is_dir(dir) {
            for rname in ["spid3r_lang.lib", "libspid3r_lang.a", "spid3r.lib", "libspid3r.a"] {
                let rc = dir + "/" + rname;
                if is_file(rc) {
                    return rc;
                }
            }
        }
    }
    // The toolchain's own directory (developer layout: target/debug/spid3r.exe)
    let ep = exe_path();
    if ep.is_err() {
        return null;
    }
    let exe = ep.unwrap();
    let dir = link_dirname_of(exe);
    let cands = [dir + "/spid3r_lang.lib", dir + "/../../debug/spid3r_lang.lib",
    dir + "/../../release/spid3r_lang.lib"];
    for c in cands {
        if is_file(c) {
            return c;
        }
    }
    // Cargo target directories
    let profiles = ["debug", "release"];
    for prof in profiles {
        let c = "target/" + prof + "/spid3r_lang.lib";
        if is_file(c) {
            return c;
        }
    }
    return null;
}

// link_executable: build the MSVC link.exe argument set (the oracle's
// link_windows) and invoke it. The argument list is reproduced exactly:
// -nologo, -out, -subsystem:console, -nodefaultlib, obj, staticlib,
// LLVM-C libpath + delay-load, optimization flags, stack, CRT libs, system libs.
public fn link_executable(obj_path, out_path, staticlib_path) {
    let lr = find_msvc_link_exe();
    if lr[0] == null {
        eprint(
            "error[usage]: no MSVC linker (link.exe) found; install Visual Studio Build Tools (see docs/BUILDING.md)\n"
        );
        return 2;
    }
    // The oracle's diagnostics carry PathBuf-style backslash paths —
    // normalize the discovered roots so the wrapper text matches.
    let link_exe = lr[0].replace("/", "\\");
    let msvc_lib = lr[1].replace("/", "\\");
    let sdk = find_winsdk_lib_root();
    if sdk == null {
        eprint(
            "error[usage]: no Windows SDK found; install the Windows 10/11 SDK (see docs/BUILDING.md)\n"
        );
        return 2;
    }
    sdk = sdk.replace("/", "\\");
    let llvm_dir = find_llvm_lib_dir();
    if llvm_dir != null {
        llvm_dir = llvm_dir.replace("/", "\\");
    }

    let args = ["-nologo", "-out:" + out_path, "-subsystem:console",
    "-nodefaultlib", obj_path, staticlib_path];
    if msvc_lib != "" {
        args.push("-libpath:" + msvc_lib);
    }
    args.push("-libpath:" + sdk + "/ucrt/x64");
    args.push("-libpath:" + sdk + "/um/x64");
    if llvm_dir != null {
        args.push("-libpath:" + llvm_dir);
    }
    args.push("LLVM-C.lib");
    args.push("/DELAYLOAD:LLVM-C.dll");
    args.push("delayimp.lib");
    args.push("-ignore:4199");
    // Debug builds keep unreferenced symbols (-opt:noref); release strips.
    args.push("-opt:noref,noicf");
    args.push("-stack:4194304");
    // Static CRT (matching the staticlib's build — .cargo/config.toml)
    for l in ["libcmt.lib", "libvcruntime.lib", "libucrt.lib",
    "kernel32.lib", "ntdll.lib", "userenv.lib",
    "ws2_32.lib", "dbghelp.lib", "advapi32.lib"] {
        args.push(l);
    }
    // Windows resource metadata (the oracle's compile_windows_resources):
    // application manifest + product icon + VERSIONINFO, compiled by rc.exe
    // and linked LAST, exactly where link_windows appends its .res file.
    let res_file = link_compile_resources(out_path, sdk);
    if res_file != null {
        args.push(res_file);
    }
    // exec_capture reproduces the oracle's run_linker exactly: the linker's
    // stdout/stderr are captured and, on failure, re-printed under the
    // error[usage] wrapper in the same wrapper-then-output order (a failed
    // spawn is a result, not a throw).
    let r = exec_capture(link_exe, args, null);
    // The .res is a per-build intermediate (the oracle's scratch dir is
    // dropped after the build); remove it whatever the link outcome.
    if res_file != null {
        remove_file(res_file);
    }
    if r.is_err() {
        eprint("error[usage]: cannot run the linker '" + link_exe + "'\n");
        return 2;
    }
    let out = r.unwrap();
    if out["code"] != 0 {
        let so = out["stdout"].trim();
        let se = out["stderr"].trim();
        let msg = "error[usage]: linking failed (" + link_exe + "):\n" + so;
        if se != "" {
            msg = msg + "\n" + se;
        }
        eprint(msg + "\n");
        return 2;
    }
    return 0;
}

fn link_dirname_of(s) {
    let cut = -1;
    let i = 0;
    let n = s.len();
    while i < n {
        let cp = ord(s[i]);
        if cp == 47 or cp == 92 {
            cut = i;
        }
        i += 1;
    }
    if cut >= 0 {
        return s.slice(0, cut + 1);
    }
    return "";
}

// ---------------------------------------------------------------------------
// Windows resource metadata — port of link.rs compile_windows_resources,
// rc_escape and default_icon (roadmap 6.1's "checksum/metadata steps").
// Every executable the oracle links carries an application manifest
// (DPI/long-path/UTF-8 code page/supportedOS), the product icon (when one is
// found) and a VERSIONINFO block; without this step a selfhost-built
// executable has none of them. Failure to embed is silent unless an icon was
// explicitly requested (the selfhost CLI has no --icon/--version/--product-name
// flags, so the oracle's defaults apply: version 1.0.0, product = file stem).
// ---------------------------------------------------------------------------

// rc_escape: quote and backslash are escaped, control characters become a
// space (a quote or newline would end the RC string and start a directive).
fn link_rc_escape(s) {
    let frags = [];
    let i = 0;
    let n = s.len();
    while i < n {
        let c = s[i];
        let cp = ord(c);
        if c == "\"" {
            frags.push("\\\"");
        } else if c == "\\" {
            frags.push("\\\\");
        } else if cp < 32 or (cp >= 127 and cp <= 159) {
            frags.push(" ");
        } else {
            frags.push(c);
        }
        i += 1;
    }
    return frags.join("");
}

// The output's file stem (Path::file_stem): the basename minus its last
// extension; a leading dot is not an extension.
fn link_file_stem(p) {
    let base = p;
    let n = p.len();
    let i = n - 1;
    while i >= 0 {
        let cp = ord(p[i]);
        if cp == 47 or cp == 92 {
            base = p.slice(i + 1, n);
            break;
        }
        i -= 1;
    }
    let dot = -1;
    let j = 0;
    let m = base.len();
    while j < m {
        if base[j] == "." {
            dot = j;
        }
        j += 1;
    }
    if dot > 0 {
        return base.slice(0, dot);
    }
    return base;
}

// default_icon: SPID3R_ICON, then spid3r.ico next to the running toolchain
// executable, then the developer layout packaging/nsis/assets/spid3r.ico.
fn link_default_icon() {
    let cands = [];
    let ev = env("SPID3R_ICON");
    if ev.is_some() {
        cands.push(ev.unwrap());
    }
    let ep = exe_path();
    if ep.is_ok() {
        cands.push(link_dirname_of(ep.unwrap()) + "spid3r.ico");
    }
    cands.push("packaging/nsis/assets/spid3r.ico");
    for c in cands {
        if is_file(c) {
            return c;
        }
    }
    return null;
}

// An absolute, forward-slash form of a path for the .rc file (the oracle
// canonicalizes; a relative path is anchored at the working directory).
fn link_abs_fwd(p) {
    let q = p.replace("\\", "/");
    let drive = q.len() >= 2 and q[1] == ":";
    if q.len() > 0 and (q[0] == "/" or drive) {
        return q;
    }
    let cr = cwd();
    if cr.is_err() {
        return q;
    }
    return cr.unwrap().replace("\\", "/") + "/" + q;
}

// compile_windows_resources: returns the path of the compiled .res, or null
// when rc.exe is unavailable or rejects the script (silent, as in the oracle
// when no icon was explicitly requested). `sdk` is Windows Kits/10/Lib/<ver>.
fn link_compile_resources(out_path, sdk) {
    let sdk_f = sdk.replace("\\", "/");
    let k = sdk_f.len() - 1;
    let last_slash = -1;
    while k >= 0 {
        if sdk_f[k] == "/" {
            last_slash = k;
            break;
        }
        k -= 1;
    }
    if last_slash < 0 {
        return null;
    }
    let ver = sdk_f.slice(last_slash + 1, sdk_f.len());
    let kits_lib = sdk_f.slice(0, last_slash);
    let kits_lib_cut = -1;
    let k2 = kits_lib.len() - 1;
    while k2 >= 0 {
        if kits_lib[k2] == "/" {
            kits_lib_cut = k2;
            break;
        }
        k2 -= 1;
    }
    if kits_lib_cut < 0 {
        return null;
    }
    let kits = kits_lib.slice(0, kits_lib_cut);
    let rc_exe = kits + "/bin/" + ver + "/x64/rc.exe";
    if not is_file(rc_exe) {
        return null;
    }
    let stem = link_file_stem(out_path);
    if stem == "" {
        stem = "app";
    }
    let dir = link_dirname_of(out_path);
    let manifest_path = dir + "spid3r_manifest_" + stem + ".manifest";
    let rc_path = dir + "spid3r_res_" + stem + ".rc";
    let res_path = dir + "spid3r_res_" + stem + ".res";

    // The manifest: byte-for-byte the oracle's manifest_content.
    let manifest = ["<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>",
    "<assembly xmlns=\"urn:schemas-microsoft-com:asm.v1\" manifestVersion=\"1.0\">",
    "  <application xmlns=\"urn:schemas-microsoft-com:asm.v3\">",
    "    <windowsSettings>",
    "      <dpiAware xmlns=\"http://schemas.microsoft.com/SMI/2005/WindowsSettings\">true/pm</dpiAware>",
    "      <dpiAwareness xmlns=\"http://schemas.microsoft.com/SMI/2016/WindowsSettings\">PerMonitorV2, PerMonitor</dpiAwareness>",
    "      <longPathAware xmlns=\"http://schemas.microsoft.com/SMI/2016/WindowsSettings\">true</longPathAware>",
    "      <activeCodePage xmlns=\"http://schemas.microsoft.com/SMI/2019/WindowsSettings\">UTF-8</activeCodePage>",
    "    </windowsSettings>",
    "  </application>",
    "  <compatibility xmlns=\"urn:schemas-microsoft-com:compatibility.v1\">",
    "    <application>",
    "      <supportedOS Id=\"{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}\"/>",
    "      <supportedOS Id=\"{1f676c76-80e1-4239-95bb-83d0f6d0da78}\"/>",
    "      <supportedOS Id=\"{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}\"/>",
    "      <supportedOS Id=\"{35138b9a-5d96-4fbd-8e2d-a2440225f93a}\"/>",
    "    </application>",
    "  </compatibility>",
    "</assembly>"];
    let mw = write_file(manifest_path, manifest.join("\n"));
    if mw.is_err() {
        return null;
    }

    let rc_lines = ["1 24 \"" + manifest_path.replace("\\", "/") + "\"\n"];
    let ico = link_default_icon();
    if ico != null {
        rc_lines.push("1 ICON \"" + link_abs_fwd(ico) + "\"\n");
    }
    // Default metadata (no --version / --product-name in the selfhost CLI):
    // version 1.0.0 -> 1,0,0,0; product name = the output's file stem.
    let prod_name = link_rc_escape(stem);
    let ver_str = "1.0.0";
    let v = "1,0,0,0";
    let vd = "1.0.0.0";
    rc_lines.push(
        "1 VERSIONINFO\nFILEVERSION " + v + "\nPRODUCTVERSION " + v
        + "\nFILEFLAGSMASK 0x3fL\nFILEFLAGS 0x0L\nFILEOS 0x40004L\nFILETYPE 0x1L\nFILESUBTYPE 0x0L\nBEGIN\n"
        + "    BLOCK \"StringFileInfo\"\n    BEGIN\n        BLOCK \"040904b0\"\n        BEGIN\n"
        + "            VALUE \"FileDescription\", \"" + prod_name + "\"\n"
        + "            VALUE \"FileVersion\", \"" + vd + "\"\n"
        + "            VALUE \"InternalName\", \"" + stem + "\"\n"
        + "            VALUE \"OriginalFilename\", \"" + stem + ".exe\"\n"
        + "            VALUE \"ProductName\", \"" + prod_name + "\"\n"
        + "            VALUE \"ProductVersion\", \"" + ver_str + "\"\n"
        + "        END\n    END\n    BLOCK \"VarFileInfo\"\n    BEGIN\n"
        + "        VALUE \"Translation\", 0x409, 1200\n    END\nEND\n"
    );
    let rw = write_file(rc_path, rc_lines.join(""));
    if rw.is_err() {
        remove_file(manifest_path);
        return null;
    }
    let r = exec_capture(
        rc_exe.replace("/", "\\"),
        ["/nologo",
        "/fo",
        res_path,
        rc_path],
        null
    );
    remove_file(manifest_path);
    remove_file(rc_path);
    if r.is_ok() and r.unwrap()["code"] == 0 and is_file(res_path) {
        return res_path;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Runtime artifact formalization & SHA-256 pin verification (Phase 9.1, SH-6)
// Consumes runtime-manifest.json / <lib>.manifest.json / <lib>.sha256 /
// SPID3R_RUNTIME_MANIFEST / SPID3R_RUNTIME_SHA256 / SPID3R_RUNTIME_REQUIRE_PIN
// and verifies SHA-256 integrity before invoking the system linker (SEC-B:
// exit 4 on tampered/corrupt/conflicting pins; never links tampered code).
// ---------------------------------------------------------------------------

fn link_ends_with(s, suf) {
    let n = s.len();
    let m = suf.len();
    if m > n {
        return false;
    }
    return s.slice(n - m, n) == suf;
}

fn link_lower_ascii(s) {
    let frags = [];
    let i = 0;
    let n = s.len();
    while i < n {
        let c = s[i];
        let cp = ord(c);
        if cp >= 65 and cp <= 90 {
            frags.push(chr(cp + 32));
        } else {
            frags.push(c);
        }
        i += 1;
    }
    return frags.join("");
}

fn link_norm_hex64(s) {
    if type_of(s) != "string" {
        return null;
    }
    let t = s.trim();
    if t.len() != 64 {
        return null;
    }
    let frags = [];
    let i = 0;
    while i < 64 {
        let c = t[i];
        let cp = ord(c);
        if cp >= 48 and cp <= 57 {
            frags.push(c);
        } else if cp >= 97 and cp <= 102 {
            frags.push(c);
        } else if cp >= 65 and cp <= 70 {
            frags.push(chr(cp + 32));
        } else {
            return null;
        }
        i += 1;
    }
    return frags.join("");
}

fn link_basename(p) {
    let n = p.len();
    let i = n - 1;
    while i >= 0 {
        let cp = ord(p[i]);
        if cp == 47 or cp == 92 {
            return p.slice(i + 1, n);
        }
        i -= 1;
    }
    return p;
}

fn link_safe_filename(name) {
    if type_of(name) != "string" or name == "" {
        return false;
    }
    if name.contains("..") or name.contains("/") or name.contains("\\") or name.contains(":") {
        return false;
    }
    return true;
}

fn link_env_truthy(name) {
    let v = env(name);
    if v.is_none() {
        return false;
    }
    let s = link_lower_ascii(v.unwrap().trim());
    return s == "1" or s == "true" or s == "yes";
}

// Parse `<64-hex>  <filename>` / `<64-hex> *<filename>` / `<64-hex>`.
// Returns [rc, hex_lower, filename_or_null] where rc == 0 (ok) or 4 (corrupt).
fn link_parse_sha256_file(path, expected_base) {
    let r = read_file(path);
    if r.is_err() {
        eprint("error[corrupt]: cannot read runtime checksum file '" + path + "'\n");
        return [4, null, null];
    }
    let raw = r.unwrap();
    let lines = raw.split("\n");
    let first = "";
    for ln in lines {
        let t = ln.trim();
        if t != "" {
            first = t;
            break;
        }
    }
    if first == "" or first.len() < 64 {
        eprint("error[corrupt]: malformed runtime checksum file '" + path + "'\n");
        return [4, null, null];
    }
    let hex_part = link_norm_hex64(first.slice(0, 64));
    if hex_part == null {
        eprint("error[corrupt]: malformed SHA-256 digest in '" + path + "'\n");
        return [4, null, null];
    }
    let fname = null;
    if first.len() > 64 {
        let sep = first[64];
        if sep != " " and sep != "\t" {
            eprint("error[corrupt]: malformed runtime checksum entry in '" + path + "'\n");
            return [4, null, null];
        }
        let rest = first.slice(64, first.len()).trim();
        if rest.len() > 0 and rest[0] == "*" {
            rest = rest.slice(1, rest.len()).trim();
        }
        if rest != "" {
            fname = link_basename(rest);
            if expected_base != null and fname != expected_base {
                eprint(
                    "error[corrupt]: runtime checksum file '" + path + "' names '" + fname + "' instead of '" + expected_base + "'\n"
                );
                return [4, null, null];
            }
        }
    }
    return [0, hex_part, fname];
}

// Load and validate schema-1 runtime-manifest.json.
// Returns [rc, manifest_map, hex_lower] where rc == 0 (ok) or 4 (corrupt).
fn link_load_runtime_manifest(mpath) {
    if not file_exists(mpath) {
        eprint("error[corrupt]: runtime manifest not found: '" + mpath + "'\n");
        return [4, null, null];
    }
    let r = read_file(mpath);
    if r.is_err() {
        eprint("error[corrupt]: cannot read runtime manifest '" + mpath + "'\n");
        return [4, null, null];
    }
    let m = null;
    try {
        m = json_parse(r.unwrap());
    } catch (e) {
        eprint("error[corrupt]: malformed runtime manifest JSON in '" + mpath + "'\n");
        return [4, null, null];
    }
    if type_of(m) != "map" {
        eprint("error[corrupt]: runtime manifest must be a JSON object: '" + mpath + "'\n");
        return [4, null, null];
    }
    if not m.has("schema") or m["schema"] != 1 {
        eprint("error[corrupt]: unsupported or missing runtime manifest schema in '" + mpath + "'\n");
        return [4, null, null];
    }
    if not m.has("version") or type_of(m["version"]) != "string" or m["version"].trim() == "" {
        eprint("error[corrupt]: runtime manifest missing version in '" + mpath + "'\n");
        return [4, null, null];
    }
    if not m.has("staticlib_name") or not link_safe_filename(m["staticlib_name"]) {
        eprint("error[corrupt]: runtime manifest has invalid staticlib_name in '" + mpath + "'\n");
        return [4, null, null];
    }
    if not m.has("staticlib_sha256") {
        eprint("error[corrupt]: runtime manifest missing staticlib_sha256 in '" + mpath + "'\n");
        return [4, null, null];
    }
    let hex_pin = link_norm_hex64(m["staticlib_sha256"]);
    if hex_pin == null {
        eprint("error[corrupt]: runtime manifest has invalid staticlib_sha256 in '" + mpath + "'\n");
        return [4, null, null];
    }
    if not m.has("provenance") or type_of(m["provenance"]) != "map" {
        eprint("error[corrupt]: runtime manifest missing provenance in '" + mpath + "'\n");
        return [4, null, null];
    }
    let prov = m["provenance"];
    if not prov.has("git_commit") or type_of(prov["git_commit"]) != "string" or prov["git_commit"].trim() == "" {
        eprint("error[corrupt]: runtime manifest missing provenance.git_commit in '" + mpath + "'\n");
        return [4, null, null];
    }
    if not prov.has("llvm_version") or type_of(prov["llvm_version"]) != "string" or prov["llvm_version"].trim() == "" {
        eprint(
            "error[corrupt]: runtime manifest missing provenance.llvm_version in '" + mpath + "'\n"
        );
        return [4, null, null];
    }
    return [0, m, hex_pin];
}

// Core verifier given optional explicit manifest path and optional explicit lib path.
// Returns [rc, sl_path, expected_hex, manifest_map].
fn link_verify_runtime_internal(explicit_manifest, explicit_lib) {
    let manifest_map = null;
    let expected_hex = null;
    let sl = explicit_lib;

    let env_manifest = env("SPID3R_RUNTIME_MANIFEST");
    if explicit_manifest == null and env_manifest.is_some() {
        let em = env_manifest.unwrap().trim();
        if em != "" {
            explicit_manifest = em;
        }
    }

    if explicit_manifest != null {
        let mr = link_load_runtime_manifest(explicit_manifest);
        if mr[0] != 0 {
            return [mr[0], null, null, null];
        }
        manifest_map = mr[1];
        expected_hex = mr[2];
        if sl == null {
            let env_lib = env("SPID3R_RUNTIME_LIB");
            if env_lib.is_some() and env_lib.unwrap().trim() != "" {
                sl = env_lib.unwrap().trim();
            } else {
                sl = link_dirname_of(explicit_manifest) + manifest_map["staticlib_name"];
            }
        }
        if not is_file(sl) {
            eprint("error[usage]: pinned runtime staticlib '" + sl + "' was not found\n");
            return [2, null, null, manifest_map];
        }
        if link_basename(sl) != manifest_map["staticlib_name"] {
            eprint(
                "error[corrupt]: runtime staticlib filename '" + link_basename(sl) + "' does not match manifest '" + manifest_map["staticlib_name"] + "'\n"
            );
            return [4, null, null, manifest_map];
        }
    } else {
        if sl == null {
            sl = find_runtime_staticlib();
        }
        if sl == null or not is_file(sl) {
            eprint("error[build]: the runtime staticlib (spid3r_lang.lib) was not found\n");
            return [1, null, null, null];
        }
        let sdir = link_dirname_of(sl);
        let sbase = link_basename(sl);
        let sidecar_m = sl + ".manifest.json";
        let dir_m = sdir + "runtime-manifest.json";
        if is_file(sidecar_m) {
            let mr2 = link_load_runtime_manifest(sidecar_m);
            if mr2[0] != 0 {
                return [mr2[0], null, null, null];
            }
            if mr2[1]["staticlib_name"] != sbase {
                eprint(
                    "error[corrupt]: sidecar manifest '" + sidecar_m + "' names '" + mr2[1]["staticlib_name"] + "' instead of '" + sbase + "'\n"
                );
                return [4, null, null, null];
            }
            manifest_map = mr2[1];
            expected_hex = mr2[2];
        } else if is_file(dir_m) {
            let mr3 = link_load_runtime_manifest(dir_m);
            if mr3[0] != 0 {
                return [mr3[0], null, null, null];
            }
            if mr3[1]["staticlib_name"] == sbase {
                manifest_map = mr3[1];
                expected_hex = mr3[2];
            }
        }
    }

    // Check sidecar <sl>.sha256 if present.
    let sha_sidecar = sl + ".sha256";
    if is_file(sha_sidecar) {
        let sr = link_parse_sha256_file(sha_sidecar, link_basename(sl));
        if sr[0] != 0 {
            return [sr[0], null, null, manifest_map];
        }
        if expected_hex != null and expected_hex != sr[1] {
            eprint(
                "error[corrupt]: runtime checksum pin conflict between manifest and '" + sha_sidecar + "'\n"
            );
            return [4, null, null, manifest_map];
        }
        expected_hex = sr[1];
    }

    // Check explicit SPID3R_RUNTIME_SHA256 pin if set.
    let env_sha = env("SPID3R_RUNTIME_SHA256");
    if env_sha.is_some() {
        let es = env_sha.unwrap().trim();
        if es != "" {
            let norm_env = link_norm_hex64(es);
            if norm_env == null {
                eprint("error[corrupt]: invalid SPID3R_RUNTIME_SHA256 (expected 64 hex chars)\n");
                return [4, null, null, manifest_map];
            }
            if expected_hex != null and expected_hex != norm_env {
                eprint("error[corrupt]: runtime checksum pin conflict with SPID3R_RUNTIME_SHA256\n");
                return [4, null, null, manifest_map];
            }
            expected_hex = norm_env;
        }
    }

    if expected_hex == null {
        if link_env_truthy("SPID3R_RUNTIME_REQUIRE_PIN") {
            eprint(
                "error[corrupt]: runtime staticlib '" + sl + "' has no SHA-256 pin (SPID3R_RUNTIME_REQUIRE_PIN)\n"
            );
            return [4, null, null, manifest_map];
        }
        return [0, sl, null, manifest_map];
    }

    let br = read_bytes(sl);
    if br.is_err() {
        eprint("error[corrupt]: cannot read runtime staticlib '" + sl + "' for integrity check\n");
        return [4, null, null, manifest_map];
    }
    let actual_hex = link_lower_ascii(sha256(br.unwrap()));
    if actual_hex != expected_hex {
        eprint(
            "error[corrupt]: runtime staticlib integrity check failed for '" + sl + "': expected " + expected_hex + ", got " + actual_hex + "\n"
        );
        return [4, null, null, manifest_map];
    }
    return [0, sl, actual_hex, manifest_map];
}

// Resolve the runtime staticlib and enforce any SHA-256 pin/manifest before linking.
// Returns [rc, staticlib_path].
public fn resolve_and_verify_runtime_staticlib() {
    let r = link_verify_runtime_internal(null, null);
    return [r[0], r[1]];
}

// CLI subcommand: `verify-runtime [<dir_or_manifest_or_staticlib>]`
public fn link_cli_verify_runtime(cli_args) {
    if cli_args.len() > 1 {
        eprint("usage: main verify-runtime [<dir_or_manifest_or_staticlib>]\n");
        return 2;
    }
    let em = null;
    let el = null;
    if cli_args.len() == 1 {
        let target = cli_args[0];
        if is_dir(target) {
            em = target + "/runtime-manifest.json";
        } else if link_ends_with(target, ".json") {
            em = target;
        } else if is_file(target) {
            el = target;
        } else {
            eprint("error[usage]: runtime artifact path not found: '" + target + "'\n");
            return 2;
        }
    }
    let r = link_verify_runtime_internal(em, el);
    if r[0] != 0 {
        return r[0];
    }
    let sl = r[1];
    let hex_ok = r[2];
    let m = r[3];
    if hex_ok == null {
        eprint("error[corrupt]: runtime staticlib '" + sl + "' has no SHA-256 pin to verify\n");
        return 4;
    }
    if m != null {
        let p = m["provenance"];
        println(
            "verified runtime staticlib: " + sl + " (sha256=" + hex_ok + ", version=" + m["version"] + ", commit=" + p["git_commit"] + ", llvm=" + p["llvm_version"] + ")"
        );
    } else {
        println("verified runtime staticlib: " + sl + " (sha256=" + hex_ok + ")");
    }
    return 0;
}
