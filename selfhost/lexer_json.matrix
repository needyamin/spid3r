// selfhost/lexer/json.matrix — the token-stream JSON serializer (Phase 1).
//
// Byte-identical twin of src/oracle.rs tokens_to_json: same field order
// (kind, payload, line, col, len), same escaping, same trailing newline.
// The parity harness diffs this output against `spid3r tokens --json`.
//
// PERF NOTE (W-program discipline, measured 2026-11-14): Spid3r strings are
// immutable, so `out += piece` on a growing JSON buffer is quadratic — a
// 250KB corpus file took 72s to serialize and exhausted memory at 1MB. All
// emitters here therefore accumulate into a fragment LIST and join once at
// the end, which is linear. The parity contract (byte-identical output) is
// unchanged; only the accumulation strategy differs from a naive port.

import "token";

// Accumulator: fragments joined at the end. Every emitter appends here.
let OUT = [];

fn emit(s) {
    OUT.push(s);
}

fn emit_int(v) {
    OUT.push(string(v));
}

fn joined() {
    return OUT.join("");
}

public fn tokens_json(file, toks) {
    let out = [
        "{\"file\":" + jstr(file) + ",\"count\":" + string(toks.len()) + ",\"tokens\":["
    ];
    let n = toks.len();
    let i = 0;
    while i < n {
        let t = toks[i];
        let kind = t[0];
        let pfx = "{\"kind\":\"";
        if i > 0 {
            pfx = ",{\"kind\":\"";
        }
        let name = KIND_NAMES[kind];
        let tail = ",\"line\":" + string(t[2]) + ",\"col\":" + string(t[3]) + ",\"len\":" + string(t[4]) + "}";
        if kind == K_IDENT or kind == K_KW {
            out.push(pfx + name + "\",\"value\":\"" + t[1] + "\"" + tail);
        } else if kind == K_INT {
            out.push(pfx + name + "\",\"value\":" + string(t[1]) + tail);
        } else if kind == K_STR or kind == K_BIGINT {
            out.push(pfx + name + "\",\"value\":" + jstr(t[1]) + tail);
        } else if kind == K_FLOAT {
            out.push(pfx + name + "\",\"value\":" + rust_float(t[1]) + tail);
        } else if kind == K_INTERP {
            OUT = [];
            pieces_json(t[1]);
            out.push(pfx + name + "\",\"pieces\":" + OUT.join("") + tail);
        } else {
            out.push(pfx + name + "\"" + tail);
        }
        i += 1;
    }
    out.push("]}\n");
    return out.join("");
}

fn pieces_json(pieces) {
    emit("[");
    let n = pieces.len();
    let i = 0;
    while i < n {
        if i > 0 {
            emit(",");
        }
        let p = pieces[i];
        if p[0] == "lit" {
            emit("{\"lit\":");
            emit(jstr(p[1]));
            emit("}");
        } else if p[0] == "path" {
            emit("{\"path\":[");
            let m = p[1].len();
            let j = 0;
            while j < m {
                if j > 0 {
                    emit(",");
                }
                emit(jstr(p[1][j]));
                j += 1;
            }
            emit("]}");
        } else {
            emit("{\"hole\":");
            emit(jstr(p[1]));
            emit("}");
        }
        i += 1;
    }
    emit("]");
}
