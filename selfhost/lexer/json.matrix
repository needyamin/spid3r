// selfhost/lexer/json.matrix — the token-stream JSON serializer (Phase 1).
//
// Byte-identical twin of src/oracle.rs tokens_to_json: same field order
// (kind, payload, line, col, len), same escaping, same trailing newline.
// The parity harness diffs this output against `spid3r tokens --json`.
//
// PERF NOTE (W-program discipline, measured 2026-11-14): Spid3r strings are
// immutable, so `out += piece` on a growing JSON buffer is quadratic — a
// 250KB corpus file took 72s to serialize and exhausted memory at 1MB. All
// emitters here therefore accumulate into a fragment LIST and join once at
// the end, which is linear. The parity contract (byte-identical output) is
// unchanged; only the accumulation strategy differs from a naive port.

import "token";

// Accumulator: fragments joined at the end. Every emitter appends here.
let OUT = [];

fn emit(s) {
    OUT.push(s);
}

fn emit_int(v) {
    OUT.push(string(v));
}

fn joined() {
    return OUT.join("");
}

public fn tokens_json(file, toks) {
    OUT = [];
    emit("{\"file\":");
    emit(jstr(file));
    emit(",\"count\":");
    emit_int(toks.len());
    emit(",\"tokens\":[");
    let n = toks.len();
    let i = 0;
    while i < n {
        if i > 0 {
            emit(",");
        }
        token_json(toks[i]);
        i += 1;
    }
    emit("]}\n");
    return joined();
}

fn token_json(t) {
    let kind = t[0];
    let name = kind_name(kind);
    emit("{\"kind\":\"");
    emit(name);
    emit("\"");
    if kind == K_INT {
        emit(",\"value\":");
        emit_int(t[1]);
    } else if kind == K_BIGINT {
        emit(",\"value\":");
        emit(jstr(t[1]));
    } else if kind == K_FLOAT {
        emit(",\"value\":");
        emit(rust_float(t[1]));
    } else if kind == K_STR {
        emit(",\"value\":");
        emit(jstr(t[1]));
    } else if kind == K_IDENT {
        emit(",\"value\":");
        emit(jstr(t[1]));
    } else if kind == K_KW {
        emit(",\"value\":");
        emit(jstr(t[1]));
    } else if kind == K_INTERP {
        emit(",\"pieces\":");
        pieces_json(t[1]);
    }
    // IntMinMagnitude and the punctuation kinds carry no payload, matching
    // the oracle's token_json.
    emit(",\"line\":");
    emit_int(t[2]);
    emit(",\"col\":");
    emit_int(t[3]);
    emit(",\"len\":");
    emit_int(t[4]);
    emit("}");
}

fn pieces_json(pieces) {
    emit("[");
    let n = pieces.len();
    let i = 0;
    while i < n {
        if i > 0 {
            emit(",");
        }
        let p = pieces[i];
        if p[0] == "lit" {
            emit("{\"lit\":");
            emit(jstr(p[1]));
            emit("}");
        } else if p[0] == "path" {
            emit("{\"path\":[");
            let m = p[1].len();
            let j = 0;
            while j < m {
                if j > 0 {
                    emit(",");
                }
                emit(jstr(p[1][j]));
                j += 1;
            }
            emit("]}");
        } else {
            emit("{\"hole\":");
            emit(jstr(p[1]));
            emit("}");
        }
        i += 1;
    }
    emit("]");
}
