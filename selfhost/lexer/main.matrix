// selfhost/lexer/main.matrix — the self-host lexer's entry point (Phase 1).
//
// Usage: spid3r run selfhost/lexer/main.matrix <file.matrix>
// (AOT: spid3r build selfhost/lexer/main.matrix -o lexer-self)
//
// Stdout: the token-stream JSON, byte-identical to `spid3r tokens <file>
// --json` on the frozen corpus. On a lexical error, stderr carries the
// oracle's diagnostic shape (`error[lexer]: msg` + `  --> file:line:col`)
// and the process exits 1. Usage problems exit 2.
//
// The caret/gutter decoration the oracle prints after the span line is a
// documented non-parity decoration (the engine contract lets decoration
// differ; the phase label, message and span must not).

import "token";
import "lexer";
import "json";

fn main() {
    let a = args();
    if a.len() != 1 {
        eprint("usage: lexer <file.matrix>\n");
        return 2;
    }
    let path = a[0];
    if not file_exists(path) {
        eprint("error[usage]: usage error: '" + path + "' is not a file\n");
        return 2;
    }
    let r = read_file(path);
    if r.is_err() {
        eprint("error[usage]: usage error: cannot read '" + path + "'\n");
        return 2;
    }
    let src = r.unwrap();
    try {
        let toks = lex_all(src);
        print(tokens_json(path, toks));
        return 0;
    } catch (e) {
        eprint("error[lexer]: " + e[0] + "\n");
        eprint("  --> " + path + ":" + string(e[1]) + ":" + string(e[2]) + "\n");
        return 1;
    }
}
