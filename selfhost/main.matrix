// selfhost/main.matrix — the self-host toolchain entry point (Phases 1-2).
//
// The module search roots put the importer's directory first, and imports may
// not escape it ("../" is rejected), so the entry lives at selfhost/ and
// reaches the subsystem modules through nested specs ("lexer/lexer",
// "parser/parser").
//
// Modes (first argument):
//   tokens <file>  — the Phase-1 lexer parity surface: the token-stream JSON
//                    byte-identical to `spid3r tokens <file> --json`.
//   parse  <file>  — the Phase-2 parser parity surface: the AST JSON
//                    byte-identical to `spid3r parse <file> --dump-ast-json`.
//
// Diagnostics mirror the oracle: `error[lexer]: …` / `error[parser]: …` plus
// the `  --> file:line:col` span line on stderr, exit 1; usage errors exit 2.
// The caret/gutter decoration the oracle prints after the span line is a
// documented non-parity decoration.
//
// The lex-time `{expr}` capture validator (parser::hole_is_expression) is
// injected here, before any lexing, so the lexer's hole decisions match the
// oracle exactly.

import "token";
import "lexer";
import "lexer_json";
import "ast";
import "parser";
import "semantic";
import "lower";
import "vmc";
import "bytecode_matrix";
import "codegen";
import "link";

fn main() {
    set_hole_check(hole_check);
    let a = args();
    if a.len() < 2 or a.len() > 3 {
        eprint("usage: main tokens|parse|check|registry|lowered|compile|native <file.matrix> [out]\n");
        return 2;
    }
    let mode = a[0];
    let path = a[1];
    if mode != "tokens" and mode != "parse" and mode != "check" and mode != "registry" and mode != "lowered" and mode != "compile" and mode != "native" {
        eprint("error[usage]: unknown mode '" + mode + "' (tokens|parse|check|registry|lowered|compile|native)\n");
        return 2;
    }
    if not file_exists(path) {
        eprint("error[usage]: usage error: '" + path + "' is not a file\n");
        return 2;
    }
    let r = read_file(path);
    if r.is_err() {
        eprint("error[usage]: usage error: cannot read '" + path + "'\n");
        return 2;
    }
    let src = r.unwrap();

    let toks = null;
    try {
        toks = lex_all(src);
    } catch (e) {
        let pth = path;
        if e.len() >= 6 {
            pth = e[5];
        }
        eprint("error[lexer]: " + e[0] + "\n");
        eprint("  --> " + pth + ":" + string(e[1]) + ":" + string(e[2]) + "\n");
        return 1;
    }

    if mode == "tokens" {
        print(tokens_json(path, toks));
        return 0;
    }

    let prog = null;
    try {
        let st = new_state(toks);
        prog = parse_program(st);
    } catch (e2) {
        // Compiler errors are [msg, line, col, len(, phase(, path))] lists —
        // an int line at [1] distinguishes them from bare-string runtime
        // errors (a char + int add throws).
        let is_list = false;
        try {
            let probe = e2[1] + 0;
            is_list = true;
        } catch (ignored) {
            is_list = false;
        }
        if not is_list {
            eprint("error[internal]: " + e2 + "\n");
            return 1;
        }
        let phase = "parser";
        if e2.len() >= 5 {
            phase = e2[4];
        }
        let pth = path;
        if e2.len() >= 6 {
            pth = e2[5];
        }
        eprint("error[" + phase + "]: " + e2[0] + "\n");
        eprint("  --> " + pth + ":" + string(e2[1]) + ":" + string(e2[2]) + "\n");
        return 1;
    }

    if mode == "parse" {
        print(program_to_json(path, prog));
        return 0;
    }

    if mode == "lowered" {
        // The oracle's --dump-lowered-json parses and lowers WITHOUT the
        // semantic check — the port matches that pipeline exactly.
        let lst = new_lower();
        let lowered = lower_program(lst, prog);
        print(program_to_json(path, lowered));
        return 0;
    }

    if mode == "compile" {
        // Phase 4.2/4.3: the bytecode compiler + the v3 checksummed container
        // writer. Oracle pipeline: parse -> check -> lower -> compile ->
        // serialize -> write. Byte-equality target: `spid3r compile <file>
        // -o <out> --no-opt` (the optimizer is Phase 11 P-3's scope).
        let has_main_c = false;
        for s in prog[0] {
            if s[0] == "Fn" and s[1][4] == "main" {
                has_main_c = true;
            }
        }
        let cst2 = new_checker(has_main_c, path);
        try {
            check_program(cst2, prog);
        } catch (e4) {
            let phase = "semantic";
            if e4.len() >= 5 {
                phase = e4[4];
            }
            eprint("error[" + phase + "]: " + msg_of(e4) + "
");
            if e4[1] >= 0 {
                eprint("  --> " + path + ":" + string(e4[1]) + ":" + string(e4[2]) + "
");
            }
            return 1;
        }
        let lst2 = new_lower();
        let lowered2 = lower_program(lst2, prog);
        let embedded = [];
        let keys = map();
        let in_progress = [path];
        let fr = compile_one(cst2, lowered2, path, embedded, keys, in_progress, true);
        let func = make_vmfunc(fr);
        let bytes_out = serialize_vmfunc(func);
        let argv = args();
        let out_path = path.slice(0, path.len() - 7) + ".matrixc";
        if argv.len() >= 3 {
            out_path = argv[2];
        }
        let wb = write_bytes(out_path, bytes_from_ints(bytes_out));
        if wb.is_err() {
            eprint("error[vm]: cannot write '" + out_path + "'
");
            return 1;
        }
        print("wrote " + out_path);
        return 0;
    }

    if mode == "native" {
        // Phase 5.2: the LLVM-C codegen. Oracle pipeline: parse -> check ->
        // lower -> build_module -> LLVMTargetMachineEmitToFile -> link (the
        // Phase-6.1 link.matrix argument set).
        let has_main_n = false;
        for s in prog[0] {
            if s[0] == "Fn" and s[1][4] == "main" {
                has_main_n = true;
            }
        }
        let cst3 = new_checker(has_main_n, path);
        try {
            check_program(cst3, prog);
        } catch (e5) {
            let phase = "semantic";
            if e5.len() >= 5 {
                phase = e5[4];
            }
            eprint("error[" + phase + "]: " + msg_of(e5) + "\n");
            if e5[1] >= 0 {
                eprint("  --> " + path + ":" + string(e5[1]) + ":" + string(e5[2]) + "\n");
            }
            let h5 = help_of(e5);
            if h5 != null {
                eprint("  = help: " + h5 + "\n");
            }
            return 1;
        }
        let lst3 = new_lower();
        let lowered3 = lower_program(lst3, prog);
        let cgst = new_codegen();
        try {
            cg_build_module(cgst, lowered3, path);
        } catch (e6) {
            // Compiler errors are [msg, line, col, len, phase] lists; runtime
            // errors are bare strings (an int line at [1] distinguishes them —
            // a char + int add throws).
            let is_list = false;
            try {
                let probe = e6[1] + 0;
                is_list = true;
            } catch (ignored) {
                is_list = false;
            }
            if is_list {
                eprint("error[" + e6[4] + "]: " + e6[0] + "\n");
            } else {
                eprint("error[internal]: " + e6 + "\n");
            }
            return 1;
        }
        let argv3 = args();
        let out_path = "a.out";
        if argv3.len() >= 3 {
            out_path = argv3[2];
        }
        let obj_path = out_path + ".obj";
        let rc = cg_emit_object(cgst, obj_path);
        if rc != 0 {
            eprint("error[build]: object emission failed (step " + string(rc) + ")\n");
            return 1;
        }
        let sl = find_runtime_staticlib();
        if sl == null {
            eprint("error[build]: the runtime staticlib (spid3r_lang.lib) was not found\n");
            return 1;
        }
        let lc = link_executable(obj_path, out_path, sl);
        if lc != 0 {
            return 1;
        }
        print("built " + out_path);
        return 0;
    }

    // `check` and `registry`: the Phase-3 semantic surfaces. The oracle's
    // error shape is `error[semantic]: msg` + the span line; the type-
    // mismatch diagnostics carry an `= help:` line the oracle renders after
    // the caret (decoration — carried here inside the message on a marker).
    let has_main = false;
    for s in prog[0] {
        if s[0] == "Fn" and s[1][4] == "main" {
            has_main = true;
        }
    }
    let cst = new_checker(has_main, path);
    try {
        check_program(cst, prog);
    } catch (e3) {
        let phase = "semantic";
        if e3.len() >= 5 {
            phase = e3[4];
        }
        let pth = path;
        if e3.len() >= 6 {
            pth = e3[5];
        }
        eprint("error[" + phase + "]: " + msg_of(e3) + "\n");
        if e3[1] >= 0 {
            eprint("  --> " + pth + ":" + string(e3[1]) + ":" + string(e3[2]) + "\n");
        }
        let h = help_of(e3);
        if h != null {
            eprint("  = help: " + h + "\n");
        }
        return 1;
    }
    if mode == "check" {
        return 0;
    }
    print(registry_json(cst, prog, path));
    return 0;
}
