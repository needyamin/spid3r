// selfhost/main.matrix — the self-host toolchain entry point (Phases 1-2).
//
// The module search roots put the importer's directory first, and imports may
// not escape it ("../" is rejected), so the entry lives at selfhost/ and
// reaches the subsystem modules through nested specs ("lexer/lexer",
// "parser/parser").
//
// Modes (first argument):
//   tokens <file>  — the Phase-1 lexer parity surface: the token-stream JSON
//                    byte-identical to `spid3r tokens <file> --json`.
//   parse  <file>  — the Phase-2 parser parity surface: the AST JSON
//                    byte-identical to `spid3r parse <file> --dump-ast-json`.
//
// Diagnostics mirror the oracle: `error[lexer]: …` / `error[parser]: …` plus
// the `  --> file:line:col` span line on stderr, exit 1; usage errors exit 2.
// The caret/gutter decoration the oracle prints after the span line is a
// documented non-parity decoration.
//
// The lex-time `{expr}` capture validator (parser::hole_is_expression) is
// injected here, before any lexing, so the lexer's hole decisions match the
// oracle exactly.

import "token";
import "lexer";
import "lexer_json";
import "ast";
import "parser";
import "semantic";

fn main() {
    set_hole_check(hole_check);
    let a = args();
    if a.len() != 2 {
        eprint("usage: main tokens|parse|check|registry <file.matrix>\n");
        return 2;
    }
    let mode = a[0];
    let path = a[1];
    if mode != "tokens" and mode != "parse" and mode != "check" and mode != "registry" {
        eprint("error[usage]: unknown mode '" + mode + "' (tokens|parse|check|registry)\n");
        return 2;
    }
    if not file_exists(path) {
        eprint("error[usage]: usage error: '" + path + "' is not a file\n");
        return 2;
    }
    let r = read_file(path);
    if r.is_err() {
        eprint("error[usage]: usage error: cannot read '" + path + "'\n");
        return 2;
    }
    let src = r.unwrap();

    let toks = null;
    try {
        toks = lex_all(src);
    } catch (e) {
        let pth = path;
        if e.len() >= 6 {
            pth = e[5];
        }
        eprint("error[lexer]: " + e[0] + "\n");
        eprint("  --> " + pth + ":" + string(e[1]) + ":" + string(e[2]) + "\n");
        return 1;
    }

    if mode == "tokens" {
        print(tokens_json(path, toks));
        return 0;
    }

    let prog = null;
    try {
        let st = new_state(toks);
        prog = parse_program(st);
    } catch (e2) {
        let phase = "parser";
        if e2.len() >= 5 {
            phase = e2[4];
        }
        let pth = path;
        if e2.len() >= 6 {
            pth = e2[5];
        }
        eprint("error[" + phase + "]: " + e2[0] + "\n");
        eprint("  --> " + pth + ":" + string(e2[1]) + ":" + string(e2[2]) + "\n");
        return 1;
    }

    if mode == "parse" {
        print(program_to_json(path, prog));
        return 0;
    }

    // `check` and `registry`: the Phase-3 semantic surfaces. The oracle's
    // error shape is `error[semantic]: msg` + the span line; the type-
    // mismatch diagnostics carry an `= help:` line the oracle renders after
    // the caret (decoration — carried here inside the message on a marker).
    let has_main = false;
    for s in prog[0] {
        if s[0] == "Fn" and s[1][4] == "main" {
            has_main = true;
        }
    }
    let cst = new_checker(has_main, path);
    try {
        check_program(cst, prog);
    } catch (e3) {
        let phase = "semantic";
        if e3.len() >= 5 {
            phase = e3[4];
        }
        let pth = path;
        if e3.len() >= 6 {
            pth = e3[5];
        }
        eprint("error[" + phase + "]: " + msg_of(e3) + "\n");
        if e3[1] >= 0 {
            eprint("  --> " + pth + ":" + string(e3[1]) + ":" + string(e3[2]) + "\n");
        }
        let h = help_of(e3);
        if h != null {
            eprint("  = help: " + h + "\n");
        }
        return 1;
    }
    if mode == "check" {
        return 0;
    }
    print(registry_json(cst, prog, path));
    return 0;
}
