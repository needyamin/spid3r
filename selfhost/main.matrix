// selfhost/main.matrix — the self-host toolchain entry point (Phases 1-2).
//
// The module search roots put the importer's directory first, and imports may
// not escape it ("../" is rejected), so the entry lives at selfhost/ and
// reaches the subsystem modules through nested specs ("lexer/lexer",
// "parser/parser").
//
// Modes (first argument):
//   tokens <file>  — the Phase-1 lexer parity surface: the token-stream JSON
//                    byte-identical to `spid3r tokens <file> --json`.
//   parse  <file>  — the Phase-2 parser parity surface: the AST JSON
//                    byte-identical to `spid3r parse <file> --dump-ast-json`.
//
// Diagnostics mirror the oracle: `error[lexer]: …` / `error[parser]: …` plus
// the `  --> file:line:col` span line on stderr, exit 1; usage errors exit 2.
// The caret/gutter decoration the oracle prints after the span line is a
// documented non-parity decoration.
//
// The lex-time `{expr}` capture validator (parser::hole_is_expression) is
// injected here, before any lexing, so the lexer's hole decisions match the
// oracle exactly.

import "token";
import "lexer";
import "lexer_json";
import "ast";
import "parser";
import "semantic";
import "lower";
import "vmc";
import "bytecode_matrix";
import "codegen";
import "link";
import "flatten";
import "test_runner";
import "fmt";
import "pkg";

fn diag_code(phase, lint, msg) {
    if phase == "lexer" {
        if msg.contains("unterminated string") {
            return "E1101";
        }
        if msg.contains("unterminated block comment") {
            return "E1102";
        }
        return "E1100";
    }
    if phase == "parser" {
        if msg.contains("unterminated block") {
            return "E1021";
        }
        if msg.contains("expected an expression") {
            return "E1022";
        }
        if msg.contains("expected an identifier") {
            return "E1023";
        }
        if msg.contains("decorator must precede") {
            return "E1024";
        }
        if msg.contains("import must appear before") {
            return "E1025";
        }
        return "E1027";
    }
    if phase == "semantic" {
        if lint == "unused-variable" {
            return "E1391";
        }
        if lint == "unused-parameter" {
            return "E1392";
        }
        if lint == "unused-import" {
            return "E1393";
        }
        if lint == "unreachable-code" {
            return "E1394";
        }
        if msg.contains("unknown name") {
            return "E1301";
        }
        if msg.contains("type mismatch") {
            return "E1302";
        }
        if msg.contains("not exhaustive") {
            return "E1303";
        }
        if msg.contains("unknown type") {
            return "E1304";
        }
        return "E1300";
    }
    if phase == "runtime" {
        return "E1400";
    }
    if phase == "vm" {
        return "E1500";
    }
    if phase == "usage" {
        return "E1600";
    }
    return "E1700";
}

fn diag_to_json(sev, phase, lint, msg, path, sp, help) {
    let lint_js = "null";
    if lint != null {
        lint_js = jstr(lint);
    }
    let span_js = "\"file\":null,\"line\":null,\"col\":null,\"len\":null,\"end_line\":null,\"end_col\":null";
    if sp != null and sp[0] >= 0 {
        let end_col = sp[1] + sp[2];
        span_js = "\"file\":" + jstr(path) + ",\"line\":" + string(sp[0]) + ",\"col\":" + string(sp[1]) + ",\"len\":" + string(sp[2]) + ",\"end_line\":" + string(sp[0]) + ",\"end_col\":" + string(end_col);
    }
    let help_js = "null";
    if help != null {
        help_js = jstr(help);
    }
    let code_js = jstr(diag_code(phase, lint, msg));
    return "{\"severity\":" + jstr(sev) + ",\"code\":" + code_js + ",\"phase\":" + jstr(phase) + ",\"lint\":" + lint_js + ",\"message\":" + jstr(msg) + "," + span_js + ",\"help\":" + help_js + ",\"notes\":[],\"trace\":[]}";
}

fn main() {
    set_hole_check(hole_check);
    let a = args();
    if a.len() >= 2 and a[0] == "--json" {
        let rest = a.slice(1, a.len());
        rest.push("--json");
        a = rest;
    }
    if a.len() < 1 {
        eprint(
            "usage: main tokens|parse|check|registry|lowered|compile|native|build|test|fmt|pack|unpack|verify|verify-runtime|dist|version <file.matrix> [out|-o out]\n"
        );
        return 2;
    }
    let mode = a[0];
    if mode == "--version" or mode == "-V" or mode == "version" {
        println("spid3r-self 1.5.0");
        return 0;
    }
    if mode == "--help" or mode == "-h" or mode == "help" {
        println("spid3r-self 1.5.0 — Spid3r self-hosted compiler (YamLLVM AOT) & dev tools");
        println("Commands:");
        println("  build <file.matrix> [-o <out>] [--release] [--target <triple>]");
        println("  compile <file.matrix> [out]      (write .matrixc bytecode)");
        println("  native <file.matrix> [out]       (compile & link native binary)");
        println("  check <file.matrix> [--json] [--deny-warnings] [--allow LINT]");
        println("  test [--filter SUBSTR] [--list]");
        println("  fmt [--check] [files...]");
        println("  pack | unpack | verify | verify-runtime | dist");
        println("  tokens | parse | registry | lowered");
        return 0;
    }
    if mode == "test" {
        return run_test_cli(a.slice(1, a.len()));
    }
    if mode == "fmt" {
        return fmt_run_cli(a.slice(1, a.len()));
    }
    if mode == "pack" {
        return pkg_run_pack(a.slice(1, a.len()));
    }
    if mode == "unpack" {
        return pkg_run_unpack(a.slice(1, a.len()));
    }
    if mode == "verify" {
        return pkg_run_verify(a.slice(1, a.len()));
    }
    if mode == "verify-runtime" {
        return link_cli_verify_runtime(a.slice(1, a.len()));
    }
    if a.len() < 2 and mode != "dist" {
        eprint(
            "usage: main tokens|parse|check|registry|lowered|compile|native|build|test|fmt|pack|unpack|verify|verify-runtime|dist <file.matrix> [out|-o out]\n"
        );
        return 2;
    }
    if mode != "tokens" and mode != "parse" and mode != "check" and mode != "registry" and mode != "lowered" and mode != "compile" and mode != "native" and mode != "build" and mode != "dist" {
        eprint(
            "error[usage]: unknown mode '" + mode + "' (tokens|parse|check|registry|lowered|compile|native|build|test|fmt|pack|unpack|verify|verify-runtime|dist)\n"
        );
        return 2;
    }
    let path = null;
    let build_out = null;
    let build_opt = false;
    let build_target = null;
    let chk_dump = false;
    let chk_dump_registry = false;
    let chk_deny_warnings = false;
    let chk_json = false;
    let chk_allow = [];
    if mode == "dist" {
        let dr = pkg_prepare_dist(a.slice(1, a.len()));
        if dr == null {
            return 2;
        }
        path = dr[0];
        build_out = dr[1];
    } else if mode == "build" {
        let ai = 1;
        while ai < a.len() {
            let arg = a[ai];
            if arg == "-o" {
                ai += 1;
                if ai >= a.len() {
                    eprint("error[usage]: -o needs a path\n");
                    return 2;
                }
                build_out = a[ai];
            } else if arg == "--target" {
                ai += 1;
                if ai >= a.len() {
                    eprint("error[usage]: --target needs a target triple\n");
                    return 2;
                }
                build_target = a[ai];
            } else if arg == "--release" {
                build_opt = true;
            } else if arg.len() > 0 and arg[0] == "-" {
                eprint("error[usage]: unknown option '" + arg + "'\n");
                return 2;
            } else {
                if path != null {
                    eprint("error[usage]: build takes exactly one source file\n");
                    return 2;
                }
                path = arg;
            }
            ai += 1;
        }
        if path == null {
            eprint("usage: main build <file.matrix> [-o <out>] [--release] [--target <triple>]\n");
            return 2;
        }
        if build_target == null {
            let tev = env("SPID3R_TARGET");
            if tev.is_some() and tev.unwrap().trim() != "" {
                build_target = tev.unwrap().trim();
            }
        }
    } else if mode == "check" {
        let chk_paths = [];
        let ai = 1;
        while ai < a.len() {
            let arg = a[ai];
            if arg == "--dump-lowered" {
                chk_dump = true;
            } else if arg == "--dump-registry-json" {
                chk_dump_registry = true;
            } else if arg == "--deny-warnings" {
                chk_deny_warnings = true;
            } else if arg == "--json" {
                chk_json = true;
            } else if arg == "--allow" {
                ai += 1;
                if ai >= a.len() {
                    let msg = "--allow needs a lint name (e.g. unused-variable)";
                    if chk_json {
                        print(
                            diag_to_json("error", "usage", null, msg, "", null, null) + "\n"
                        );
                    } else {
                        eprint("error[usage]: " + msg + "\n");
                    }
                    return 2;
                }
                chk_allow.push(a[ai]);
            } else if arg.len() >= 2 and arg.slice(0, 2) == "--" {
                let msg = "check: unknown flag '" + arg + "' (supported: --json, --dump-lowered, --dump-registry-json, --deny-warnings, --allow LINT)";
                if chk_json {
                    print(diag_to_json("error", "usage", null, msg, "", null, null) + "\n");
                } else {
                    eprint("error[usage]: " + msg + "\n");
                }
                return 2;
            } else {
                chk_paths.push(arg);
            }
            ai += 1;
        }
        if chk_paths.len() == 0 {
            let msg = "check needs at least one file or directory";
            if chk_json {
                print(diag_to_json("error", "usage", null, msg, "", null, null) + "\n");
            } else {
                eprint("error[usage]: " + msg + "\n");
            }
            return 2;
        }
        let expanded_chk = [];
        for cp in chk_paths {
            if is_dir(cp) {
                let found = sh_collect_matrix_files(cp);
                if found.len() == 0 {
                    eprint(
                        "error[usage]: usage error: no .matrix files found in directory '" + cp + "'\n"
                    );
                    return 2;
                }
                for fp in found {
                    expanded_chk.push(fp);
                }
            } else {
                expanded_chk.push(cp);
            }
        }
        chk_paths = expanded_chk;
        if chk_paths.len() > 1 and (chk_dump or chk_dump_registry) {
            eprint(
                "error[usage]: usage error: check --dump-lowered and --dump-registry-json accept a single file\n"
            );
            return 2;
        }
        if chk_paths.len() > 1 {
            let any_fail = false;
            for fp in chk_paths {
                let rc = sh_check_one_file(fp, chk_json, chk_deny_warnings, chk_allow);
                if rc != 0 {
                    any_fail = true;
                }
            }
            if any_fail {
                return 1;
            }
            return 0;
        }
        path = chk_paths[0];
    } else {
        if a.len() > 3 {
            eprint(
                "usage: main tokens|parse|check|registry|lowered|compile|native <file.matrix> [out]\n"
            );
            return 2;
        }
        path = a[1];
        if a.len() >= 3 {
            build_out = a[2];
        }
    }
    if not file_exists(path) {
        eprint("error[usage]: usage error: '" + path + "' is not a file\n");
        return 2;
    }
    let r = read_file(path);
    if r.is_err() {
        eprint("error[usage]: usage error: cannot read '" + path + "'\n");
        return 2;
    }
    let src = r.unwrap();

    let toks = null;
    try {
        toks = lex_all(src);
    } catch (e) {
        let pth = path;
        if e.len() >= 6 {
            pth = e[5];
        }
        if chk_json {
            print(
                diag_to_json(
                    "error",
                    "lexer",
                    null,
                    e[0],
                    pth,
                    [e[1],
                    e[2],
                    e[3]],
                    null
                ) + "\n"
            );
        } else {
            eprint("error[lexer]: " + e[0] + "\n");
            eprint("  --> " + pth + ":" + string(e[1]) + ":" + string(e[2]) + "\n");
        }
        return 1;
    }

    if mode == "tokens" {
        print(tokens_json(path, toks));
        return 0;
    }

    let prog = null;
    try {
        let st = new_state(toks);
        prog = parse_program(st);
    } catch (e2) {
        // Compiler errors are [msg, line, col, len(, phase(, path))] lists —
        // an int line at [1] distinguishes them from bare-string runtime
        // errors (a char + int add throws).
        let is_list = false;
        try {
            let probe = e2[1] + 0;
            is_list = true;
        } catch (ignored) {
            is_list = false;
        }
        if not is_list {
            if chk_json {
                print(diag_to_json("error", "internal", null, e2, path, null, null) + "\n");
            } else {
                eprint("error[internal]: " + e2 + "\n");
            }
            return 1;
        }
        let phase = "parser";
        if e2.len() >= 5 {
            phase = e2[4];
        }
        let pth = path;
        if e2.len() >= 6 {
            pth = e2[5];
        }
        if chk_json {
            print(
                diag_to_json(
                    "error",
                    phase,
                    null,
                    e2[0],
                    pth,
                    [e2[1],
                    e2[2],
                    e2[3]],
                    null
                ) + "\n"
            );
        } else {
            eprint("error[" + phase + "]: " + e2[0] + "\n");
            eprint("  --> " + pth + ":" + string(e2[1]) + ":" + string(e2[2]) + "\n");
        }
        return 1;
    }

    if mode == "parse" {
        print(program_to_json(path, prog));
        return 0;
    }

    if mode == "lowered" {
        // The oracle's --dump-lowered-json parses and lowers WITHOUT the
        // semantic check — the port matches that pipeline exactly.
        let lst = new_lower();
        let lowered = lower_program(lst, prog);
        print(program_to_json(path, lowered));
        return 0;
    }

    if mode == "compile" or mode == "dist" {
        // Phase 4.2/4.3: the bytecode compiler + the v3 checksummed container
        // writer. Oracle pipeline: parse -> check -> lower -> compile ->
        // serialize -> write. Byte-equality target: `spid3r compile <file>
        // -o <out> --no-opt` (the optimizer is Phase 11 P-3's scope).
        let has_main_c = false;
        for s in prog[0] {
            if s[0] == "Fn" and s[1][4] == "main" {
                has_main_c = true;
            }
        }
        let cst2 = new_checker(has_main_c, path);
        try {
            check_program(cst2, prog);
        } catch (e4) {
            let phase = "semantic";
            if e4.len() >= 5 {
                phase = e4[4];
            }
            eprint("error[" + phase + "]: " + msg_of(e4) + "\n");
            if e4[1] >= 0 {
                eprint(
                    "  --> " + path + ":" + string(e4[1]) + ":" + string(e4[2]) + "\n"
                );
            }
            return 1;
        }
        let lst2 = new_lower();
        let lowered2 = lower_program(lst2, prog);
        let embedded = [];
        let keys = map();
        let in_progress = [path];
        let fr = null;
        try {
            fr = compile_one(cst2, lowered2, path, embedded, keys, in_progress, true);
        } catch (e5) {
            let phase = "semantic";
            if e5.len() >= 5 {
                phase = e5[4];
            }
            let pth = path;
            if e5.len() >= 6 {
                pth = e5[5];
            }
            eprint("error[" + phase + "]: " + msg_of(e5) + "\n");
            if e5[1] >= 0 {
                eprint("  --> " + pth + ":" + string(e5[1]) + ":" + string(e5[2]) + "\n");
            }
            return 1;
        }
        let func = make_vmfunc(fr);
        let bytes_out = serialize_vmfunc(func);
        let out_path = build_out;
        if out_path == null {
            out_path = sh_strip_source_ext(path) + ".matrixc";
            let argv = args();
            if mode == "compile" and argv.len() >= 3 {
                out_path = argv[2];
            }
        }
        let wb = write_bytes(out_path, bytes_from_ints(bytes_out));
        if wb.is_err() {
            eprint("error[vm]: cannot write '" + out_path + "'\n");
            return 1;
        }
        if mode == "dist" {
            print("wrote " + out_path + "\n");
        } else {
            print("wrote " + out_path);
        }
        return 0;
    }

    if mode == "native" or mode == "build" {
        // Phase 5.2: the LLVM-C codegen. Oracle pipeline: parse -> check ->
        // lower -> build_module -> LLVMTargetMachineEmitToFile -> link (the
        // Phase-6.1 link.matrix argument set).
        let has_main_n = false;
        for s in prog[0] {
            if s[0] == "Fn" and s[1][4] == "main" {
                has_main_n = true;
            }
        }
        let cst3 = new_checker(has_main_n, path);
        try {
            check_program(cst3, prog);
        } catch (e5) {
            let phase = "semantic";
            if e5.len() >= 5 {
                phase = e5[4];
            }
            eprint("error[" + phase + "]: " + msg_of(e5) + "\n");
            if e5[1] >= 0 {
                eprint(
                    "  --> " + path + ":" + string(e5[1]) + ":" + string(e5[2]) + "\n"
                );
            }
            let h5 = help_of(e5);
            if h5 != null {
                eprint("  = help: " + h5 + "\n");
            }
            return 1;
        }
        // Phase 6.2: flatten `import` into one self-contained program before
        // lowering + codegen (the oracle's build flow: parse -> check ->
        // flatten -> lower -> build_module).
        let flat_prog = null;
        try {
            flat_prog = flatten_imports(prog, path);
        } catch (e7) {
            let is_list = false;
            try {
                let probe = e7[1] + 0;
                is_list = true;
            } catch (ignored) {
                is_list = false;
            }
            if is_list {
                let phase = "semantic";
                if e7.len() >= 5 {
                    phase = e7[4];
                }
                let pth = path;
                if e7.len() >= 6 {
                    pth = e7[5];
                }
                eprint(
                    "error[" + phase + "]: " + e7[0] + "
                    "
                );
                eprint(
                    "  --> " + pth + ":" + string(e7[1]) + ":" + string(e7[2]) + "
                    "
                );
            } else {
                eprint(
                    "error[internal]: " + e7 + "
                    "
                );
            }
            return 1;
        }
        let lst3 = new_lower();
        let lowered3 = lower_program(lst3, flat_prog);
        let cgst = new_codegen();
        try {
            cg_build_module(cgst, lowered3, path);
        } catch (e6) {
            // Compiler errors are [msg, line, col, len, phase] lists; runtime
            // errors are bare strings (an int line at [1] distinguishes them —
            // a char + int add throws).
            let is_list = false;
            try {
                let probe = e6[1] + 0;
                is_list = true;
            } catch (ignored) {
                is_list = false;
            }
            if is_list {
                eprint("error[" + e6[4] + "]: " + e6[0] + "\n");
            } else {
                eprint("error[internal]: " + e6 + "\n");
            }
            return 1;
        }
        let pdir = "";
        let pstem = path;
        let ci2 = path.len() - 1;
        while ci2 >= 0 {
            let c2 = path[ci2];
            if c2 == "/" or c2 == "\\" {
                pdir = path.slice(0, ci2 + 1);
                pstem = path.slice(ci2 + 1, path.len());
                break;
            }
            ci2 -= 1;
        }
        pstem = sh_strip_source_ext(pstem);
        let is_win_target = link_is_windows_host();
        if build_target != null and build_target != "" {
            is_win_target = build_target.contains("windows");
        }
        let out_path = build_out;
        if out_path == null {
            if mode == "build" {
                if is_win_target {
                    out_path = pstem + ".exe";
                } else {
                    out_path = pstem;
                }
            } else {
                out_path = "a.out";
            }
        } else if mode == "build" and is_win_target {
            // Match link.rs normalize_exe_path: extensionless -o gets .exe on Windows.
            let base = out_path;
            let bi = out_path.len() - 1;
            while bi >= 0 {
                let bc = out_path[bi];
                if bc == "/" or bc == "\\" {
                    base = out_path.slice(bi + 1, out_path.len());
                    break;
                }
                bi -= 1;
            }
            let has_dot = false;
            let di = 0;
            while di < base.len() {
                if base[di] == "." {
                    has_dot = true;
                    break;
                }
                di += 1;
            }
            if not has_dot {
                out_path = out_path + ".exe";
            }
        }
        let odir = "";
        let ci3 = out_path.len() - 1;
        while ci3 >= 0 {
            let c3 = out_path[ci3];
            if c3 == "/" or c3 == "\\" {
                odir = out_path.slice(0, ci3 + 1);
                break;
            }
            ci3 -= 1;
        }
        let obj_path = odir + "spid3r_" + pstem + ".o";
        let rc = cg_emit_object_opts(cgst, obj_path, build_target, build_opt);
        cg_dispose(cgst);
        if rc != 0 {
            eprint("error[build]: object emission failed (step " + string(rc) + ")\n");
            return 1;
        }
        let rt_res = resolve_and_verify_runtime_staticlib();
        if rt_res[0] != 0 {
            return rt_res[0];
        }
        let sl = rt_res[1];
        let lc = link_executable_for_target(obj_path, out_path, sl, build_target, build_opt);
        if lc != 0 {
            // Propagate the driver's own exit code (2 = usage, the oracle's
            // class for every build-driver failure).
            return lc;
        }
        println("built " + out_path);
        return 0;
    }

    // `check` and `registry`: the Phase-3 semantic surfaces. The oracle's
    // error shape is `error[semantic]: msg` + the span line; the type-
    // mismatch diagnostics carry an `= help:` line the oracle renders after
    // the caret (decoration — carried here inside the message on a marker).
    let has_main = false;
    for s in prog[0] {
        if s[0] == "Fn" and s[1][4] == "main" {
            has_main = true;
        }
    }
    let cst = new_checker(has_main, path);
    try {
        check_program(cst, prog);
    } catch (e3) {
        let phase = "semantic";
        if e3.len() >= 5 {
            phase = e3[4];
        }
        let pth = path;
        if e3.len() >= 6 {
            pth = e3[5];
        }
        let sp = null;
        if e3[1] >= 0 {
            sp = [e3[1], e3[2], e3[3]];
        }
        if chk_json {
            print(
                diag_to_json("error", phase, null, msg_of(e3), pth, sp, help_of(e3)) + "\n"
            );
        } else {
            eprint("error[" + phase + "]: " + msg_of(e3) + "\n");
            if e3[1] >= 0 {
                eprint("  --> " + pth + ":" + string(e3[1]) + ":" + string(e3[2]) + "\n");
            }
            let h = help_of(e3);
            if h != null {
                eprint("  = help: " + h + "\n");
            }
        }
        return 1;
    }
    if mode == "check" {
        if chk_dump_registry {
            print(registry_json(cst, prog, path));
            return 0;
        }
        let reported = 0;
        for w in warnings_of(cst) {
            let skip = false;
            for al in chk_allow {
                if al == w[0] {
                    skip = true;
                    break;
                }
            }
            if skip {
                continue;
            }
            reported += 1;
            if chk_json {
                print(
                    diag_to_json("warning", "semantic", w[0], w[2], path, w[1], null) + "\n"
                );
            } else {
                eprint("warning[semantic]: " + w[2] + "\n");
                eprint(
                    "  --> " + path + ":" + string(w[1][0]) + ":" + string(w[1][1]) + "\n"
                );
            }
        }
        if chk_dump {
            let lst = new_lower();
            let lowered = lower_program(lst, prog);
            print(program_to_json(path, lowered));
        }
        if chk_deny_warnings and reported > 0 {
            let msg = string(reported) + " warning(s) treated as errors because --deny-warnings was given";
            if chk_json {
                print(diag_to_json("error", "semantic", null, msg, path, null, null) + "\n");
            } else {
                eprint("error[semantic]: " + msg + "\n");
            }
            return 1;
        }
        if not chk_json {
            println(path + ": ok");
        }
        return 0;
    }
    print(registry_json(cst, prog, path));
    return 0;
}

fn sh_is_source_name(name) {
    if name.len() > 7 and name.slice(name.len() - 7, name.len()) == ".matrix" {
        return true;
    }
    if name.len() > 3 and name.slice(name.len() - 3, name.len()) == ".mt" {
        return true;
    }
    return false;
}

fn sh_strip_source_ext(name) {
    if name.len() > 7 and name.slice(name.len() - 7, name.len()) == ".matrix" {
        return name.slice(0, name.len() - 7);
    }
    if name.len() > 3 and name.slice(name.len() - 3, name.len()) == ".mt" {
        return name.slice(0, name.len() - 3);
    }
    return name;
}

fn sh_collect_matrix_files(dir) {
    let r = list_dir(dir);
    if not r.is_ok() {
        return [];
    }
    let names = r.unwrap();
    names.sort();
    let out = [];
    for name in names {
        let sep = "/";
        if dir.len() > 0 and (dir[dir.len() - 1] == "/" or dir[dir.len() - 1] == "\\") {
            sep = "";
        }
        let full = dir + sep + name;
        if is_dir(full) {
            for sub in sh_collect_matrix_files(full) {
                out.push(sub);
            }
        } else if is_file(full) and sh_is_source_name(name) {
            out.push(full);
        }
    }
    return out;
}

fn sh_check_one_file(path, chk_json, chk_deny_warnings, chk_allow) {
    if not file_exists(path) {
        eprint("error[usage]: usage error: '" + path + "' is not a file\n");
        return 2;
    }
    let r = read_file(path);
    if r.is_err() {
        eprint("error[usage]: usage error: cannot read '" + path + "'\n");
        return 2;
    }
    let src = r.unwrap();
    let toks = null;
    try {
        toks = lex_all(src);
    } catch (e) {
        eprint("error[lexer]: " + e[0] + "\n");
        return 1;
    }
    let prog = null;
    try {
        let st = new_state(toks);
        prog = parse_program(st);
    } catch (e2) {
        eprint("error[parser]: " + string(e2) + "\n");
        return 1;
    }
    let has_main = false;
    for s in prog[0] {
        if s[0] == "Fn" and s[1][4] == "main" {
            has_main = true;
        }
    }
    let cst = new_checker(has_main, path);
    try {
        check_program(cst, prog);
    } catch (e3) {
        eprint("error[semantic]: " + msg_of(e3) + "\n");
        return 1;
    }
    let reported = 0;
    for w in warnings_of(cst) {
        let skip = false;
        for al in chk_allow {
            if al == w[0] {
                skip = true;
                break;
            }
        }
        if not skip {
            reported += 1;
            eprint("warning[semantic]: " + w[2] + "\n");
        }
    }
    if chk_deny_warnings and reported > 0 {
        return 1;
    }
    if not chk_json {
        println(path + ": ok");
    }
    return 0;
}
