// GENERATED by tools/corpus_manifest.py from tests/engine_matrix.rs#hybrid_loop_bounds — do not hand-edit.
// Frozen corpus (SH-4): changes require a ledger entry in full_plan.html.
fn fill(x) {
    let r = x.len();
    if r == 0 { return matrix(0, 0); }
    let c = x[0].len();
    let m = matrix(r, c);
    for let i = 0; i < r; i = i + 1 {
        for let j = 0; j < c; j = j + 1 {
            m.set(i, j, float(x[i][j]));
        }
    }
    return m;
}
fn main() {
    let x = [[0.5, 1.2], [1.5, 0.3], [2.2, 2.8], [3.1, 1.9], [0.8, 2.1], [2.9, 0.5]];
    let m = fill(x);
    println("rows=" + string(m.rows()) + " cols=" + string(m.cols()));
    println("cell=" + string(m.get(5, 1)));
    let n = x.len();
    let count = 0;
    for let i = 0; i < n; i = i + 1 {
        count += 1;
    }
    println("count=" + string(count));
    return 0;
}
