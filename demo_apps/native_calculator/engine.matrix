// calculator/engine.matrix - the calculator's state machine and number
// formatting. No GUI calls here, so it runs (and is tested) on every engine.
//
// Drive it with press(key). Keys:
//   "0".."9"  "."                       digits and decimal point
//   "+" "-" "*" "/"                     binary operators
//   "="                                 evaluate (repeat "=" to repeat the last step)
//   "%" "neg" "inv" "sqr" "sqrt"        percent, sign, 1/x, x squared, square root
//   "back" "CE" "C"                     backspace, clear entry, clear all

const MAX_DIGITS = 16;
const HISTORY_SIZE = 8;

let entry = "0";  // text of the number on the display
let exact = null;  // full-precision value behind `entry` when it is a result
let acc = null;  // left operand waiting for the pending operator
let op = null;  // pending operator: "+", "-", "*", "/"
let fresh = true;  // the next digit replaces the display
let has_operand = false;  // a right operand was entered after the operator
let expr = "";  // the small expression line above the display
let last_op = null;  // operator and operand that a repeated "=" reuses
let last_operand = null;
let error = false;
let history = list();

// ------------------------------------------------------------ public API

public fn press(key) {
    if key.len() == 1 and "0123456789".contains(key) {
        input_digit(key);
    } elif key == "." {
        input_dot();
    } elif key == "+" or key == "-" or key == "*" or key == "/" {
        input_operator(key);
    } elif key == "=" {
        input_equals();
    } elif key == "%" or key == "neg" or key == "inv" or key == "sqr" or key == "sqrt" {
        input_unary(key);
    } elif key == "back" {
        input_back();
    } elif key == "CE" {
        input_ce();
    } elif key == "C" {
        reset_all();
    }
}

public fn display() -> string {
    if error {
        return "Cannot divide by zero";
    }
    return entry;
}

public fn expression() -> string {
    return expr;
}

public fn active_operator() -> string {
    if op == null or fresh {
        return "";
    }
    return op;
}

public fn has_error() -> bool {
    return error;
}

public fn history_entries() -> list {
    return history;
}

public fn recall(index) {
    if index < 0 or index >= history.len() {
        return null;
    }
    let item = history[index];
    entry = format_num(item["result"]);
    exact = item["result"];
    fresh = true;
    has_operand = op != null;
    return null;
}

public fn clear_history() {
    history = list();
}

public fn reset() {
    reset_all();
    clear_history();
}

// ------------------------------------------------------------ input handlers

fn reset_all() {
    entry = "0";
    exact = null;
    acc = null;
    op = null;
    fresh = true;
    has_operand = false;
    expr = "";
    last_op = null;
    last_operand = null;
    error = false;
}

fn input_digit(d) {
    if error {
        reset_all();
    }
    if fresh {
        entry = d;
        exact = null;
        fresh = false;
        has_operand = op != null;
        return null;
    }
    // Count significant digits (drop any leading "-" and ".").
    let count = digit_count(entry);
    if count >= MAX_DIGITS {
        return null;
    }
    if entry == "0" {
        entry = d;
    } else {
        entry = entry + d;
    }
    exact = null;
    has_operand = op != null;
    return null;
}

fn input_dot() {
    if error {
        reset_all();
    }
    if fresh {
        entry = "0.";
        exact = null;
        fresh = false;
        has_operand = op != null;
        return null;
    }
    if not entry.contains(".") {
        entry = entry + ".";
        exact = null;
    }
    has_operand = op != null;
    return null;
}

fn input_operator(next_op) {
    if error {
        return null;
    }
    let cur = current_value();

    if op != null and has_operand {
        // Chain: compute the pending operation before attaching the new one.
        let res = apply(op, acc, cur);
        if res == null {
            error = true;
            entry = "0";
            return null;
        }
        push_history(format_num(acc) + " " + op_symbol(op) + " " + format_num(cur), res);
        acc = res;
        entry = format_num(res);
        exact = res;
    } else {
        acc = cur;
    }

    op = next_op;
    expr = format_num(acc) + " " + op_symbol(op);
    fresh = true;
    has_operand = false;
    last_op = null;
    last_operand = null;
    return null;
}

fn input_equals() {
    if error {
        return null;
    }

    if op != null {
        // First "=" after an operator was typed: finish the binary op.
        let right = current_value();
        let res = apply(op, acc, right);
        if res == null {
            error = true;
            entry = "0";
            return null;
        }
        push_history(format_num(acc) + " " + op_symbol(op) + " " + format_num(right), res);
        last_op = op;
        last_operand = right;
        entry = format_num(res);
        exact = res;
        expr = "";
        op = null;
        acc = null;
        fresh = true;
        has_operand = false;
        return null;
    }

    if last_op != null {
        // Repeated "=": reuse the previous operator and right operand.
        let left = current_value();
        let res = apply(last_op, left, last_operand);
        if res == null {
            error = true;
            entry = "0";
            return null;
        }
        push_history(format_num(left) + " " + op_symbol(last_op) + " " + format_num(last_operand), res);
        entry = format_num(res);
        exact = res;
        fresh = true;
        return null;
    }
}

fn input_unary(fn_name) {
    if error {
        return null;
    }
    let cur = current_value();
    let res = null;
    let label = "";

    if fn_name == "neg" {
        res = 0 - cur;
        entry = format_num(res);
        exact = res;
        return null;
    } elif fn_name == "sqr" {
        res = cur * cur;
        label = "sqr(" + format_num(cur) + ")";
    } elif fn_name == "sqrt" {
        if cur < 0 {
            error = true;
            entry = "0";
            return null;
        }
        res = sqrt(cur);
        label = "sqrt(" + format_num(cur) + ")";
    } elif fn_name == "inv" {
        if cur == 0 {
            error = true;
            entry = "0";
            return null;
        }
        res = 1.0 / cur;
        label = "1/(" + format_num(cur) + ")";
    } elif fn_name == "%" {
        if acc != null {
            // Desk-calc percent: a + b% -> a + (a * b / 100)
            res = acc * (cur / 100.0);
        } else {
            res = cur / 100.0;
        }
        label = format_num(res);
    }

    if res != null {
        entry = format_num(res);
        exact = res;
        fresh = true;
    }
    return null;
}

fn input_back() {
    if error or fresh {
        return null;
    }
    if entry.len() <= 1 or (entry.len() == 2 and entry.starts_with("-")) {
        entry = "0";
        fresh = true;
        return null;
    }
    entry = entry.slice(0, entry.len() - 1);
    exact = null;
    return null;
}

fn input_ce() {
    entry = "0";
    exact = null;
    fresh = true;
    error = false;
}

// ------------------------------------------------------------ math helpers

fn current_value() {
    if exact != null {
        return exact;
    }
    if entry.contains(".") {
        return float(entry);
    }
    return int(entry);
}

fn apply(operator, a, b) {
    if operator == "+" {
        return a + b;
    } elif operator == "-" {
        return a - b;
    } elif operator == "*" {
        return a * b;
    } elif operator == "/" {
        if b == 0 {
            return null;
        }
        return float(a) / float(b);
    }
    return b;
}

fn op_symbol(operator) -> string {
    if operator == "*" {
        return "×";
    } elif operator == "/" {
        return "÷";
    } elif operator == "-" {
        return "−";
    }
    return operator;
}

fn digit_count(s) -> int {
    let count = 0;
    let i = 0;
    while i < s.len() {
        let ch = s[i];
        if ch >= "0" and ch <= "9" {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn format_num(n) -> string {
    if n == null {
        return "0";
    }
    let s = string(n);
    if s.ends_with(".0") {
        return s.slice(0, s.len() - 2);
    }
    return s;
}

fn push_history(expression_text, result_value) {
    let item = map("expr", expression_text, "result", result_value);
    history.push(item);
    if history.len() > HISTORY_SIZE {
        history.remove(0);
    }
}
