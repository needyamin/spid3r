// calculator/calculator.matrix - a desktop calculator for the Spid3r GUI backend.
//
//   spid3r gui calculator/calculator.matrix             open the window
//   spid3r gui calculator/calculator.matrix --dry-run   replay without a window
//
// The page only draws buttons and forwards input: every click or key press is
// sent as a "key" event, the engine (engine.matrix) does the math, and
// render() pushes the new state back into the page.

import "engine";

fn main() {
    gui_title("Spid3r Calculator");
    gui_on("ready", on_ready);
    gui_on("key", on_key);
    gui_on("recall", on_recall);
    gui_on("clear_history", on_clear_history);
    return 0;
}

// ------------------------------------------------------------ events

fn on_ready(event, payload) {
    gui_eval("document.body.removeAttribute('style');");
    gui_set_html(page());
    gui_eval(bridge_script());
    render();
    return null;
}

fn on_key(event, payload) {
    press(payload);
    render();
    return null;
}

fn on_recall(event, payload) {
    recall(int(payload));
    render();
    return null;
}

fn on_clear_history(event, payload) {
    clear_history();
    render();
    return null;
}

/// Send the whole display state to the page as one JSON object.
fn render() {
    let state = map(
        "display",
        display(),
        "expr",
        expression(),
        "op",
        active_operator(),
        "error",
        has_error(),
        "history",
        history_items()
    );
    gui_eval("window.calc.render(" + json_write(state) + ");");
    return null;
}

// ------------------------------------------------------------ page

fn page() {
    let keys = ""
    + key("%", "%", "fn") + key("CE", "CE", "fn") + key("C", "C", "fn") + key("back", "⌫", "fn")
    + key("inv", "1/x", "fn") + key("sqr", "x²", "fn") + key("sqrt", "√x", "fn") + key("/", "÷", "opk")
    + key("7", "7", "") + key("8", "8", "") + key("9", "9", "") + key("*", "×", "opk")
    + key("4", "4", "") + key("5", "5", "") + key("6", "6", "") + key("-", "−", "opk")
    + key("1", "1", "") + key("2", "2", "") + key("3", "3", "") + key("+", "+", "opk")
    + key("neg", "±", "") + key("0", "0", "") + key(".", ".", "") + key("=", "=", "eq");
    return "<style>" + style_sheet() + "</style>"
    + "<div class='app'>"
    + "<section class='calc'>"
    + "<div class='screen'><div id='expr' class='expr'></div><div id='display' class='display'>0</div></div>"
    + "<div class='keys'>" + keys + "</div>"
    + "<div class='hint'>Keyboard: 0-9 . + - * / % · Enter = · Backspace · Esc clears</div>"
    + "</section>"
    + "<aside class='side'>"
    + "<h2>History <button id='clear-history' title='Clear history'>Clear</button></h2>"
    + "<div id='history'></div>"
    + "</aside>"
    + "</div>";
}

fn key(k, label, cls) {
    return "<button data-k='" + k + "' class='" + cls + "'>" + label + "</button>";
}

/// Click and keyboard wiring plus window.calc.render(state).
fn bridge_script() {
    return "(function(){"
    + "var root=document.getElementById('spid3r-root');"
    + "var byKey={};"
    + "root.querySelectorAll('button[data-k]').forEach(function(b){byKey[b.dataset.k]=b;});"
    + "var keymap={'Enter':'=','=':'=','Backspace':'back','Escape':'C','Delete':'CE',',':'.','.':'.',"
    + "'+':'+','-':'-','*':'*','x':'*','/':'/','%':'%'};"
    + "for(var i=0;i<10;i++){keymap[String(i)]=String(i);}"
    + "function flash(b){b.classList.add('down');setTimeout(function(){b.classList.remove('down');},110);}"
    + "root.addEventListener('click',function(e){"
    + "var b=e.target.closest('[data-k]');"
    + "if(b){window.spid3r.emit('key',b.dataset.k);b.blur();return;}"
    + "var h=e.target.closest('[data-h]');"
    + "if(h){window.spid3r.emit('recall',h.dataset.h);return;}"
    + "if(e.target.closest('#clear-history')){window.spid3r.emit('clear_history','');}"
    + "});"
    + "document.addEventListener('keydown',function(e){"
    + "if(e.ctrlKey||e.metaKey||e.altKey){return;}"
    + "var k=keymap[e.key];"
    + "if(k===undefined){return;}"
    + "e.preventDefault();"
    + "if(byKey[k]){flash(byKey[k]);}"
    + "window.spid3r.emit('key',k);"
    + "});"
    + "window.calc={render:function(s){"
    + "var d=document.getElementById('display');"
    + "var n=s.display.length;"
    + "d.textContent=s.display;"
    + "d.className='display'+(s.error?' err':(n>18?' xs':(n>12?' s':'')));"
    + "document.getElementById('expr').textContent=s.expr;"
    + "for(var k in byKey){byKey[k].classList.toggle('active',k===s.op);}"
    + "var list=document.getElementById('history');"
    + "list.innerHTML='';"
    + "if(s.history.length===0){var p=document.createElement('p');p.className='empty';"
    + "p.textContent='No calculations yet';list.appendChild(p);}"
    + "s.history.forEach(function(item,i){"
    + "var b=document.createElement('button');b.className='item';b.dataset.h=String(i);b.title='Use this result';"
    + "var x=document.createElement('span');x.className='hx';x.textContent=item.expr;"
    + "var r=document.createElement('span');r.className='hr';r.textContent=item.result;"
    + "b.appendChild(x);b.appendChild(r);list.appendChild(b);"
    + "});"
    + "}};"
    + "})();";
}

fn style_sheet() {
    return "*{box-sizing:border-box}"
    + "body{margin:0;background:#0f1117;color:#e8e9ee;font:15px system-ui,Segoe UI,sans-serif;user-select:none}"
    + "#spid3r-root{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}"
    + ".app{display:flex;gap:18px;align-items:stretch}"
    + ".calc{width:340px;background:#171a23;border:1px solid #262b38;border-radius:18px;padding:18px;"
    + "box-shadow:0 20px 50px rgba(0,0,0,.45)}"
    + ".screen{background:#0c0e14;border-radius:12px;padding:14px 16px;margin-bottom:14px;text-align:right;"
    + "min-height:104px;display:flex;flex-direction:column;justify-content:flex-end}"
    + ".expr{color:#8a90a2;font-size:14px;min-height:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    + ".display{font-size:44px;font-weight:300;line-height:1.2;white-space:nowrap;overflow:hidden}"
    + ".display.s{font-size:32px}.display.xs{font-size:24px}.display.err{font-size:24px;color:#ff8f8f}"
    + ".keys{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}"
    + ".keys button{height:56px;border:0;border-radius:12px;background:#232836;color:#e8e9ee;font-size:19px;"
    + "cursor:pointer;outline:none;transition:background .12s,transform .06s}"
    + ".keys button:hover{background:#2c3244}"
    + ".keys button:active,.keys button.down{transform:scale(.96);background:#343b50}"
    + ".keys .fn{background:#1d212c;color:#b7bccb;font-size:16px}"
    + ".keys .opk{background:#2a2440;color:#cdb6ff;font-size:22px}"
    + ".keys .opk.active{background:#7a3ea8;color:#fff}"
    + ".keys .eq{background:#7a3ea8;color:#fff;font-size:22px}"
    + ".keys .eq:hover{background:#8b4cbc}"
    + ".hint{margin-top:12px;color:#5d6377;font-size:11.5px;text-align:center}"
    + ".side{width:260px;background:#171a23;border:1px solid #262b38;border-radius:18px;padding:16px;"
    + "display:flex;flex-direction:column}"
    + ".side h2{margin:0 0 10px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#8a90a2;"
    + "display:flex;justify-content:space-between;align-items:center}"
    + "#clear-history{border:0;background:none;color:#8a90a2;cursor:pointer;font-size:12px}"
    + "#clear-history:hover{color:#e8e9ee}"
    + "#history{flex:1;overflow:auto;display:flex;flex-direction:column;gap:6px;max-height:460px}"
    + ".item{border:0;background:#1d212c;border-radius:10px;padding:9px 12px;text-align:right;cursor:pointer;"
    + "color:inherit;display:flex;flex-direction:column;font:inherit}"
    + ".item:hover{background:#262b38}"
    + ".hx{color:#8a90a2;font-size:12px}.hr{font-size:18px}"
    + ".empty{color:#5d6377;font-size:13px;text-align:center;margin-top:24px}";
}
