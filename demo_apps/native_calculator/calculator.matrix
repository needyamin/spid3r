// demo_apps/native_calculator/calculator.matrix
// Native CLI and Terminal Calculator for Spid3r.
//
// Usage:
//   spid3r run calculator.matrix                     Interactive terminal mode
//   spid3r run calculator.matrix 12 + 5 * 2          Evaluate expression directly
//   spid3r run calculator.matrix --test              Run self-test suite

import "engine";

fn run_sequence(tokens) {
    let i = 0;
    while i < tokens.len() {
        let tok = tokens[i];
        if tok == "+" or tok == "-" or tok == "*" or tok == "/" or tok == "=" or tok == "back" or tok == "C" or tok == "CE" or tok == "%" or tok == "neg" or tok == "sqrt" or tok == "sqr" or tok == "inv" {
            press(tok);
        } else {
            // Number or sequence of digits
            let j = 0;
            while j < tok.len() {
                press(tok.slice(j, j + 1));
                j = j + 1;
            }
        }
        i = i + 1;
    }
    press("=");
    return display();
}

fn run_tests() {
    println("--- Running Spid3r Native Calculator Tests ---");
    reset();
    
    // Test 1: 2 + 3 = 5
    press("2");
    press("+");
    press("3");
    press("=");
    let r1 = display();
    assert(r1 == "5", "Test 1 failed: expected 5, got " + r1);
    println("  Test 1 (2 + 3 = 5): PASS");

    // Test 2: Chaining 2 + 3 * 4 = 20
    reset();
    press("2");
    press("+");
    press("3");
    press("*");
    press("4");
    press("=");
    let r2 = display();
    assert(r2 == "20", "Test 2 failed: expected 20, got " + r2);
    println("  Test 2 (2 + 3 * 4 = 20 desk calc chain): PASS");

    // Test 3: Unary sqrt(16) = 4
    reset();
    press("1");
    press("6");
    press("sqrt");
    let r3 = display();
    assert(r3 == "4", "Test 3 failed: expected 4, got " + r3);
    println("  Test 3 (sqrt 16 = 4): PASS");

    println("\n[OK] All Native Calculator tests passed successfully!");
    return 0;
}

fn interactive_mode() {
    println("=================================================");
    println("        Spid3r Native Terminal Calculator        ");
    println("=================================================");
    println("Commands: <number>, +, -, *, /, =, sqrt, sqr, neg, C, quit (or q)");
    println("Enter expression tokens (e.g. '25 + 75') and press Enter.\n");

    while true {
        print("calc> ");
        let line = read_line();
        if line == null {
            break;
        }
        let trimmed = line.trim();
        if trimmed == "" {
            continue;
        }
        if trimmed == "q" or trimmed == "quit" or trimmed == "exit" {
            println("Goodbye!");
            break;
        }
        if trimmed == "c" or trimmed == "C" or trimmed == "clear" {
            reset();
            println("Display: " + display());
            continue;
        }
        if trimmed == "hist" or trimmed == "history" {
            let entries = history_entries();
            println("History (" + string(entries.len()) + " entries):");
            let i = 0;
            while i < entries.len() {
                let e = entries[i];
                println("  [" + string(i) + "] " + e["expr"] + " = " + string(e["result"]));
                i = i + 1;
            }
            continue;
        }

        // Split tokens by space
        let tokens = trimmed.split(" ");
        let i = 0;
        while i < tokens.len() {
            let tok = tokens[i].trim();
            if tok != "" {
                if tok == "+" or tok == "-" or tok == "*" or tok == "/" or tok == "=" or tok == "back" or tok == "C" or tok == "CE" or tok == "%" or tok == "neg" or tok == "sqrt" or tok == "sqr" or tok == "inv" {
                    press(tok);
                } else {
                    let j = 0;
                    while j < tok.len() {
                        press(tok.slice(j, j + 1));
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        }

        // If the user entered an expression without trailing '=', evaluate it
        let last_token = tokens[tokens.len() - 1];
        if last_token != "+" and last_token != "-" and last_token != "*" and last_token != "/" and last_token != "=" {
            press("=");
        }

        let expr_text = expression();
        if expr_text != "" {
            println("Expr:    " + expr_text);
        }
        println("Result:  " + display() + "\n");
    }
    return 0;
}

fn main() {
    let argv = args();
    if argv.len() > 0 {
        let first = argv[0];
        if first == "test" or first == "--test" or first == "-t" {
            return run_tests();
        }
        if first == "help" or first == "--help" or first == "-h" {
            println("Spid3r Native Calculator");
            println("Usage: spid3r run calculator.matrix [EXPRESSION | test]");
            return 0;
        }
        // Direct evaluation mode: run the tokens provided on CLI
        let result = run_sequence(argv);
        println(result);
        return 0;
    }

    return interactive_mode();
}
