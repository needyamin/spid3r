// P19: runtime field resolution through an expression receiver — public vs
// private field, to see whether the runtime itself defends private reads.
class C {
    public let open: int;
    private let secret: int;
}
fn main() {
    print(new C().open);
    print(new C().secret);
    let c = new C();
    print(c.open);
    return 0;
}
