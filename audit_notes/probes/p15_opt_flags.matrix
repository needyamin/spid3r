// p15: optimizer-sensitive constructs; stdout must match the tree engine
fn side(n) {
    print("side " + string(n));
    return n;
}

fn main() {
    // static branches
    if true { print("T"); } else { print("F"); }
    if false { print("bad"); } else { print("E"); }
    if 1 < 2 { print("cmp"); }
    if !true { print("bad2"); } else { print("not"); }
    if !!true { print("notnot"); }

    // while true with break
    let i = 0;
    while true {
        i = i + 1;
        if i >= 3 { break; }
    }
    print("i " + string(i));

    // dead 1/0 must not be evaluated (untaken branch)
    let zero = 0;
    if false {
        print(1 / zero);
    } else {
        print("alive");
    }

    // same, inside a try chunk (DCE is disabled there; branch must still skip)
    try {
        if false {
            print(1 / zero);
        } else {
            print("try alive");
        }
    } catch(e) {
        print("try caught " + e);
    }

    // constant folding of strings/ints
    print("a" + "b");
    print(2 + 3 * 4);
    print("n " + string(10 - 4));

    // side effects preserved through folding/DCE
    let x = side(1) + side(2);
    print("x " + string(x));

    // the classic: 1/0 constant must raise at runtime, not fold
    try {
        print(1 / 0);
    } catch(e) {
        print("lit " + e);
    }

    // constant condition with side-effectful else arm
    if 0 == 1 {
        side(9);
    } else {
        print("else only");
    }

    // string append chain (pending_str fast path)
    let s = "x";
    s = s + "a";
    s = s + "b";
    s = s + "c";
    print(s);
    print(len(s));
    s = s + "d";
    print(s);
    return 0;
}
