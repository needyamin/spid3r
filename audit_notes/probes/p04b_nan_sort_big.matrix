// p04b: large sort containing NaN — Rust 1.81+ sorts panic on comparators
// that violate total order; value_cmp(NaN, x) is None -> Equal.
fn main() {
    let l = list();
    let i = 0;
    while i < 2000 {
        l.push(i * 1.0);
        i = i + 1;
    }
    l[1000] = float("nan");
    println("before sort");
    l.sort();
    println("after sort");
    return 0;
}
