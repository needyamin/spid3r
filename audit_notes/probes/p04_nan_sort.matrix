// p04: NaN float inside a list being sorted. value_cmp returns None for NaN
// pairs; sort_by maps it to Equal, which can panic in Rust >= 1.81 sort.
fn main() {
    let l = list(1.0, 2.0, 3.0);
    l.push(float("nan"));
    println("before sort");
    l.sort();
    println("after sort");
    println(l);
    return 0;
}
