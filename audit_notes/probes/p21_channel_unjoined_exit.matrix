// p21: channel send after receiver context gone + unjoined tasks at exit.
// Documented quirk: worker threads are killed mid-flight at process exit
// (AUDIT_REPORT.md:199). Expect exit 0, no panic, possibly no "second sent".
fn main() {
    let ch = channel();
    spawn fn() {
        sleep_ms(300);
        ch.send(1);
        print("sent-after-context-gone");
    };
    print("main skipping receive");
    let ch2 = channel();
    spawn fn() {
        ch2.send(10);
        sleep_ms(200);
        ch2.send(20);
        print("second sent");
    };
    print("got " + string(await ch2));
    print("main returns with sender pending");
    return 0;
}
