// p23: string repeat/pad at the documented caps (repeat <= 64 MiB bytes,
// pad width <= 16 Mi chars; src/value/collections/mod.rs:541-596). All cases
// should produce clean catchable errors, never a host panic.
fn main() {
    try {
        let s = "ab".repeat(33554432);
        print("repeat@cap ok len=" + string(s.len()));
    } catch(e) {
        print("repeat@cap: " + e);
    }
    try {
        let s = "ab".repeat(33554433);
        print("repeat@cap+1 ok len=" + string(s.len()));
    } catch(e) {
        print("repeat@cap+1: " + e);
    }
    try {
        let s = "ab".repeat(9223372036854775807);
        print("repeat@i64max ok");
    } catch(e) {
        print("repeat@i64max: " + e);
    }
    try {
        let s = "ab".repeat(-5);
        print("repeat@neg ok");
    } catch(e) {
        print("repeat@neg: " + e);
    }
    try {
        let s = "x".pad_left(16777216, "-");
        print("pad@cap ok len=" + string(s.len()));
    } catch(e) {
        print("pad@cap: " + e);
    }
    try {
        let s = "x".pad_left(16777217, "-");
        print("pad@cap+1 ok");
    } catch(e) {
        print("pad@cap+1: " + e);
    }
    try {
        let s = "x".pad_right(9223372036854775807, "-");
        print("pad@i64max ok");
    } catch(e) {
        print("pad@i64max: " + e);
    }
    return 0;
}
