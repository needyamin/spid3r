// p10: spawn / await / channels / mutex under both engines
fn work(x) {
    return x * 2;
}

fn boom() {
    throw "task boom";
}

fn main() {
    let t = spawn work(21);
    print(await t);

    // spawn a closure capturing a local
    let base = 10;
    let t2 = spawn fn() { return base + 5; };
    print(await t2);

    // task error surfaces on await
    let t3 = spawn boom();
    try {
        print(await t3);
    } catch(e) {
        print("taskerr: " + e);
    }

    // channels
    let ch = channel();
    spawn fn() { ch.send(1); ch.send(2); };
    print(await ch);
    print(await ch);

    // channel typed value roundtrip
    let ch2 = channel();
    spawn fn() { ch2.send([1, 2, 3]); };
    let got = await ch2;
    print(got.len());

    // mutex
    let mu = mutex(0);
    {
        let g = mu.lock();
        g.set(g.get() + 5);
    }
    {
        let g = mu.lock();
        print("mu " + string(g.get()));
    }

    // spawn non-function / await non-task errors
    try {
        spawn 5;
    } catch(e) {
        print("spawnbad: " + e);
    }
    try {
        await 5;
    } catch(e) {
        print("awaitbad: " + e);
    }
    return 0;
}
