// p17: string concat pending-str fast path vs other operations interleaved
fn f(s) {
    return s + "!";
}

fn main() {
    let s = "a";
    s = s + "b";
    let n = len(s);
    s = s + "c";
    print(n);
    print(s);

    // concat then compare
    let t = "ab";
    t = t + "c";
    print(t == "abc");
    print(t != "abc");

    // concat inside loop
    let u = "";
    for i in [1, 2, 3] {
        u = u + string(i);
    }
    print(u);

    // concat then method call
    let v = "x";
    v = v + "yz";
    print(v.len());
    print(v.upper());

    // concat then index
    let w = "hi";
    w = w + "!";
    print(w[0]);

    // concat then call with the value
    let z = "k";
    z = z + "m";
    print(f(z));

    // two locals appending
    let p = "1";
    let q = "2";
    p = p + "3";
    q = q + "4";
    print(p);
    print(q);
    p = p + "5";
    print(p + q);

    // captured local + concat
    let cap = "s";
    let g = fn() { return cap; };
    cap = cap + "t";
    print(g());
    return 0;
}
