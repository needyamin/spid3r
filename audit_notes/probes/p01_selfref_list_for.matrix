// p01: for-in over a list that contains itself (iter_values holds the
// container lock across deep_clone of items). Expect: either clean behavior
// or a host hang (deadlock). 3s timeout wrapper decides.
fn main() {
    let l = list();
    l.push(l);
    println("before for");
    for x in l {
        println("iterating");
        break;
    }
    println("after for");
    return 0;
}
