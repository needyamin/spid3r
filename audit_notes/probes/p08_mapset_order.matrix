// p08: map/set iteration order, equality, identity, keys
fn main() {
    // insertion order preserved and stable across rebuilds
    let m = map();
    m.set("z", 1);
    m.set("a", 2);
    m.set("m", 3);
    print(m.keys());
    print(m.values());
    print(m.len());

    // overwriting keeps original position
    m.set("z", 9);
    print(m.keys());
    print(m.get("z"));

    // direct iteration
    for k in m.keys() { print("k " + k); }

    // set order and dedup
    let s = set("b", "a", "b", "c", "a");
    print(s.len());
    print(s);
    print(s.contains("a"));

    // equality: identity vs structural
    let l1 = [1, 2];
    let l2 = [1, 2];
    print(l1 == l2);
    print(l1 == l1);
    let m1 = map(1, "x");
    let m2 = map(1, "x");
    print(m1 == m2);
    print(m1 == m1);
    let s1 = set(1, 2);
    let s2 = set(2, 1);
    print(s1 == s2);
    let t1 = (1, 2);
    let t2 = (1, 2);
    print(t1 == t2);

    // collection keys in a map: identity for lists?
    let km = map();
    km.set(l1, "first");
    km.set(l2, "second");
    print(km.len());
    print(km.get(l1));
    try {
        print(km.get([1, 2]));
    } catch(e) {
        print("missing " + e);
    }

    // map with int/bool keys
    let im = map(1, "one", true, "yes");
    print(im.get(1));
    print(im.get(true));
    return 0;
}
