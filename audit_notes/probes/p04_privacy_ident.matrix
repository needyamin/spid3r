// P4: private access through a bare identifier receiver — semantic should
// reject both the field read and the private method call.
class C {
    private let secret: int;
    private fn hide(self) {
        return 1;
    }
    public fn get(self) {
        return self.secret;
    }
}
fn main() {
    let c = new C();
    print(c.get());
    print(c.secret);
    print(c.hide());
    return 0;
}
