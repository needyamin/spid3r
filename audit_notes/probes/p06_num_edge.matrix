// p06: integer/float edge cases
fn main() {
    let z = 0;
    let zi = 0 - 1;

    print(7 / 2);
    print(-7 / 2);
    print(7 % 3);
    print(-7 % 3);
    print(7 % -3);

    // MIN / -1 wraps, must not panic
    let mn = -9223372036854775807 - 1;
    print(mn / -1);
    print(mn % -1);
    print(mn - 1);

    // float division by zero via variables (not constant-foldable)
    try {
        print(1.5 / z);
    } catch(e) {
        print("fdiv " + e);
    }
    try {
        print(1.5 % z);
    } catch(e) {
        print("fmod " + e);
    }

    // float formatting
    print(1.0);
    print(1.5);
    print(0.1 + 0.2);
    print(100000000000000000000.0);
    print(1e-7);

    // NaN comparisons
    let nan = 0.0 / 0.0;
    print("nan");
    print(nan);
    print(nan == nan);
    try {
        print(nan < 1.0);
    } catch(e) {
        print("nanlt " + e);
    }

    // -0.0
    let nz = -0.0;
    print(nz);
    print(nz == 0.0);

    // int/float equality and comparison
    print(1 == 1.0);
    print(1 < 1.5);
    print(2.0 >= 2);

    // conversions
    print(int(2.9));
    print(int(-2.9));
    print(float(3));
    print(int("12"));
    return 0;
}
