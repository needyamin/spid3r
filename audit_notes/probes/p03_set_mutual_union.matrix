// p03: two sets that contain each other; union holds the argument set's lock
// (as_set guard) across values_equal, which recurses back into that lock.
fn main() {
    let a = set();
    let b = set();
    a.add(b);
    b.add(a);
    println("before union");
    a.union(b);
    println("after union");
    return 0;
}
