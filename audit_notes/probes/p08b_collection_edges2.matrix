// p08b: corrected-arity retries (heap/graph/queue).
fn probe(label, f) {
    try {
        let r = f();
        println(label + " => ok: " + string(r));
    } catch(e) {
        println(label + " => err: " + e);
    }
    return 0;
}
fn main() {
    probe("heap.min.pop.empty", fn() { let h = heap("min"); return h.pop(); });
    probe("heap.max.pop.empty", fn() { let h = heap("max"); return h.pop(); });
    probe("heap.mixed", fn() { let h = heap("min"); h.push(1); return h.push("x"); });
    probe("graph.directed.rm.missing", fn() { let g = graph(true); return g.remove_node("nope"); });
    probe("graph.directed.edge.missing", fn() { let g = graph(true); return g.add_edge("a", "b", 1); });
    probe("queue.pop.empty", fn() { return queue().pop(); });
    probe("stack.peek.empty", fn() { return stack().peek(); });
    probe("ll.pop.empty", fn() { return linked_list().pop_back(); });
    probe("bst.pop.empty", fn() { return bst().pop_min(); });
    probe("prio.peek.empty", fn() { return priority_queue().peek(); });
    return 0;
}
