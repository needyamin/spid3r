// benchmarks/json.matrix - json_write + json_parse round trips.
// Prints one checksum line: the number of round-trip keys processed.
fn build(i) {
    return map("id", i, "name", "item-" + string(i), "tags", list("a", "b", "c"));
}

fn main() {
    let n = 2000;
    let count = 0;
    let i = 0;
    while i < n {
        let text = json_write(build(i));
        let back = json_parse(text);
        count = count + back.get("id");
        i = i + 1;
    }
    println(count);
    return 0;
}
