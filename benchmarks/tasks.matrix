// benchmarks/tasks.matrix - spawn + channel message-passing throughput.
// A worker task streams n values over a channel; main awaits each one.
// Prints one checksum line.
async fn recv(c) {
    return await c;
}

fn main() {
    let n = 2000;
    let ch = channel();
    spawn fn() {
        let i = 0;
        while i < n {
            ch.send(i * 2);
            i = i + 1;
        }
    };
    let total = 0;
    let i = 0;
    while i < n {
        total = total + recv(ch);
        i = i + 1;
    }
    println(total);
    return 0;
}
