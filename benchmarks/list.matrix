// benchmarks/list.matrix - list push / pop / contains churn.
// Prints one checksum line.
fn main() {
    let n = 100000;
    let xs = list();
    let i = 0;
    while i < n {
        xs.push(i);
        i = i + 1;
    }
    let total = 0;
    while xs.len() > 0 {
        total = total + xs.pop();
    }
    println(total);
    return 0;
}
