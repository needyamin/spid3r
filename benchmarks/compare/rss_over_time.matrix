// Phase R4.2 — RSS-over-time benchmark workload.
// Executes 100,000 fixed-size allocation requests and samples RSS every 100 requests.

fn handle_request(i) {
    let payload = list("req-", string(i % 97), "-ok");
    let rec = map();
    rec.set("id", i);
    rec.set("tag", payload.join(""));
    rec.set("len", rec["tag"].len());
    return rec["len"];
}

fn sample_rss_bytes() {
    let info = spid3rinfo();
    return int(info["System"]["Process RSS bytes"]);
}

fn main() {
    let total_reqs = 100000;
    let sample_every = 100;
    let t0 = now();
    let initial_rss = sample_rss_bytes();
    let min_rss = initial_rss;
    let max_rss = initial_rss;
    let samples = 0;
    let checksum = 0;

    let i = 0;
    while (i < total_reqs) {
        checksum = checksum + handle_request(i);
        i = i + 1;
        if (i % sample_every == 0) {
            let r = sample_rss_bytes();
            if (r < min_rss) { min_rss = r; }
            if (r > max_rss) { max_rss = r; }
            samples = samples + 1;
        }
    }

    let elapsed_ms = now() - t0;
    let end_info = spid3rinfo();
    let final_rss = int(end_info["System"]["Process RSS bytes"]);
    let slabs = int(end_info["AOT Memory"]["Slabs allocated"]);
    let allocs = int(end_info["AOT Memory"]["Completed call allocs"]);
    println("SAMPLES " + string(samples));
    println("CHECKSUM " + string(checksum));
    println("INITIAL_RSS " + string(initial_rss));
    println("FINAL_RSS " + string(final_rss));
    println("DELTA_RSS " + string(final_rss - initial_rss));
    println("SLABS " + string(slabs));
    println("ALLOCS " + string(allocs));
    println("WALL_MS " + string(elapsed_ms));
    return 0;
}
