// R2.4 http_echo benchmark server (event-loop backed, fixed 64-byte body,
// keep-alive + Connection: close arms).

const BODY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
const RESP_KA = "HTTP/1.1 200 OK\r\nContent-Length: 64\r\nConnection: keep-alive\r\n\r\n" + BODY;
const RESP_CLOSE = "HTTP/1.1 200 OK\r\nContent-Length: 64\r\nConnection: close\r\n\r\n" + BODY;

fn handle_conn(c) {
    let r = tcp_read(c, 4096);
    if r.is_err() {
        event_loop_unwatch(c);
        tcp_close(c);
        return;
    }
    let req = r.unwrap();
    if req == "" {
        event_loop_unwatch(c);
        tcp_close(c);
        return;
    }
    if req.contains("Connection: close") || req.contains("connection: close") {
        let _ = tcp_write(c, RESP_CLOSE);
        event_loop_unwatch(c);
        tcp_close(c);
        return;
    }
    let w = tcp_write(c, RESP_KA);
    if w.is_err() {
        event_loop_unwatch(c);
        tcp_close(c);
    }
}

fn main() {
    let srv = tcp_listen("127.0.0.1:0").unwrap();
    let addr = tcp_local_addr(srv).unwrap();
    on_readable(srv, fn(l) {
        let acc = tcp_accept(l);
        if acc.is_err() { return; }
        let c = acc.unwrap();
        on_readable(c, handle_conn);
    });
    println("READY " + addr);
    event_loop_run();
    return 0;
}
