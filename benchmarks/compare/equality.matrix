fn main() {
    let t0 = now_ms();
    let hits = 0;
    let r = 0;
    while r < 200000 {
        let a = r % 97;
        let b = (r * 3) % 97;
        if a == b {
            hits += 1;
        }
        if string(a) == "42" {
            hits += 1;
        }
        r += 1;
    }
    let us = (now_ms() - t0) * 1000;
    println("RESULT " + string(hits) + " 200000");
    println("TIME_US " + string(us));
    return 0;
}
