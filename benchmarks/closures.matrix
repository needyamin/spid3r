// benchmarks/closures.matrix - closure creation and invocation.
// Prints one checksum line.
fn main() {
    let n = 20000;
    let total = 0;
    let i = 0;
    while i < n {
        let adder = fn(x) {
            return x + i;
        };
        total = total + adder(i);
        i = i + 1;
    }
    println(total);
    return 0;
}
