fn main() {
    let g = graph("undirected");
    g.add_node("boss");
    g.add_node("manager");
    g.add_node("intern");

    g.add_edge("boss", "manager");
    g.add_edge("manager", "intern", 2.5);

    println(g.path_exists("boss", "intern"));
    println(g.find_path("boss", "intern").unwrap());
    println(g.bfs("boss"));
    println(g.dfs("boss"));
    println(g.neighbors("manager"));

    // a missing vertex on an edge insert throws
    try {
        g.add_edge("boss", "ghost");
    } catch (e) {
        println("caught: " + e);
    }
    return 0;
}
// GENERATED by tools/corpus_manifest.py from examples/heap.matrix — do not hand-edit.
// Frozen corpus (SH-4): changes require a ledger entry in docs/selfhost/SELFHOST.md.
// examples/heap.matrix - min-heap, plus a stable priority queue.
fn main() {
    let h = heap("min");
    h.push(5);
    h.push(1);
    h.push(3);
    println(h.peek());
    println(h.pop());
    println(h.pop());
    println(h.pop());

    // priority_queue breaks ties by arrival order; heap does not promise that
    let pq = priority_queue();
    pq.push("first", 1);
    pq.push("second", 1);
    pq.push("urgent", 0);
    println(pq.pop());
    println(pq.pop());
    println(pq.pop());
    return 0;
}
