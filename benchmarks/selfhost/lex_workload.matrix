// SH-4 edge corpus: closures — separate capture cells, arrow forms,
// higher-order callbacks. Runs identically on tree, vm and exec.
fn counter() {
    let n = 0;
    return fn() {
        n = n + 1;
        return n;
    };
}

fn main() {
    let c = counter();
    println(c());
    println(c());
    let d = counter();
    println(d());

    let xs = list(1, 2, 3, 4);
    println(xs.map(x => x * 2));
    println(xs.reduce(0, fn(acc, x) { return acc + x; }));
    println(xs.filter(fn(x) { return x % 2 == 1; }));
    return 0;
}
// SH-4 edge corpus: concurrency with explicitly ordered handoffs (the engine
// contract requires programs not to depend on spawn scheduling; every value
// here crosses a channel, and every await joins deterministically).
async fn join_two(a, b) {
    return await a + await b;
}

fn main() {
    let t1 = spawn fn() {
        return 40;
    };
    let t2 = spawn fn() {
        return 2;
    };
    println(join_two(t1, t2));

    let ch = channel();
    spawn fn() {
        ch.send("first");
        ch.send("second");
    };
    println(await_channel(ch));
    println(await_channel(ch));
    return 0;
}

async fn await_channel(ch) {
    return await ch;
}
