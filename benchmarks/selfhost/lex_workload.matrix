    let t0 = now_ms();
    worker.cancel();
    try {
        worker.join();
        println("joined");
    } catch (e) {
        println("threw: " + string(e));
    }
    if (now_ms() - t0 < 3000) {
        println("fast: true");
    } else {
        println("fast: false");
    }
    return 0;
}
