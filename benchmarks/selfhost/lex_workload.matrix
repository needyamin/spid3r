    public fn __sub__(self, o) {
        return Vec2(self.x - o.x, self.y - o.y);
    }
    public fn __mul__(self, k) {
        return Vec2(self.x * k, self.y * k);
    }
    public fn __div__(self, k) {
        return Vec2(self.x / k, self.y / k);
    }
    public fn __neg__(self) {
        return Vec2(-self.x, -self.y);
    }
}
