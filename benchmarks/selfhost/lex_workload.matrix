// GENERATED by tools/corpus_manifest.py from tests/engine_matrix.rs#cancel_latency_is_bounded — do not hand-edit.
// Frozen corpus (SH-4): changes require a ledger entry in docs/selfhost/SELFHOST.md.
fn main() {
    let worker = spawn fn() {
        while true {
            sleep_ms(5);
        }
        return 0;
    };
    sleep_ms(50);
    let t0 = now_ms();
    worker.cancel();
    try {
        worker.join();
        println("joined");
    } catch (e) {
        println("threw: " + string(e));
    }
    if (now_ms() - t0 < 3000) {
        println("fast: true");
    } else {
        println("fast: false");
    }
