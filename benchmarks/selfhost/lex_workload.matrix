// GENERATED by tools/corpus_manifest.py from examples/bst.matrix — do not hand-edit.
// Frozen corpus (SH-4): changes require a ledger entry in docs/selfhost/SELFHOST.md.
// examples/bst.matrix - binary search tree, ascending inorder.
fn main() {
    let tree = bst();
    tree.insert(50);
    tree.insert(30);
    tree.insert(70);
    tree.insert(20);
    tree.insert(40);

    println(tree.inorder());
    println(tree.contains(40));
    println(tree.contains(99));

    // duplicates throw
    try {
        tree.insert(30);
    } catch (e) {
        println("caught: " + e);
    }

    // deletion: leaf, one child, two children
    tree.remove(20);  // leaf
    tree.remove(30);  // one child
    tree.remove(50);  // two children
    println(tree.inorder());
    println(tree.root().unwrap());
    return 0;
}
// GENERATED by tools/corpus_manifest.py from examples/channel.matrix — do not hand-edit.
// Frozen corpus (SH-4): changes require a ledger entry in docs/selfhost/SELFHOST.md.
// examples/channel.matrix - messages between tasks.
fn main() {
    let ch = channel();

    // sender task: no spin, parks on the condvar when there is nothing to read
    spawn fn() {
        ch.send("done");
    };

    // recv waits and yields; it does not spin the worker
    println(ch.recv());

    // many messages, in order
    let log = channel();
    spawn fn() {
        log.send("a");
        log.send("b");
        log.send("c");
    };
    println(log.recv());
    println(log.recv());
    println(log.recv());
    return 0;
}
