class Vec2 {
    public let x;
    public let y;
    fn new(x, y) {
        self.x = x;
        self.y = y;
    }
    public fn __add__(self, o) {
        return Vec2(self.x + o.x, self.y + o.y);
    }
    public fn __sub__(self, o) {
        return Vec2(self.x - o.x, self.y - o.y);
    }
    public fn __mul__(self, k) {
        return Vec2(self.x * k, self.y * k);
    }
    public fn __div__(self, k) {
        return Vec2(self.x / k, self.y / k);
    }
    public fn __neg__(self) {
        return Vec2(-self.x, -self.y);
    }
}
fn main() {
    let a = Vec2(1, 2);
    let b = Vec2(3, 4);
    let c = a + b;
    println(c.x);
    println(c.y);
    let d = b - a;
    println(d.x);
    println(d.y);
    let e = a * 3;
    println(e.x);
    println(e.y);
    let f = b / 2;
    println(f.x);
    println(f.y);
    let g = -a;
    println(g.x);
    println(g.y);
    return 0;
}
