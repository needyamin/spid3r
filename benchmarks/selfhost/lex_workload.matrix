// SH-4 edge corpus: OOP — interfaces, inheritance, super, visibility.
interface Named {
    fn name(self) -> string;
}

class Animal implements Named {
    public let kind;

    fn new(kind) {
        self.kind = kind;
    }

    public fn name(self) -> string {
        return self.kind;
    }
}

class Dog extends Animal implements Named {
    public let callname;

    fn new(callname) {
        super("dog");
        self.callname = callname;
    }

    public fn name(self) -> string {
        return super.name() + ":" + self.callname;
    }
}

fn main() {
    let d = Dog("Rex");
    println(d.name());
    println(d.kind);
    let a = Animal("cat");
    println(a.name());
    return 0;
}
// SH-4 edge corpus: try/catch/finally ordering, throw, result values.
fn parse_age(s) {
    let n = int(s);
    if n < 0 {
        return err("age cannot be negative");
    }
    return ok(n);
}

fn main() {
    try {
        print(10 / 0);
    } catch (error) {
        eprint("caught: " + error);
    } finally {
        println("finally-after-div-zero");
    }

    try {
        throw "boom";
    } catch (e) {
        println("user error: " + e);
    } finally {
        println("finally-after-throw");
    }

    let r = parse_age("42");
    println(r.is_ok());
    let bad = parse_age("-1");
    println(bad.is_err());
    return 0;
}
// SH-4 edge corpus: unicode — multi-byte text, emoji, combining marks.
// Spans measure characters, not bytes, so error carets land on glyphs.
fn main() {
    let s = "héllo wörld";
    println(s);
    println(s.len());
    println("日本語のテキスト");
    println("🚀🎉");
    println("café".upper());
    println("ß".upper());
    println("naïve-Ω".split("-").join("_"));
