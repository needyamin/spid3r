class Animal {
    public let name;
    private let noise;

    fn new (name, noise) {
        self.name = name;
        self.noise = noise;
    }

    public fn speak(self) -> string {
        return self.name + " says " + self.noise;
    }
}

class Dog extends Animal {
    fn new (name) {
