// Frozen corpus (SH-4): changes require a ledger entry in docs/selfhost/SELFHOST.md.
// examples/higher_order.matrix - higher-order list methods with callbacks,
// plus the newer string helpers. Runs identically on tree, vm, and exec.
fn double(x) {
    return x * 2;
}

fn main() {
    let xs = list(1, 2, 3, 4, 5);

    // map with a named function and with a closure
    println(xs.map(double));
    println(xs.map(fn(x) {
        return x * x;
    }));

    // filter / reduce / predicates
    println(xs.filter(fn(x) {
        return x % 2 == 1;
    }));
    println(xs.reduce(0, fn(acc, x) {
        return acc + x;
    }));
    println(xs.all(fn(x) {
        return x > 0;
    }));
    println(xs.any(fn(x) {
        return x > 4;
    }));

    // non-mutating sorted / reversed
    let ys = list(3, 1, 2);
    println(ys.sorted());
    println(ys.reversed());
    println(ys);

    // string helpers
    println("spid3r".upper());
    println("  pad  ".trim().pad_left(8, "."));
    println("k=v".split("=").join("|"));
    println("abc".reverse());
    println("a={} b={}".format(1, "two"));

    // map helpers
    let m = map("a", 1, "b", 2);
    println(m.items());
    println(m.has("a"));
    m.delete("a");
    println(m.has("a"));
    return 0;
}
// GENERATED by tools/corpus_manifest.py from examples/interface.matrix — do not hand-edit.
// Frozen corpus (SH-4): changes require a ledger entry in docs/selfhost/SELFHOST.md.
// examples/interface.matrix - interfaces and polymorphic dispatch.
interface Named {
    fn name(self) -> string;
}

class User extends Object implements Named {
    public let id;

    fn new (id) {
        self.id = id;
    }

    public fn name(self) -> string {
        return "user-" + string(self.id);
    }
}

class Team implements Named {
    public let label;

    fn new (label) {
        self.label = label;
    }

    public fn name(self) -> string {
        return "team-" + self.label;
    }
}

fn main() {
    // calling through a variable that holds any implementation works by name
    let u = new User(7);
    let t = new Team("core");
    println(u.name());
    println(t.name());
    return 0;
}
// GENERATED by tools/corpus_manifest.py from examples/linked_list.matrix — do not hand-edit.
// Frozen corpus (SH-4): changes require a ledger entry in docs/selfhost/SELFHOST.md.
// examples/linked_list.matrix - real nodes and pointers.
fn main() {
    // linked_list keeps a tail pointer: push_back is O(1)
    let ll = linked_list();
    ll.push_back(2);
    ll.push_front(1);
    ll.push_back(3);
    println(ll);
    println(ll.get(1));
    println(ll.pop_back());
    println(ll.pop_front());
    println(ll.len());

    // singly_linked_list has no tail pointer: push_back is O(n)
    let sl = singly_linked_list();
    sl.push_back(1);
    sl.push_back(2);
    sl.push_front(0);
    println(sl);

    // doubly_linked_list has prev links: both ends are O(1)
    let dl = doubly_linked_list();
    dl.push_back(1);
    dl.push_back(2);
    dl.push_front(0);
    println(dl.pop_back());
    println(dl.pop_front());
    println(dl);
    return 0;
}
